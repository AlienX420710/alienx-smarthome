{
	"name": "alienx-smarthome",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "alienxsmarthome.com",
			"custom_domain": true
		},
		{
			"pattern": "www.alienxsmarthome.com",
			"custom_domain": true
		}
	],
	"vars": {
		"TURNSTILE_HOSTNAMES": "alienxsmarthome.com,www.alienxsmarthome.com"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
