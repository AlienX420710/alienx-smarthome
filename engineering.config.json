{
  "repository": "AlienX420710/alienx-smarthome",
  "releaseRefPrefix": "alienx",
  "routes": [
    "/",
    "/status/",
    "/about/",
    "/contact/",
    "/contact/success/",
    "/privacy/",
    "/terms/"
  ],
  "noindexRoutes": ["/contact/success/"],
  "browser": {
    "errorRoutes": ["/500/"],
    "themeKey": "alienx-theme",
    "themeAttribute": "data-alienx-theme",
    "themeSetter": "__alienxSetTheme",
    "statusRoute": "/status/",
    "missingRoute": "/__alienx_missing_error_test__/",
    "turnstileCallback": "alienxTurnstileLoad",
    "suites": {
      "responsive": [
        "tests/site-canvas.spec.cjs",
        "tests/turnstile-engine.spec.cjs",
        "tests/navigation-engine.spec.cjs",
        "tests/responsive.spec.cjs",
        "tests/interactions.spec.cjs",
        "tests/keyboard.spec.cjs",
        "tests/error-pages.spec.cjs",
        "tests/policy-pages.spec.cjs"
      ],
      "accessibility": [
        "tests/accessibility.spec.cjs",
        "tests/heading-contrast.spec.cjs"
      ],
      "webkit": [
        "tests/site-canvas.spec.cjs",
        "tests/turnstile-engine.spec.cjs",
        "tests/navigation-engine.spec.cjs",
        "tests/interactions.spec.cjs",
        "tests/keyboard.spec.cjs",
        "tests/error-pages.spec.cjs",
        "tests/policy-pages.spec.cjs"
      ]
    },
    "logoSelector": ".site-logo",
    "externalSelector": ".source-link",
    "navigationRowBreakpoint": 1050
  },
  "origin": "https://alienxsmarthome.com",
  "mail": {
    "sender": "AlienX SmartHome <contact@alienxsmarthome.com>",
    "address": "contact@alienxsmarthome.com",
    "recipient": "alienx@alienxsmarthome.com",
    "healthSubject": "AlienX SmartHome — email transport healthy — ",
    "customerConfirmation": false,
    "timeoutMs": 15000,
    "healthText": "Automated production mail-transport heartbeat for {date}.\n\nNo action is required. This message verifies that the production Worker can send through the configured AlienX mail transport to the business mailbox. Contact-form health is monitored separately.",
    "healthKeyPrefix": "alienx-daily-email-health/"
  },
  "form": {
    "route": "/contact",
    "selector": "#inquiry-form",
    "submit": "#submit-button",
    "turnstile": "#alienx-turnstile",
    "script": "/contact-security.js",
    "error": "[data-error=\"name\"]",
    "endpoint": "/api/inquiry",
    "encoding": "json",
    "invalid": {
      "consent": true,
      "name": "Health Monitor",
      "email": "monitor@example.invalid",
      "contactMethod": "email",
      "projectType": "other",
      "message": "Automated security-boundary health probe.",
      "faxNumber": "",
      "website": ""
    }
  },
  "rendering": "static",
  "csp": {
    "imageSources": ["'self'", "data:", "blob:"],
    "headerResources": false,
    "generatedHashes": true,
    "externalStyles": false
  },
  "privateStatus": false,
  "revision": {
    "path": "/api/release",
    "key": "revision"
  },
  "assets": [
    "/turnstile-engine.js",
    "/navigation.js",
    "/site-preferences.js",
    "/favicon.svg",
    "/robots.txt",
    "/sitemap-index.xml"
  ],
  "smoke": {
    "markers": {
      "/": "AlienX SmartHome"
    },
    "statusChecks": ["worker", "inquiry", "turnstile", "resend"],
    "rejectionCode": null
  },
  "images": [
    {
      "input": "public/alienx-social-preview.jpg",
      "output": "public/alienx-social-preview.webp",
      "rotate": true,
      "resize": {
        "width": 1600,
        "withoutEnlargement": true
      },
      "format": "webp",
      "options": {
        "quality": 85
      }
    }
  ],
  "status": {
    "limiterBinding": "INQUIRY_RATE_LIMITER",
    "checks": [
      {
        "key": "worker",
        "requires": [],
        "ready": "operational",
        "detail": "Production Worker is responding",
        "failure": "Production Worker is responding"
      },
      {
        "key": "inquiry",
        "requires": ["verification", "delivery", "limiter"],
        "ready": "configured",
        "detail": "Configuration check only; no inquiry or provider delivery test is performed",
        "failure": "Configuration check only; no inquiry or provider delivery test is performed"
      },
      {
        "key": "turnstile",
        "requires": ["verification"],
        "ready": "configured",
        "detail": "Turnstile protection is configured",
        "failure": "Turnstile protection is not configured"
      },
      {
        "key": "resend",
        "requires": ["delivery"],
        "ready": "configured",
        "detail": "Resend delivery integration is configured",
        "failure": "Resend delivery integration is not configured"
      }
    ]
  }
}
