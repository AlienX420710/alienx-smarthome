{
  "repository": "AlienX420710/alienx-smarthome",
  "releaseRefPrefix": "alienx",
  "routes": ["/", "/status/", "/about/", "/contact/", "/contact/success/"],
  "noindexRoutes": ["/contact/success/"],
  "browser": {
    "themeKey": "alienx-theme",
    "themeAttribute": "data-alienx-theme",
    "themeSetter": "__alienxSetTheme",
    "statusRoute": "/status/",
    "missingRoute": "/__alienx_missing_error_test__/",
    "turnstileCallback": "alienxTurnstileLoad",
    "suites": {
      "responsive": [
        "tests/responsive.spec.cjs",
        "tests/interactions.spec.cjs",
        "tests/keyboard.spec.cjs",
        "tests/error-pages.spec.cjs"
      ],
      "accessibility": [
        "tests/accessibility.spec.cjs",
        "tests/heading-contrast.spec.cjs"
      ],
      "webkit": [
        "tests/interactions.spec.cjs",
        "tests/keyboard.spec.cjs",
        "tests/error-pages.spec.cjs"
      ]
    },
    "logoSelector": ".site-logo",
    "externalSelector": ".source-link",
    "navigationRowBreakpoint": 1050
  },
  "origin": "https://alienxsmarthome.com",
  "mail": {
    "sender": "AlienX SmartHome <contact@alienxsmarthome.com>",
    "address": "contact@alienxsmarthome.com",
    "recipient": "alienx@alienxsmarthome.com",
    "healthSubject": "AlienX SmartHome \u2014 email transport healthy \u2014 "
  },
  "form": {
    "route": "/contact",
    "selector": "#inquiry-form",
    "submit": "#submit-button",
    "turnstile": "#alienx-turnstile",
    "script": "/contact-security.js",
    "error": "[data-error=\"name\"]",
    "endpoint": "/api/inquiry",
    "encoding": "json",
    "invalid": {
      "consent": true,
      "name": "Health Monitor",
      "email": "monitor@example.invalid",
      "contactMethod": "email",
      "projectType": "other",
      "message": "Automated security-boundary health probe.",
      "faxNumber": "",
      "website": ""
    }
  },
  "rendering": "static",
  "csp": {
    "imageSources": ["'self'", "data:", "blob:"],
    "headerResources": false,
    "generatedHashes": true,
    "externalStyles": false
  },
  "privateStatus": false,
  "revision": {
    "path": "/api/release",
    "key": "revision"
  },
  "assets": [
    "/site-preferences.js",
    "/favicon.svg",
    "/robots.txt",
    "/sitemap-index.xml"
  ],
  "smoke": {
    "markers": {
      "/": "AlienX SmartHome"
    },
    "statusChecks": ["worker", "inquiry", "turnstile", "resend"],
    "rejectionCode": null
  },
  "images": [
    {
      "input": "public/alienx-social-preview.jpg",
      "output": "public/alienx-social-preview.webp",
      "rotate": true,
      "resize": {
        "width": 1600,
        "withoutEnlargement": true
      },
      "format": "webp",
      "options": {
        "quality": 85
      }
    }
  ]
}
