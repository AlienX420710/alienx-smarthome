---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
---
<!doctype html><html lang="en"><head><BaseHead title="Experiments — AlienX SmartHome" description="Interactive browser experiments from AlienX." /></head><body><Header /><main><p class="eyebrow">ALIENX // EXPERIMENTS</p><h1>Break the browser. Then understand it.</h1><p class="lede">Small technical experiments exploring DOM geometry, rendering, interaction, motion, networking, and the limits of the browser.</p><section class="lab"><article class="console"><div class="bar"><span>ALIENX CONSOLE</span><span>LIVE</span></div><pre id="output">$ boot alienx-console
> runtime: browser
> modules: dom / css / events
> ready_</pre><form id="console-form"><span>$</span><input id="console-input" aria-label="Console command" autocomplete="off" spellcheck="false" placeholder="type help" /></form></article><article class="play"><div class="play__header"><span>DOM FIELD</span><span id="coords">X 000 · Y 000</span></div><div id="field"><div id="target">X</div></div><p>Move your pointer through the field. The core responds to the browser's live pointer coordinates.</p></article></section><section class="cards"><article><span>01</span><h2>DOM / Geometry</h2><p>Measure elements, map coordinates, and turn layout data into interaction.</p></article><article><span>02</span><h2>CSS / Motion</h2><p>Use transforms, gradients, filters, and reduced-motion rules without a framework.</p></article><article><span>03</span><h2>Network / Edge</h2><p>Cloudflare Workers turn a static-looking interface into an actual application surface.</p></article></section></main><CommandPalette /><Footer /></body></html>
<script>
const field=document.querySelector('#field'),target=document.querySelector('#target'),coords=document.querySelector('#coords'),form=document.querySelector('#console-form'),input=document.querySelector('#console-input'),output=document.querySelector('#output');
field?.addEventListener('pointermove',e=>{const r=field.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;target.style.transform=`translate(${x-25}px,${y-25}px)`;coords.textContent=`X ${String(Math.round(x)).padStart(3,'0')} · Y ${String(Math.round(y)).padStart(3,'0')}`});
form?.addEventListener('submit',e=>{e.preventDefault();const cmd=input.value.trim().toLowerCase();const lines={help:'commands: help · status · clear · about',status:'system: operational\nedge: cloudflare workers',about:'AlienX experiments are intentionally small, inspectable browser primitives.'};if(cmd==='clear'){output.textContent='';input.value='';return}output.textContent+=`\n$ ${cmd}\n${lines[cmd]??'unknown command — try help'}\n`;input.value='';output.scrollTop=output.scrollHeight});
</script>
<style>
main{width:min(1100px,calc(100% - 40px));margin:auto;padding:5rem 0 7rem}.eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.22em;color:#8e9ab0}h1{max-width:900px;font-size:clamp(3rem,7vw,6rem);letter-spacing:-.055em;line-height:.92;margin:1rem 0 1.5rem}.lede{max-width:720px;color:#9ca7bc;font-size:1.1rem;line-height:1.6}.lab{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:4rem}.console,.play,.cards article{border:1px solid #192033;border-radius:20px;background:#0a0f19}.console{overflow:hidden}.bar,.play__header{display:flex;justify-content:space-between;padding:.9rem 1rem;border-bottom:1px solid #192033;font-size:.65rem;letter-spacing:.15em;color:#8e9ab0}.console pre{height:260px;overflow:auto;margin:0;padding:1rem;font:13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;color:#b7c2d7;white-space:pre-wrap}.console form{display:flex;gap:.5rem;padding:.9rem 1rem;border-top:1px solid #192033;font:13px ui-monospace,SFMono-Regular,Menlo,monospace}.console input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:#f4f7ff;font:inherit}.play{overflow:hidden}.play__header{border-bottom:1px solid #192033}.play #field{position:relative;height:300px;overflow:hidden;background:radial-gradient(circle at 50% 50%,rgba(57,255,90,.12),transparent 25%),linear-gradient(135deg,#080c14,#0d1420)}#target{position:absolute;left:0;top:0;width:50px;height:50px;display:grid;place-items:center;border:1px solid rgba(57,255,90,.7);border-radius:50%;color:#dfffe5;background:rgba(57,255,90,.1);box-shadow:0 0 35px rgba(57,255,90,.2);pointer-events:none}.play p{padding:0 1rem 1rem;color:#7f8aa0;font-size:.85rem}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}.cards article{padding:1.5rem}.cards span{color:#8e9ab0;font-size:.7rem}.cards h2{font-size:1.3rem;margin-top:2rem}.cards p{color:#7f8aa0;line-height:1.6}@media(max-width:750px){main{width:min(100% - 28px,680px)}.lab,.cards{grid-template-columns:1fr}}
</style>
