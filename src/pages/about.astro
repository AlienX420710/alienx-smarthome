---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={`About Me — ${SITE_TITLE}`} description="The technical journey behind AlienX, from Home Assistant and self-hosting to networking and web development." /></head>
	<body>
		<Header /><main>
			<section class="intro" aria-labelledby="title"><p class="eyebrow">ALIENX / ABOUT ME</p><h1 id="title">From smart home to smart technology.</h1><p class="lede">AlienX started with a smart home, but the technical curiosity behind it kept expanding. This is the story of that journey: Home Assistant, Unraid, networking, and eventually websites, software, and automation.</p></section>
			<section class="journey" aria-labelledby="journey-title"><p class="eyebrow">THE JOURNEY</p><h2 id="journey-title">One chapter led to the next.</h2><div class="timeline">
				<article><span class="number">01</span><div><h3>Home Assistant</h3><p>Where the experimentation started. Smart-home projects opened the door to a much deeper interest in technology.</p></div></article>
				<article><span class="number">02</span><div><h3>Unraid</h3><p>The journey moved into servers and self-hosted infrastructure, creating a new layer of things to learn and build.</p></div></article>
				<article><span class="number">03</span><div><h3>Networking</h3><p>Understanding how everything connects became its own part of the journey: networks, infrastructure, and the systems underneath the services.</p></div></article>
				<article><span class="number">04</span><div><h3>Websites</h3><p>The focus expanded into building for the web, with frontend, backend, automation, and interactive experiences becoming the next direction.</p></div></article>
			</div></section>
			<section class="story" aria-labelledby="story-title"><p class="eyebrow">THE STORY</p><h2 id="story-title">Built one layer at a time.</h2><p>Each chapter will become a long-form story using the original AlienX blog-post format. The goal is to document the real projects, lessons, mistakes, and decisions that shaped the work instead of turning the page into a generic résumé.</p><p>The first version establishes the structure. The details will be filled in from the actual story as each chapter is written.</p></section>
		</main><Footer />
	</body>
</html>

<style>
	:global(body){--about-background:#05070c;--about-surface:rgba(18,23,36,.9);--about-surface-alt:rgba(8,11,18,.9);--about-text:#eef2ff;--about-heading:#f6f8ff;--about-muted:#a5afc3;--about-soft:#96a1b7;--about-eyebrow:#8f9ab2;--about-number:#7f8ba2;--about-border:#151b29;--about-card-border:#192033;--about-accent:var(--brand-green);background:var(--about-background);color:var(--about-text)}
	main{width:min(1120px,calc(100% - 40px));max-width:none;padding:5rem 0 8rem}.eyebrow{margin:0 0 1rem;color:var(--about-eyebrow);font-size:.7rem;font-weight:700;letter-spacing:.22em}h1,h2,h3{color:var(--about-heading);letter-spacing:-.045em;line-height:1}h1{max-width:900px;font-size:clamp(3.2rem,7vw,6.8rem)}h1{color:var(--about-heading)}h1::first-line{}.lede{max-width:760px;margin-top:2rem;color:var(--about-muted);font-size:1.2rem;line-height:1.7}.journey{margin-top:8rem;padding-top:5rem;border-top:1px solid var(--about-border)}h2{max-width:850px;font-size:clamp(2.5rem,5vw,4.5rem)}.timeline{display:grid;gap:1rem;margin-top:3rem}article{display:grid;grid-template-columns:72px 1fr;gap:1.5rem;align-items:start;padding:2rem;border:1px solid var(--about-card-border);border-radius:24px;background:linear-gradient(145deg,var(--about-surface),var(--about-surface-alt));transition:border-color 180ms ease,transform 180ms ease}article:hover{border-color:color-mix(in srgb,var(--about-accent) 36%,transparent);transform:translateY(-2px)}.number{color:var(--about-number);font-size:.75rem;font-weight:700;letter-spacing:.16em;padding-top:.25rem}article h3{margin:0;font-size:1.6rem}article p{margin:.8rem 0 0;color:var(--about-soft);line-height:1.65}.story{max-width:760px;margin-top:8rem;padding-top:5rem;border-top:1px solid var(--about-border)}.story p:not(.eyebrow){color:var(--about-muted);font-size:1.05rem;line-height:1.8}@media(prefers-color-scheme:light){:global(body){--about-background:#fff;--about-surface:#f5f7fb;--about-surface-alt:#fff;--about-text:#1d2433;--about-heading:#0f1219;--about-muted:#60739f;--about-soft:#687797;--about-eyebrow:#64708f;--about-number:#687797;--about-border:#e1e6ef;--about-card-border:#dce2ec;--about-accent:var(--brand-green-dark)}article{box-shadow:0 10px 30px rgba(42,55,80,.05)}article:hover{border-color:color-mix(in srgb,var(--about-accent) 42%,transparent)}}@media(max-width:800px){main{width:min(100% - 28px,680px);padding-top:3rem}.journey,.story{margin-top:5rem}.timeline article{grid-template-columns:1fr;gap:.5rem}}@media(prefers-reduced-motion:reduce){article{transition:none}article:hover{transform:none}}
</style>
