---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="Learn what AlienX SmartHome is: an interactive web showcase exploring modern HTML, CSS, JavaScript, accessibility, performance, and browser engineering."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title">
				<p class="eyebrow">ALIENX / ABOUT</p>
				<h1 id="title">A smart-home idea built to explore the web.</h1>
				<p class="lede">
					AlienX SmartHome is a fictional product used as a creative and technical playground.
					The website is the demonstration: a place to experiment with interface design,
					browser-native interaction, responsive systems, accessibility, and performance.
				</p>
			</section>

			<section class="principles" aria-labelledby="principles-title">
				<p class="eyebrow">WHAT IT IS</p>
				<h2 id="principles-title">The product is the excuse. The web is the medium.</h2>
				<div class="grid">
					<article>
						<h3>Interactive by default</h3>
						<p>Scenes, motion, state, and visual feedback make the interface something to explore rather than a static mockup.</p>
					</article>
					<article>
						<h3>Built for the browser</h3>
						<p>AlienX uses HTML, CSS, JavaScript, SVG, and Astro to demonstrate what the modern web platform can do.</p>
					</article>
					<article>
						<h3>Not a control dashboard</h3>
						<p>AlienX deliberately avoids recreating an existing smart-home management interface. It is a web experience, not a clone of another platform.</p>
					</article>
					<article>
						<h3>Accessible and fast</h3>
						<p>Semantic markup, keyboard interaction, responsive layouts, reduced motion, and an Astro-first architecture are part of the design.</p>
					</article>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { background:#05070c; color:#eef2ff; }
	main { width:min(1180px, calc(100% - 40px)); max-width:none; padding:6rem 0 8rem; }
	.eyebrow { margin:0 0 1rem; color:#7784a6; font-size:.7rem; font-weight:700; letter-spacing:.22em; }
	h1,h2,h3 { color:#f6f8ff; letter-spacing:-.045em; line-height:1; }
	h1 { max-width:900px; font-size:clamp(3.2rem,7vw,6.8rem); }
	.lede { max-width:720px; margin-top:2rem; color:#98a4bd; font-size:1.2rem; line-height:1.7; }
	.principles { margin-top:8rem; padding-top:5rem; border-top:1px solid #151b29; }
	h2 { max-width:850px; font-size:clamp(2.5rem,5vw,4.5rem); }
	.grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; margin-top:3rem; }
	article { min-height:220px; padding:2rem; border:1px solid #192033; border-radius:24px; background:linear-gradient(145deg,rgba(18,23,36,.9),rgba(8,11,18,.9)); }
	article h3 { font-size:1.45rem; }
	article p { color:#8490aa; line-height:1.65; }
	@media(max-width:800px){ main{width:min(100% - 28px,680px);padding-top:3rem}.principles{margin-top:5rem}.grid{grid-template-columns:1fr} }
</style>
