---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Work — ${SITE_TITLE}`}
			description="Selected AlienX work across web development, applications, automation, infrastructure, smart technology, and interactive experiences."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title">
				<p class="eyebrow">ALIENX / WORK</p>
				<h1 id="title">Things built to solve problems.</h1>
				<p class="lede">AlienX is a hands-on technology practice. This is where projects, experiments, and working systems come together—from websites and applications to automation, infrastructure, and smart technology.</p>
			</section>
			<section class="work-section" aria-labelledby="build-title"><div class="section-heading"><p class="eyebrow">WHAT ALIENX BUILDS</p><h2 id="build-title">From the interface to the infrastructure underneath it.</h2><p class="section-copy">The work spans the layers that make a useful digital system possible. These are the areas where real projects will be presented as they are completed.</p></div><div class="grid"><article><span>01 / WEB</span><h3>Web development</h3><p>Fast, responsive websites and interfaces built around the actual goal—not a template.</p></article><article><span>02 / APPLICATIONS</span><h3>Web applications</h3><p>Frontend and backend systems that turn an idea into something people can use.</p></article><article><span>03 / AUTOMATION</span><h3>Automation & integrations</h3><p>APIs, workflows, webhooks, and connected services that remove repetitive work.</p></article><article><span>04 / INFRASTRUCTURE</span><h3>Infrastructure</h3><p>Servers, networking, deployment, and self-hosted systems that keep technology running.</p></article><article><span>05 / SMART TECHNOLOGY</span><h3>Smart technology</h3><p>Home automation and connected technology where software meets the physical world.</p></article><article><span>06 / EXPERIMENTS</span><h3>Interactive experiments</h3><p>Browser-native experiments that explore what modern interfaces and engineering can do.</p></article></div></section>
			<section class="work-section distinction" aria-labelledby="experience-title"><div class="section-heading"><p class="eyebrow">WHAT THIS WEBSITE DEMONSTRATES</p><h2 id="experience-title">The site is part of the portfolio.</h2></div><div class="principles"><div><span>01</span><h3>Frontend engineering</h3><p>Responsive layouts, interaction, animation, accessibility, and browser-native behavior.</p></div><div><span>02</span><h3>Modern web architecture</h3><p>Server-first rendering, focused client-side JavaScript, and a deliberately small runtime footprint.</p></div><div><span>03</span><h3>Engineering discipline</h3><p>Performance, progressive enhancement, semantic HTML, and interfaces that remain usable without unnecessary complexity.</p></div></div></section>
			<section class="note" aria-labelledby="note-title"><p class="eyebrow">THE PORTFOLIO GROWS WITH THE WORK</p><h2 id="note-title">Real builds will replace the placeholders.</h2><p>No invented client list. No fake case studies. As projects are completed, each one can be documented here with the problem, approach, technology, and result.</p><a class="button" href="/contact">Start a project <span aria-hidden="true">→</span></a></section>
		</main><Footer />
	</body>
</html>

<style>
	:global(body){--work-accent:var(--brand-green);background:var(--page-background);color:var(--page-text)}main{width:min(1120px,calc(100% - 40px));max-width:none;padding:5rem 0 8rem}.eyebrow{margin:0 0 1rem;color:var(--page-muted);font-size:.7rem;font-weight:700;letter-spacing:.22em}h1,h2,h3{color:var(--page-heading);letter-spacing:-.045em;line-height:1}h1{max-width:900px;font-size:clamp(3.2rem,7vw,6.8rem)}.lede{max-width:760px;margin-top:2rem;color:var(--page-text);font-size:1.2rem;line-height:1.7}.work-section{margin-top:8rem;padding-top:5rem;border-top:1px solid var(--page-border)}h2{max-width:850px;font-size:clamp(2.5rem,5vw,4.5rem)}.section-copy{max-width:700px;margin-top:1.5rem;color:var(--page-muted);line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}article{min-height:240px;padding:2rem;border:1px solid var(--page-border);border-radius:24px;background:linear-gradient(145deg,rgba(var(--gray-light),.55),rgba(var(--gray-light),.18));transition:transform 180ms ease,border-color 180ms ease,background 180ms ease}article:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--work-accent) 48%,transparent);background:linear-gradient(145deg,rgba(23,36,28,.72),rgba(var(--gray-light),.18))}article span,.principles span{color:var(--page-muted);font-size:.68rem;font-weight:700;letter-spacing:.12em}article h3{margin-top:3.5rem;font-size:1.5rem}article p,.principles p,.note p{color:var(--page-muted);line-height:1.65}.distinction{margin-top:5rem}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}.principles div{padding-top:1.5rem;border-top:1px solid var(--page-border)}.principles h3{margin:.9rem 0 .75rem;font-size:1.25rem}.note{margin-top:6rem;padding:clamp(2rem,6vw,5rem);border:1px solid var(--page-border);border-radius:32px;background:radial-gradient(circle at 50% 0%,rgba(35,55,255,.10),transparent 60%),rgba(var(--gray-light),.22)}.note p{max-width:680px;margin:1.25rem 0 2rem}.button{display:inline-flex;align-items:center;gap:.55rem;min-height:48px;padding:0 1.25rem;border-radius:999px;color:var(--page-background);background:var(--page-heading);font-size:.9rem;font-weight:700;text-decoration:none;transition:transform 180ms ease,background 180ms ease}.button:hover{color:var(--page-background);transform:translateY(-2px);background:var(--work-accent)}@media(prefers-color-scheme:dark){article{background:linear-gradient(145deg,rgba(18,23,36,.9),rgba(8,11,18,.9))}.note{background:radial-gradient(circle at 50% 0%,rgba(105,119,255,.14),transparent 60%),#090d16}}@media(prefers-color-scheme:light){:global(body){--work-accent:var(--brand-green-dark)}article{background:linear-gradient(145deg,#f8fafc,#f1f4f8);box-shadow:0 12px 35px rgba(42,55,80,.06)}article:hover{border-color:color-mix(in srgb,var(--work-accent) 48%,transparent);background:linear-gradient(145deg,#f3faf5,#eef5f0)}.note{background:radial-gradient(circle at 50% 0%,rgba(22,163,74,.09),transparent 60%),#f7f9fb}}@media(max-width:800px){main{width:min(100% - 28px,680px);padding-top:3rem}.work-section{margin-top:5rem}.grid,.principles{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){article,.button{transition:none}article:hover,.button:hover{transform:none}}
</style>
