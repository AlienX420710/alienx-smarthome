---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';

const description =
  'AlienX designs and engineers websites that communicate clearly, work across devices, and connect the interface to the systems behind it.';

const projects = [
  {
    eyebrow: 'WEB PLATFORM',
    title: 'AlienX SmartHome',
    summary:
      'The production Astro and Cloudflare platform behind this site: responsive UI, theme support, accessibility gates, security headers, and exact-revision deployment.',
    href: '/',
    tags: ['Astro', 'Cloudflare', 'TypeScript', 'Accessibility'],
    outcome:
      'A production website whose engineering is visible in the product itself.',
  },
  {
    eyebrow: 'INTERACTION SYSTEM',
    title: 'Browser-native experience',
    summary:
      'The strongest Lab and Experience concepts now live directly in the homepage: semantic controls, modern CSS, responsive composition, progressive enhancement, and purposeful interaction.',
    href: '#proof-title',
    tags: ['HTML', 'CSS', 'Browser APIs', 'Progressive enhancement'],
    outcome:
      'Technical proof is part of the customer journey instead of a separate destination.',
  },
  {
    eyebrow: 'RELEASE ENGINEERING',
    title: 'Exact-revision release gate',
    summary:
      'A fail-closed release architecture that approves the exact main revision only after Quality, Responsive, Accessibility, Lighthouse, and Safari gates succeed.',
    href: '/status',
    tags: ['GitHub Actions', 'Cloudflare Workers', 'CI/CD', 'Smoke tests'],
    outcome:
      'The deployed revision has to match the revision that passed the release gates.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={description} />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">WEBSITES // BUILT AS SYSTEMS</p>
          <h1 id="hero-title">
            A website should make <span>choosing you</span> easier.
          </h1>
          <p class="hero__lede">
            AlienX designs and engineers websites that explain your value
            quickly, feel intentional on every screen, and give customers a
            clear next step.
          </p>
          <div class="hero__actions">
            <a tabindex="0" class="button button--primary" href="/contact">
              Start a project
            </a>
            <a tabindex="0" class="button button--ghost" href="#why-alienx">
              Why AlienX
            </a>
          </div>
          <ul class="hero__signals" aria-label="AlienX website priorities">
            <li>Clear message</li>
            <li>Responsive by default</li>
            <li>Accessible interaction</li>
            <li>Production-ready delivery</li>
          </ul>
        </div>

        <div class="hero__visual" aria-label="AlienX website delivery system">
          <div class="orb orb--one"></div>
          <div class="orb orb--two"></div>
          <div class="system-panel">
            <div class="panel-topline">
              <span>ALIENX // WEBSITE SYSTEM</span>
              <span class="status">
                <i></i> READY
              </span>
            </div>

            <div class="system-core" aria-hidden="true">
              <div class="core-ring core-ring--outer"></div>
              <div class="core-ring core-ring--inner"></div>
              <div class="core-center">X</div>
            </div>

            <dl class="system-readout">
              <div>
                <dt>MESSAGE</dt>
                <dd>Clear</dd>
              </div>
              <div>
                <dt>INTERFACE</dt>
                <dd>Responsive</dd>
              </div>
              <div>
                <dt>QUALITY</dt>
                <dd>Verified</dd>
              </div>
              <div>
                <dt>DELIVERY</dt>
                <dd>Production</dd>
              </div>
            </dl>

            <p class="system-label">
              STRATEGY · DESIGN · ENGINEERING · DELIVERY
            </p>
          </div>
        </div>
      </section>

      <section id="why-alienx" class="why" aria-labelledby="why-alienx-title">
        <div class="section-heading">
          <p class="eyebrow">WHY ALIENX</p>
          <h2 id="why-alienx-title">Design and engineering stay connected.</h2>
          <p>
            A useful website is more than a polished first screen. The message,
            interaction, performance, accessibility, forms, deployment, and
            failure states all have to work together.
          </p>
        </div>

        <div class="reason-grid">
          <article class="reason-card reason-card--lead">
            <span class="reason-number">01</span>
            <h3>The message comes first.</h3>
            <p>
              Visitors should understand what you do, why it matters, and what
              to do next without hunting through the site.
            </p>
          </article>
          <article class="reason-card">
            <span class="reason-number">02</span>
            <h3>Custom where it matters.</h3>
            <p>
              Structure, responsive behavior, interaction, and content hierarchy
              are built around the job the site needs to do—not around a generic
              demo.
            </p>
          </article>
          <article class="reason-card">
            <span class="reason-number">03</span>
            <h3>Quality is part of the build.</h3>
            <p>
              Semantic HTML, keyboard behavior, reduced motion, responsive
              layouts, performance checks, and accessibility are engineering
              constraints from the start.
            </p>
          </article>
          <article class="reason-card">
            <span class="reason-number">04</span>
            <h3>The system behind the page matters.</h3>
            <p>
              Forms, APIs, automation, deployment, security boundaries, and
              observability are treated as part of the product instead of
              invisible afterthoughts.
            </p>
          </article>
        </div>
      </section>

      <section class="proof" aria-labelledby="proof-title">
        <div class="proof__heading">
          <p class="eyebrow">THE SITE IS PART OF THE PROOF</p>
          <h2 id="proof-title">You can inspect how AlienX builds.</h2>
          <p>
            The strongest ideas from the former Lab and Experience sections now
            live here as engineering principles instead of separate
            destinations.
          </p>
        </div>

        <div class="proof-grid">
          <article>
            <span>01 // BROWSER NATIVE</span>
            <h3>Use the platform before adding complexity.</h3>
            <p>
              Native controls, semantic structure, modern CSS, container-aware
              layouts, and progressive enhancement provide durable interaction
              without unnecessary runtime weight.
            </p>
          </article>
          <article>
            <span>02 // REAL USERS</span>
            <h3>Every interaction has to survive real input.</h3>
            <p>
              Pointer, touch, keyboard, focus, reduced motion, responsive
              layouts, and theme behavior are treated as product behavior—not
              optional polish.
            </p>
          </article>
          <article>
            <span>03 // PRODUCTION</span>
            <h3>The launch path gets engineered too.</h3>
            <p>
              This site uses source control, automated quality gates, browser
              testing, deployment checks, and runtime status signals so the
              implementation is inspectable beyond the screenshot.
            </p>
          </article>
        </div>

        <div class="proof-links">
          <a
            tabindex="0"
            class="text-link"
            href="https://github.com/AlienX420710/alienx-smarthome"
            target="_blank"
            rel="noopener noreferrer"
          >
            Inspect the source <span aria-hidden="true">↗</span>
          </a>
          <a tabindex="0" class="text-link" href="/status">
            View system status <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="outcomes" aria-labelledby="outcomes-title">
        <div class="section-heading">
          <p class="eyebrow">WHAT GETS BUILT</p>
          <h2 id="outcomes-title">
            Start with the website. Grow into the system.
          </h2>
          <p>
            The public site can be the front door, while the same engineering
            foundation supports forms, integrations, applications, automation,
            and infrastructure when the project needs more.
          </p>
        </div>

        <div class="outcome-grid">
          <article>
            <span>WEBSITE</span>
            <h3>A clear public front door.</h3>
            <p>
              Responsive pages, information architecture, interaction, content
              presentation, SEO fundamentals, accessibility, and a clear path to
              contact.
            </p>
          </article>
          <article>
            <span>INTERACTION</span>
            <h3>More than a static brochure.</h3>
            <p>
              Purposeful browser interaction can explain a product, demonstrate
              capability, guide a visitor, or make a brand memorable without
              turning usability into a gimmick.
            </p>
          </article>
          <article>
            <span>INTEGRATION</span>
            <h3>The page can connect to real work.</h3>
            <p>
              Forms, APIs, webhooks, data flows, email, and business systems can
              turn a website action into a reliable workflow.
            </p>
          </article>
          <article>
            <span>OPERATIONS</span>
            <h3>Delivery does not end at publish.</h3>
            <p>
              Deployment, DNS, CI/CD, observability, performance, and security
              boundaries determine whether the finished site keeps behaving like
              the one that was approved.
            </p>
          </article>
        </div>
      </section>

      <section class="portfolio" aria-labelledby="portfolio-title">
        <div class="section-heading">
          <p class="eyebrow">REAL WORK // NO PLACEHOLDER METRICS</p>
          <h2 id="portfolio-title">The work is already running.</h2>
          <p>
            AlienX uses its own production platform as inspectable proof. The
            interface, browser behavior, delivery pipeline, and operational
            controls are part of the portfolio—not a mockup of what might be
            built later.
          </p>
        </div>
        <div class="portfolio-grid">
          {projects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </section>

      <section class="engineering" aria-labelledby="engineering-title">
        <div class="section-heading">
          <p class="eyebrow">ENGINEERING DEPTH</p>
          <h2 id="engineering-title">
            The website is the front door. The system can go much deeper.
          </h2>
          <p>
            The useful parts of the former Technology page live here now. A
            project can stay focused on a high-quality website or extend into
            application logic, integrations, automation, and infrastructure when
            the business needs it.
          </p>
        </div>

        <div class="engineering-grid">
          <article>
            <span>01 // FRONTEND</span>
            <h3>Interfaces with structure and intent.</h3>
            <p>
              Semantic HTML, modern CSS, TypeScript, responsive composition,
              components, browser APIs, progressive enhancement, and interaction
              design.
            </p>
          </article>
          <article>
            <span>02 // BACKEND + APIs</span>
            <h3>Reliable behavior behind the interface.</h3>
            <p>
              Validation, request handling, typed boundaries, webhooks,
              integrations, authentication flows, data contracts, and
              failure-aware server logic.
            </p>
          </article>
          <article>
            <span>03 // AUTOMATION</span>
            <h3>Connect work that should not require another click.</h3>
            <p>
              Event-driven workflows can connect websites, APIs, email,
              databases, business tools, and AI-assisted tasks around a real
              process.
            </p>
          </article>
          <article>
            <span>04 // INFRASTRUCTURE</span>
            <h3>Ship it, run it, and know when it breaks.</h3>
            <p>
              Cloud and edge deployment, DNS, environments, caching,
              observability, source control, CI/CD, and self-hosted systems.
            </p>
          </article>
          <article>
            <span>05 // PERFORMANCE</span>
            <h3>Speed is part of how the product feels.</h3>
            <p>
              Rendering cost, payload, network behavior, responsive assets, and
              unnecessary client-side work are treated as engineering decisions.
            </p>
          </article>
          <article>
            <span>06 // SECURITY + ACCESSIBILITY</span>
            <h3>Quality constraints belong in the implementation.</h3>
            <p>
              Inputs, secrets, permissions, dependencies, semantics, focus,
              keyboard behavior, contrast, and motion all receive explicit
              boundaries and verification.
            </p>
          </article>
        </div>
      </section>

      <section class="process" aria-labelledby="process-title">
        <div class="section-heading">
          <p class="eyebrow">HOW THE WORK MOVES</p>
          <h2 id="process-title">
            From “we need a website” to a working system.
          </h2>
        </div>
        <ol class="process-grid">
          <li>
            <span>01</span>
            <h3>Understand</h3>
            <p>
              Define the audience, the decision they need to make, the content
              required to support it, and the technical constraints.
            </p>
          </li>
          <li>
            <span>02</span>
            <h3>Structure</h3>
            <p>
              Build the information hierarchy and interaction model before
              decoration starts hiding weak decisions.
            </p>
          </li>
          <li>
            <span>03</span>
            <h3>Engineer</h3>
            <p>
              Implement the interface and the systems behind it with responsive,
              accessible, maintainable primitives.
            </p>
          </li>
          <li>
            <span>04</span>
            <h3>Verify</h3>
            <p>
              Test the browser behavior, performance, accessibility, deployment,
              and production path before calling the job finished.
            </p>
          </li>
        </ol>
      </section>

      <section class="cta" aria-labelledby="cta-title">
        <p class="eyebrow">YOUR WEBSITE SHOULD DO A JOB</p>
        <h2 id="cta-title">Give customers fewer reasons to leave confused.</h2>
        <p>
          If the current site is not explaining the business, earning trust, or
          making the next step obvious, that is the problem to solve first.
        </p>
        <a tabindex="0" class="button button--primary" href="/contact">
          Start a project
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(body) {
    --home-accent: var(--brand-green);
    --home-bg: #05070c;
    --home-surface: #0d111b;
    --home-surface-soft: #101624;
    --home-border: #192033;
    --home-heading: #f6f8ff;
    --home-text: #eef2ff;
    --home-muted: #a0abc0;
    --home-soft: #8794aa;
    --page-heading: var(--home-heading);
    --page-muted: var(--home-muted);
    --page-border: var(--home-border);
    color: var(--home-text);
  }

  main {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    padding: 0 0 6rem;
  }

  .eyebrow {
    margin: 0 0 1.15rem;
    color: var(--home-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  h1,
  h2,
  h3 {
    color: var(--home-heading);
  }

  .hero {
    min-height: min(780px, calc(100vh - 80px));
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 4rem;
    align-items: center;
    padding: 5rem 0 6rem;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
  }

  h1 {
    max-width: 850px;
    margin-bottom: 2rem;
    font-size: clamp(3.6rem, 7.4vw, 7rem);
    letter-spacing: -0.058em;
    line-height: 0.91;
  }

  h1 span {
    color: var(--home-accent);
  }

  .hero__lede {
    max-width: 680px;
    color: var(--home-muted);
    font-size: clamp(1.08rem, 2vw, 1.36rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      border-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--primary {
    background: #16803b;
    color: #fff;
  }

  .button--ghost {
    border: 1px solid #293149;
    background: #0d111b;
    color: #eef2ff;
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__signals li {
    padding: 0.42rem 0.65rem;
    border: 1px solid var(--home-border);
    border-radius: 999px;
    color: var(--home-soft);
    font-size: 0.72rem;
  }

  .hero__visual {
    position: relative;
    min-height: 540px;
    display: grid;
    place-items: center;
  }

  .system-panel {
    position: relative;
    z-index: 2;
    width: min(470px, 100%);
    padding: 1.5rem;
    border: 1px solid rgba(57, 255, 90, 0.22);
    border-radius: 28px;
    background: linear-gradient(
      145deg,
      rgba(24, 38, 29, 0.92),
      rgba(9, 12, 21, 0.9)
    );
    box-shadow:
      0 30px 100px rgba(0, 0, 0, 0.5),
      inset 0 1px rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
  }

  .panel-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #8f9ab2;
    font-size: 0.63rem;
    letter-spacing: 0.12em;
  }

  .status {
    color: #b7c0d4;
  }

  .status i {
    width: 6px;
    height: 6px;
    display: inline-block;
    margin-right: 5px;
    border-radius: 50%;
    background: var(--home-accent);
    box-shadow: 0 0 12px var(--home-accent);
  }

  .system-core {
    position: relative;
    width: 220px;
    height: 220px;
    display: grid;
    place-items: center;
    margin: 3.2rem auto 2.25rem;
  }

  .core-ring {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(57, 255, 90, 0.38);
    border-radius: 50%;
  }

  .core-ring--outer {
    border-top-color: rgba(57, 255, 90, 0.85);
    border-right-color: transparent;
    animation: spin 18s linear infinite;
  }

  .core-ring--inner {
    inset: 28px;
    border-bottom-color: rgba(154, 255, 170, 0.85);
    border-left-color: transparent;
    animation: spin-reverse 12s linear infinite;
  }

  .core-center {
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(57, 255, 90, 0.55);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(57, 255, 90, 0.22),
      rgba(5, 7, 12, 0.8)
    );
    box-shadow: 0 0 60px rgba(57, 255, 90, 0.2);
    color: #effff2;
    font-size: 2rem;
    font-weight: 700;
  }

  .system-readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin: 0;
  }

  .system-readout div {
    padding: 0.8rem;
    border: 1px solid rgba(57, 255, 90, 0.12);
    border-radius: 12px;
    background: rgba(4, 8, 13, 0.38);
  }

  .system-readout dt {
    color: #6f7b90;
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .system-readout dd {
    margin: 0.25rem 0 0;
    color: #dce5f5;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .system-label {
    margin: 1.35rem 0 0;
    text-align: center;
    color: #7f8ba0;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    opacity: 0.7;
    filter: blur(2px);
  }

  .orb--one {
    width: 280px;
    height: 280px;
    top: 4%;
    right: 0;
    background: radial-gradient(
      circle,
      rgba(57, 255, 90, 0.32),
      transparent 68%
    );
    animation: drift 9s ease-in-out infinite;
  }

  .orb--two {
    width: 240px;
    height: 240px;
    bottom: 2%;
    left: 4%;
    background: radial-gradient(
      circle,
      rgba(117, 255, 144, 0.2),
      transparent 68%
    );
    animation: drift 11s ease-in-out infinite reverse;
  }

  .why,
  .proof,
  .outcomes,
  .portfolio,
  .engineering,
  .process {
    padding: 6.5rem 0;
    border-top: 1px solid var(--home-border);
  }

  .section-heading {
    max-width: 790px;
  }

  .section-heading h2,
  .proof__heading h2,
  .cta h2 {
    margin-bottom: 1.1rem;
    font-size: clamp(2.55rem, 5vw, 4.8rem);
    letter-spacing: -0.048em;
    line-height: 0.98;
  }

  .section-heading > p:last-child,
  .proof__heading > p:last-child,
  .cta > p {
    max-width: 720px;
    color: var(--home-muted);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .reason-grid,
  .proof-grid,
  .outcome-grid,
  .portfolio-grid,
  .engineering-grid,
  .process-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  .reason-grid,
  .outcome-grid,
  .engineering-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .portfolio-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .engineering-grid article {
    min-height: 250px;
    padding: 2rem;
    border: 1px solid var(--home-border);
    border-radius: 24px;
    background: linear-gradient(
      145deg,
      rgba(18, 23, 36, 0.9),
      rgba(8, 11, 18, 0.9)
    );
  }

  .engineering-grid article > span {
    color: var(--home-accent);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .engineering-grid h3 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }

  .engineering-grid p {
    margin: 0;
    color: var(--home-muted);
    line-height: 1.65;
  }

  .reason-card,
  .proof-grid article,
  .outcome-grid article,
  .process-grid li {
    border: 1px solid var(--home-border);
    border-radius: 24px;
    background: linear-gradient(
      145deg,
      rgba(18, 23, 36, 0.9),
      rgba(8, 11, 18, 0.9)
    );
  }

  .reason-card {
    min-height: 260px;
    padding: 2rem;
  }

  .reason-card--lead {
    background:
      radial-gradient(circle at 10% 0, rgba(57, 255, 90, 0.1), transparent 55%),
      linear-gradient(145deg, rgba(20, 31, 25, 0.96), rgba(8, 11, 18, 0.94));
  }

  .reason-number {
    color: var(--home-soft);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
  }

  .reason-card h3,
  .proof-grid h3,
  .outcome-grid h3,
  .process-grid h3 {
    margin: 3rem 0 0.75rem;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }

  .reason-card p,
  .proof-grid p,
  .outcome-grid p,
  .process-grid p {
    margin: 0;
    color: var(--home-muted);
    line-height: 1.65;
  }

  .proof {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 4rem;
  }

  .proof__heading {
    align-self: start;
    position: sticky;
    top: 2rem;
  }

  .proof-grid {
    grid-template-columns: 1fr;
    margin-top: 0;
  }

  .proof-grid article {
    padding: 2rem;
  }

