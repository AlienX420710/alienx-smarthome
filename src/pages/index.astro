---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:SITE_TITLE,url:'https://alienxsmarthome.com/',description:SITE_DESCRIPTION,publisher:{'@type':'Organization',name:SITE_TITLE,url:'https://alienxsmarthome.com/'}})} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__copy"><p class="eyebrow">ALIENX // TECHNOLOGY</p><h1 id="hero-title">Technology built to <span>do something.</span></h1><p class="hero__lede">AlienX builds websites, applications, automation, and infrastructure—using the web as both a tool and a medium for experimentation.</p><div class="hero__actions"><a class="button button--primary" href="/experience">Explore AlienX</a><a class="button button--ghost" href="/contact">Start a project</a></div></div>
				<div class="hero__visual" aria-label="Interactive AlienX technology visualization"><div class="orb orb--one"></div><div class="orb orb--two"></div><div class="system-panel"><div class="panel-topline"><span>ALIENX SYSTEM</span><span class="status"><i></i> ONLINE</span></div><div class="system-core" aria-hidden="true"><div class="core-ring core-ring--outer"></div><div class="core-ring core-ring--inner"></div><div class="core-center">X</div></div><div class="system-label">WEB · AUTOMATION · INFRASTRUCTURE</div><div class="system-lines" aria-hidden="true"><span></span><span></span><span></span></div></div></div>
			</section>

			<section id="capabilities" class="capabilities" aria-labelledby="capabilities-title"><div class="section-heading"><p class="eyebrow">WHAT ALIENX BUILDS</p><h2 id="capabilities-title">One technical foundation. A lot of directions.</h2><p>The goal isn't to fit every project into one category. It's to understand the problem, choose the right tools, and build the thing properly.</p></div><div class="capability-grid">
				<a class="capability-card capability-card--large" href="/technology"><span class="capability-number">01</span><h3>Web development</h3><p>Websites and applications with thoughtful frontend, backend, performance, and accessibility engineering.</p><span class="card-arrow" aria-hidden="true">↗</span></a>
				<a class="capability-card" href="/technology"><span class="capability-number">02</span><h3>Automation</h3><p>Connect services, APIs, workflows, and systems so repetitive work happens automatically.</p><span class="card-arrow" aria-hidden="true">↗</span></a>
				<a class="capability-card" href="/technology"><span class="capability-number">03</span><h3>Infrastructure</h3><p>Servers, networking, deployment, self-hosting, and the systems underneath the interface.</p><span class="card-arrow" aria-hidden="true">↗</span></a>
				<a class="capability-card capability-card--wide" href="/technology"><span class="capability-number">04</span><h3>Smart technology</h3><p>Home Assistant, connected devices, and automation remain part of the story that started AlienX—but they're one part of a much larger technical direction.</p><span class="card-arrow" aria-hidden="true">↗</span></a>
			</div></section>

			<section class="proof" aria-labelledby="proof-title"><div><p class="eyebrow">THE APPROACH</p><h2 id="proof-title">The website is part of the proof.</h2></div><div class="proof-copy"><p>AlienX isn't presented as a static brochure. The site itself demonstrates browser engineering, interaction design, performance, accessibility, and the ability to turn technical ideas into something people can experience.</p><a class="text-link" href="/experience">See what the browser can do <span aria-hidden="true">→</span></a></div></section>
			<section class="cta" aria-labelledby="cta-title"><p class="eyebrow">NEXT</p><h2 id="cta-title">Have something worth building?</h2><p>Bring the idea. We'll figure out the technology.</p><a class="button button--primary" href="/contact">Start a project</a></section>
		</main><Footer />
	</body>
</html>

<style>
	:global(body) { background:#05070c; color:#eef2ff; }
	main { width:min(1180px,calc(100% - 40px)); max-width:none; padding:0 0 6rem; }
	.hero { min-height:min(760px,calc(100vh - 80px)); display:grid; grid-template-columns:1.05fr .95fr; gap:4rem; align-items:center; padding:5rem 0 6rem; }
	.hero__copy { position:relative; z-index:2; }
	.eyebrow { margin:0 0 1.25rem; font-size:.72rem; font-weight:700; letter-spacing:.22em; color:#a7b2c7; }
	h1,h2,h3 { color:#f6f8ff; }
	h1 { font-size:clamp(3.4rem,7vw,6.8rem); letter-spacing:-.055em; line-height:.92; max-width:850px; margin-bottom:2rem; }
	h1 span { color:#39ff5a; }
	.hero__lede { max-width:650px; font-size:clamp(1.05rem,2vw,1.35rem); line-height:1.55; color:#b0b9cc; }
	.hero__actions { display:flex; gap:.8rem; flex-wrap:wrap; margin-top:2rem; }
	.button { display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:0 1.25rem; border-radius:999px; font-size:.9rem; font-weight:700; text-decoration:none; transition:transform 180ms ease,background 180ms ease,border-color 180ms ease; }
	.button:hover { transform:translateY(-2px); }
	.button--primary { color:#041006; background:#39ff5a; }
	.button--ghost { color:#eef2ff; border:1px solid #293149; background:#0d111b; }
	.hero__visual { position:relative; min-height:520px; display:grid; place-items:center; }
	.system-panel { position:relative; z-index:2; width:min(460px,100%); padding:1.5rem; border:1px solid rgba(57,255,90,.22); border-radius:28px; background:linear-gradient(145deg,rgba(24,38,29,.9),rgba(9,12,21,.86)); box-shadow:0 30px 100px rgba(0,0,0,.5),inset 0 1px rgba(255,255,255,.06); backdrop-filter:blur(20px); }
	.panel-topline { display:flex; justify-content:space-between; gap:1rem; font-size:.63rem; letter-spacing:.12em; color:#8f9ab2; }
	.status { color:#b7c0d4; }
	.status i { display:inline-block; width:6px; height:6px; margin-right:5px; border-radius:50%; background:#39ff5a; box-shadow:0 0 12px #39ff5a; }
	.system-core { position:relative; width:230px; height:230px; margin:4rem auto 2.5rem; display:grid; place-items:center; }
	.core-ring { position:absolute; inset:0; border:1px solid rgba(57,255,90,.38); border-radius:50%; }
	.core-ring--outer { animation:spin 18s linear infinite; border-top-color:rgba(57,255,90,.85); border-right-color:transparent; }
	.core-ring--inner { inset:28px; animation:spin-reverse 12s linear infinite; border-bottom-color:rgba(154,255,170,.85); border-left-color:transparent; }
	.core-center { width:92px; height:92px; display:grid; place-items:center; border:1px solid rgba(57,255,90,.55); border-radius:50%; color:#effff2; font-size:2rem; font-weight:700; letter-spacing:-.08em; background:radial-gradient(circle,rgba(57,255,90,.22),rgba(5,7,12,.8)); box-shadow:0 0 60px rgba(57,255,90,.2); }
	.system-label { text-align:center; color:#a7b2c7; font-size:.65rem; letter-spacing:.16em; }
	.system-lines { display:flex; gap:.5rem; margin-top:2rem; }
	.system-lines span { display:block; height:3px; flex:1; border-radius:999px; background:rgba(57,255,90,.2); }
	.system-lines span:first-child { flex:1.7; background:rgba(57,255,90,.65); }
	.orb { position:absolute; border-radius:50%; filter:blur(2px); opacity:.7; }
	.orb--one { width:280px; height:280px; top:4%; right:0; background:radial-gradient(circle,rgba(57,255,90,.32),transparent 68%); animation:drift 9s ease-in-out infinite; }
	.orb--two { width:240px; height:240px; bottom:2%; left:4%; background:radial-gradient(circle,rgba(117,255,144,.2),transparent 68%); animation:drift 11s ease-in-out infinite reverse; }
	.capabilities { padding:5rem 0; border-top:1px solid #151b29; }
	.section-heading { max-width:760px; }
	.section-heading h2,.proof h2,.cta h2 { font-size:clamp(2.4rem,5vw,4.5rem); letter-spacing:-.045em; line-height:1; margin-bottom:1rem; }
	.section-heading>p:last-child,.cta>p { color:#9ca7bc; max-width:620px; }
	.capability-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; margin-top:3rem; }
	.capability-card { position:relative; min-height:250px; padding:2rem; border:1px solid #192033; border-radius:24px; background:linear-gradient(145deg,rgba(18,23,36,.9),rgba(8,11,18,.9)); text-decoration:none; transition:transform 200ms ease,border-color 200ms ease,background 200ms ease; }
	.capability-card:hover { transform:translateY(-4px); border-color:#2d7040; background:linear-gradient(145deg,rgba(23,36,28,.95),rgba(8,11,18,.95)); }
	.capability-card--large { min-height:310px; }
	.capability-card--wide { grid-column:span 2; }
	.capability-number { color:#8e9ab0; font-size:.72rem; letter-spacing:.15em; }
	.capability-card h3 { margin-top:3.5rem; font-size:1.5rem; }
	.capability-card p { max-width:600px; color:#a0abc0; font-size:.95rem; line-height:1.6; }
	.card-arrow { position:absolute; right:2rem; bottom:1.8rem; color:#39ff5a; font-size:1.25rem; }
	.proof { display:grid; grid-template-columns:1fr 1fr; gap:4rem; padding:7rem 0; border-top:1px solid #151b29; }
	.proof-copy { align-self:end; }
	.proof-copy p { max-width:620px; color:#a0abc0; font-size:1.1rem; line-height:1.7; }
	.text-link { display:inline-flex; gap:.55rem; margin-top:1.5rem; color:#eef2ff; font-weight:700; text-decoration:none; }
	.text-link:hover { color:#39ff5a; }
	.cta { margin:1rem 0 0; padding:clamp(3rem,7vw,7rem); text-align:center; border:1px solid #192033; border-radius:32px; background:radial-gradient(circle at 50% 0%,rgba(57,255,90,.14),transparent 55%),#090d16; }
	.cta>p { margin:0 auto 2rem; }
	@keyframes spin { to{transform:rotate(360deg)} } @keyframes spin-reverse { to{transform:rotate(-360deg)} } @keyframes drift { 0%,100%{transform:translate3d(0,0,0)} 50%{transform:translate3d(18px,-14px,0)} }
	@media(prefers-reduced-motion:reduce){ .core-ring,.orb{animation:none}.button,.capability-card{transition:none} }
	@media(max-width:800px){ main{width:min(100% - 28px,680px)}.hero{grid-template-columns:1fr;gap:2rem;padding-top:3rem}.hero__visual{min-height:400px}.capability-grid,.proof{grid-template-columns:1fr}.capability-card--wide{grid-column:auto}.proof{gap:2rem} }
	@media(max-width:520px){ .system-core{width:190px;height:190px}.core-center{width:78px;height:78px}.panel-topline{flex-direction:column}.capability-card--large{min-height:250px} }
</style>
