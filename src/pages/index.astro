---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__copy">
					<p class="eyebrow">ALIENX // SMART HOME</p>
					<h1 id="hero-title">The smart home,<br /><span>reimagined for the web.</span></h1>
					<p class="hero__lede">
						A high-performance interactive showcase of what modern HTML, CSS, JavaScript,
						accessibility, and thoughtful engineering can do.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="/experience">Explore the experience</a>
						<a class="button button--ghost" href="#showcase">See what's inside</a>
					</div>
				</div>

				<div class="hero__visual" aria-label="Interactive smart home preview">
					<div class="orb orb--one"></div>
					<div class="orb orb--two"></div>
					<div class="home-panel">
						<div class="panel-topline">
							<span>HOME STATUS</span>
							<span class="status"><i></i> ALL SYSTEMS NOMINAL</span>
						</div>
						<div class="temperature">72<span>°</span></div>
						<div class="panel-label">Living room · Comfortable</div>
						<div class="metrics">
							<div><strong>42%</strong><span>Humidity</span></div>
							<div><strong>2.4</strong><span>kW Usage</span></div>
							<div><strong>18</strong><span>Devices</span></div>
						</div>
					</div>
				</div>
			</section>

			<section id="showcase" class="showcase" aria-labelledby="showcase-title">
				<div class="section-heading">
					<p class="eyebrow">BUILT, NOT MOCKED</p>
					<h2 id="showcase-title">A website that behaves like a product.</h2>
					<p>
						Every interaction is designed to demonstrate a real browser capability or
						engineering decision—not just decorate a screenshot.
					</p>
				</div>

				<div class="feature-grid">
					<article class="feature-card feature-card--large">
						<span class="feature-number">01</span>
						<h3>Interactive environments</h3>
						<p>Rooms, scenes, devices, lighting, climate, and energy respond in real time.</p>
					</article>
					<article class="feature-card">
						<span class="feature-number">02</span>
						<h3>Pure browser power</h3>
						<p>CSS effects, SVG, JavaScript state, animation, and progressive enhancement.</p>
					</article>
					<article class="feature-card">
						<span class="feature-number">03</span>
						<h3>Engineered for speed</h3>
						<p>Astro-first architecture keeps pages lean, indexable, and fast by default.</p>
					</article>
					<article class="feature-card feature-card--wide">
						<span class="feature-number">04</span>
						<h3>Accessible by design</h3>
						<p>Semantic HTML, keyboard-friendly controls, contrast, focus states, and reduced-motion support are part of the interface—not an afterthought.</p>
					</article>
				</div>
			</section>

			<section class="cta" aria-labelledby="cta-title">
				<p class="eyebrow">NEXT</p>
				<h2 id="cta-title">Step inside AlienX.</h2>
				<p>The interactive experience is where the experiment becomes tangible.</p>
				<a class="button button--primary" href="/experience">Launch experience</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #05070c;
		color: #eef2ff;
	}

	main {
		width: min(1180px, calc(100% - 40px));
		max-width: none;
		padding: 0 0 6rem;
	}

	.hero {
		min-height: min(760px, calc(100vh - 80px));
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 4rem;
		align-items: center;
		padding: 5rem 0 6rem;
	}

	.hero__copy { position: relative; z-index: 2; }
	.eyebrow {
		margin: 0 0 1.25rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: #8d9bbd;
	}

	h1, h2, h3 { color: #f6f8ff; }
	h1 {
		font-size: clamp(3.4rem, 7vw, 6.8rem);
		letter-spacing: -0.055em;
		line-height: 0.92;
		max-width: 850px;
		margin-bottom: 2rem;
	}
	h1 span { color: #8e9cff; }
	.hero__lede {
		max-width: 650px;
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.55;
		color: #aab4ca;
	}
	.hero__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2rem; }
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 1.25rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
	}
	.button:hover { transform: translateY(-2px); }
	.button--primary { color: #05070c; background: #eef2ff; }
	.button--ghost { color: #eef2ff; border: 1px solid #293149; background: #0d111b; }

	.hero__visual { position: relative; min-height: 520px; display: grid; place-items: center; }
	.home-panel {
		position: relative;
		z-index: 2;
		width: min(460px, 100%);
		padding: 1.5rem;
		border: 1px solid rgba(173, 186, 255, 0.2);
		border-radius: 28px;
		background: linear-gradient(145deg, rgba(28, 35, 58, 0.9), rgba(9, 12, 21, 0.86));
		box-shadow: 0 30px 100px rgba(0,0,0,.5), inset 0 1px rgba(255,255,255,.06);
		backdrop-filter: blur(20px);
		animation: float 6s ease-in-out infinite;
	}
	.panel-topline { display: flex; justify-content: space-between; gap: 1rem; font-size: .63rem; letter-spacing: .12em; color: #7784a6; }
	.status { color: #aeb8d2; }
	.status i { display: inline-block; width: 6px; height: 6px; margin-right: 5px; border-radius: 50%; background: #72e0a3; box-shadow: 0 0 12px #72e0a3; }
	.temperature { margin-top: 4rem; font-size: 8rem; line-height: .8; letter-spacing: -.08em; font-weight: 700; }
	.temperature span { font-size: 2rem; vertical-align: top; color: #8e9cff; }
	.panel-label { margin-top: 1rem; color: #8d99b5; }
	.metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: 3rem; }
	.metrics div { padding: 1rem; border: 1px solid rgba(255,255,255,.06); border-radius: 16px; background: rgba(255,255,255,.025); }
	.metrics strong, .metrics span { display: block; }
	.metrics strong { font-size: 1.25rem; }
	.metrics span { margin-top: .25rem; font-size: .68rem; color: #7784a6; }
	.orb { position: absolute; border-radius: 50%; filter: blur(2px); opacity: .7; }
	.orb--one { width: 280px; height: 280px; top: 4%; right: 0; background: radial-gradient(circle, rgba(113,126,255,.45), transparent 68%); animation: drift 9s ease-in-out infinite; }
	.orb--two { width: 240px; height: 240px; bottom: 2%; left: 4%; background: radial-gradient(circle, rgba(57,183,255,.24), transparent 68%); animation: drift 11s ease-in-out infinite reverse; }

	.showcase { padding: 5rem 0; border-top: 1px solid #151b29; }
	.section-heading { max-width: 700px; }
	.section-heading h2, .cta h2 { font-size: clamp(2.4rem, 5vw, 4.5rem); letter-spacing: -.045em; line-height: 1; margin-bottom: 1rem; }
	.section-heading > p:last-child, .cta > p { color: #8f9ab2; max-width: 620px; }
	.feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 3rem; }
	.feature-card { min-height: 220px; padding: 2rem; border: 1px solid #192033; border-radius: 24px; background: linear-gradient(145deg, rgba(18,23,36,.9), rgba(8,11,18,.9)); transition: transform 200ms ease, border-color 200ms ease; }
	.feature-card:hover { transform: translateY(-4px); border-color: #34405f; }
	.feature-card--large { min-height: 300px; }
	.feature-card--wide { grid-column: span 2; }
	.feature-number { color: #63708f; font-size: .72rem; letter-spacing: .15em; }
	.feature-card h3 { margin-top: 3.5rem; font-size: 1.5rem; }
	.feature-card p { color: #8490aa; font-size: .95rem; line-height: 1.6; }
	.cta { margin: 5rem 0 0; padding: clamp(3rem, 7vw, 7rem); text-align: center; border: 1px solid #192033; border-radius: 32px; background: radial-gradient(circle at 50% 0%, rgba(105,119,255,.18), transparent 55%), #090d16; }
	.cta > p { margin: 0 auto 2rem; }

	@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
	@keyframes drift { 0%,100% { transform: translate3d(0,0,0); } 50% { transform: translate3d(18px,-14px,0); } }
	@media (prefers-reduced-motion: reduce) { .home-panel, .orb { animation: none; } .button, .feature-card { transition: none; } }
	@media (max-width: 800px) {
		main { width: min(100% - 28px, 680px); }
		.hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 3rem; }
		.hero__visual { min-height: 400px; }
		.feature-grid { grid-template-columns: 1fr; }
		.feature-card--wide { grid-column: auto; }
	}
	@media (max-width: 520px) {
		.temperature { font-size: 6rem; }
		.panel-topline { flex-direction: column; }
		.metrics { margin-top: 2rem; }
		.feature-card--large { min-height: 220px; }
	}
</style>
