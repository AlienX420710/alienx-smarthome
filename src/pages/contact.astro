---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HoneypotField from '../components/HoneypotField.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Let's build this — ${SITE_TITLE}`}
			description="Tell AlienX SmartHome what you want to build and how we should contact you."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title">
				<div class="copy">
					<p class="eyebrow">ALIENX / INQUIRY</p>
					<h1 id="title">I want this.</h1>
					<p class="lede">
						If the experience made you stop and think, tell us what you want to build.
						Give us enough context to make the first conversation useful.
					</p>
					<div class="signal" aria-label="Inquiry process">
						<span>01</span><b>Tell us</b><i></i><span>02</span><b>We respond</b><i></i><span>03</span><b>Explore it</b>
					</div>
				</div>

				<form id="inquiry-form" novalidate>
					<fieldset>
						<legend>Contact</legend>
						<div class="field-grid">
							<div class="field">
								<label for="name">Name <span aria-hidden="true">*</span></label>
								<input id="name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
								<p class="error" data-error="name" role="alert"></p>
							</div>
							<div class="field">
								<label for="email">Email <span aria-hidden="true">*</span></label>
								<input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
								<p class="error" data-error="email" role="alert"></p>
							</div>
						</div>
						<div class="field-grid">
							<div class="field">
								<label for="phone">Phone</label>
								<input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="(555) 555-5555" />
								<p class="hint">Required if you prefer phone or text.</p>
								<p class="error" data-error="phone" role="alert"></p>
							</div>
							<div class="field">
								<label for="company">Company / business</label>
								<input id="company" name="company" type="text" autocomplete="organization" maxlength="120" />
								<p class="error" data-error="company" role="alert"></p>
							</div>
						</div>
						<div class="field-grid">
							<div class="field">
								<label for="contact-method">Best way to contact you <span aria-hidden="true">*</span></label>
								<select id="contact-method" name="contactMethod" required>
									<option value="">Choose one</option><option value="email">Email</option><option value="phone">Phone call</option><option value="text">Text message</option><option value="either">Email or phone</option>
								</select>
								<p class="error" data-error="contactMethod" role="alert"></p>
							</div>
							<div class="field">
								<label for="contact-time">Best time to contact you</label>
								<select id="contact-time" name="contactTime">
									<option value="">No preference</option><option value="morning">Morning</option><option value="afternoon">Afternoon</option><option value="evening">Evening</option><option value="anytime">Anytime</option>
								</select>
								<p class="error" data-error="contactTime" role="alert"></p>
							</div>
						</div>
						<div class="field">
							<label for="timezone">Time zone</label>
							<select id="timezone" name="timezone">
								<option value="">No preference</option><option value="Eastern">Eastern</option><option value="Central">Central</option><option value="Mountain">Mountain</option><option value="Pacific">Pacific</option><option value="Alaska">Alaska</option><option value="Hawaii">Hawaii</option><option value="Other">Other / outside the U.S.</option>
							</select>
						</div>
					</fieldset>

					<fieldset>
						<legend>Project</legend>
						<div class="field">
							<label for="project-type">What are you interested in? <span aria-hidden="true">*</span></label>
							<select id="project-type" name="projectType" required>
								<option value="">Choose one</option><option value="website-design">Website design</option><option value="website-redesign">Website redesign</option><option value="ecommerce">E-commerce website</option><option value="smart-home">Smart-home / technology experience</option><option value="interactive-web">Interactive website</option><option value="web-app">Web application</option><option value="seo-performance">SEO / performance</option><option value="other">Something else</option>
							</select>
							<p class="error" data-error="projectType" role="alert"></p>
						</div>
						<div class="field-grid">
							<div class="field">
								<label for="current-website">What do you have today?</label>
								<select id="current-website" name="currentWebsite">
									<option value="">Choose one</option><option value="none">No website yet</option><option value="existing">Existing website</option><option value="redesign">Existing site that needs a redesign</option><option value="other">Other</option>
								</select>
							</div>
							<div class="field">
								<label for="website-url">Current website URL</label>
								<input id="website-url" name="websiteUrl" type="url" inputmode="url" maxlength="2048" placeholder="https://example.com" />
								<p class="error" data-error="websiteUrl" role="alert"></p>
							</div>
						</div>
						<div class="field-grid three">
							<div class="field"><label for="timeline">Target timeline</label><select id="timeline" name="timeline"><option value="">Choose one</option><option value="asap">ASAP</option><option value="under-30-days">Within 30 days</option><option value="1-3-months">1–3 months</option><option value="3-6-months">3–6 months</option><option value="exploring">Just exploring</option></select></div>
							<div class="field"><label for="budget">Approximate budget</label><select id="budget" name="budget"><option value="">Choose one</option><option value="under-1000">Under $1,000</option><option value="1000-2500">$1,000–$2,500</option><option value="2500-5000">$2,500–$5,000</option><option value="5000-10000">$5,000–$10,000</option><option value="10000-plus">$10,000+</option><option value="not-sure">Not sure yet</option></select></div>
							<div class="field"><label for="source">How did you find us?</label><select id="source" name="source"><option value="">Choose one</option><option value="google">Google</option><option value="social">Social media</option><option value="referral">Referral</option><option value="experience">Saw the AlienX experience</option><option value="other">Other</option></select></div>
						</div>
						<div class="field">
							<label for="message">Tell us about the project <span aria-hidden="true">*</span></label>
							<textarea id="message" name="message" rows="7" minlength="10" maxlength="4000" required placeholder="What are you trying to build, improve, or accomplish?"></textarea>
							<p class="hint">A few sentences is plenty. Don't include passwords, payment details, or other sensitive information.</p>
							<p class="error" data-error="message" role="alert"></p>
						</div>
					</fieldset>

					<HoneypotField />
					<div class="consent">
						<label class="checkbox-label"><input id="consent" name="consent" type="checkbox" value="yes" required /><span>I agree that AlienX may contact me about this inquiry.</span></label>
						<p class="error" data-error="consent" role="alert"></p>
					</div>
					<div class="actions">
						<button type="submit" id="submit-button"><span data-button-label>Start the conversation</span><span class="arrow" aria-hidden="true">→</span></button>
						<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
					</div>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const form = document.querySelector<HTMLFormElement>('#inquiry-form');
	const status = document.querySelector<HTMLElement>('#form-status');
	const button = document.querySelector<HTMLButtonElement>('#submit-button');
	const buttonLabel = document.querySelector<HTMLElement>('[data-button-label]');

	if (form && status && button && buttonLabel) {
		const requiredFields = ['name', 'email', 'contactMethod', 'projectType', 'message'] as const;
		const phoneInput = form.elements.namedItem('phone') as HTMLInputElement;
		const contactMethod = form.elements.namedItem('contactMethod') as HTMLSelectElement;
		const consent = form.elements.namedItem('consent') as HTMLInputElement;

		const setError = (field: string, message: string) => {
			const control = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
			const error = form.querySelector<HTMLElement>(`[data-error="${field}"]`);
			if (control && error) {
				control.setAttribute('aria-invalid', message ? 'true' : 'false');
				error.textContent = message;
			}
		};

		const formatPhone = () => {
			const original = phoneInput.value;
			if (original.trimStart().startsWith('+')) return;
			const digits = original.replace(/\D/g, '').slice(0, 10);
			let formatted = digits;
			if (digits.length > 6) formatted = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
			else if (digits.length > 3) formatted = `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
			else if (digits.length > 0) formatted = `(${digits}`;
			phoneInput.value = formatted;
		};

		const updatePhoneRequirement = () => {
			const needsPhone = contactMethod.value === 'phone' || contactMethod.value === 'text';
			phoneInput.required = needsPhone;
			phoneInput.setAttribute('aria-required', String(needsPhone));
		};

		phoneInput.addEventListener('input', formatPhone);
		contactMethod.addEventListener('change', updatePhoneRequirement);
		updatePhoneRequirement();
		formatPhone();

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.textContent = '';
			status.className = 'form-status';
			[...requiredFields, 'phone', 'company', 'websiteUrl', 'contactTime', 'projectType', 'consent'].forEach((field) => setError(field, ''));
			const formData = new FormData(form);
			const value = (field: string) => String(formData.get(field) ?? '').trim();
			const name = value('name');
			const email = value('email');
			const phone = value('phone');
			const websiteUrl = value('websiteUrl');
			const message = value('message');
			let firstInvalid: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null = null;
			if (name.length < 2 || name.length > 100) { setError('name', 'Please enter your name.'); firstInvalid = form.elements.namedItem('name') as HTMLInputElement; }
			if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'Please enter a valid email address.'); firstInvalid ??= form.elements.namedItem('email') as HTMLInputElement; }
			if ((contactMethod.value === 'phone' || contactMethod.value === 'text') && (!phone || !/^[+()\d\s.-]+$/.test(phone))) { setError('phone', 'A valid phone number is required for this contact method.'); firstInvalid ??= phoneInput; }
			else if (phone && (phone.length > 30 || !/^[+()\d\s.-]+$/.test(phone))) { setError('phone', 'Please enter a valid phone number.'); firstInvalid ??= phoneInput; }
			if (websiteUrl) { try { const url = new URL(websiteUrl); if (!['http:', 'https:'].includes(url.protocol)) throw new Error(); } catch { setError('websiteUrl', 'Please enter a valid website URL.'); firstInvalid ??= form.elements.namedItem('websiteUrl') as HTMLInputElement; } }
			if (!contactMethod.value) { setError('contactMethod', 'Please choose how you would like us to contact you.'); firstInvalid ??= contactMethod; }
			if (!formData.get('projectType')) { setError('projectType', 'Please choose what you are interested in.'); firstInvalid ??= form.elements.namedItem('projectType') as HTMLSelectElement; }
			if (message.length < 10 || message.length > 4000) { setError('message', 'Please provide at least a few sentences about the project.'); firstInvalid ??= form.elements.namedItem('message') as HTMLTextAreaElement; }
			if (!consent.checked) { setError('consent', 'Please confirm that we may contact you about this inquiry.'); firstInvalid ??= consent; }
			if (firstInvalid) { firstInvalid.focus(); return; }
			button.disabled = true;
			buttonLabel.textContent = 'Sending…';
			try {
				const response = await fetch('/api/inquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, email, phone, company: value('company'), websiteUrl, contactMethod: value('contactMethod'), contactTime: value('contactTime'), timezone: value('timezone'), projectType: value('projectType'), currentWebsite: value('currentWebsite'), timeline: value('timeline'), budget: value('budget'), source: value('source'), message, consent: consent.checked, website: String(formData.get('website') ?? '') }) });
				if (!response.ok) throw new Error('Inquiry request failed.');
				window.location.assign('/contact/success');
			} catch {
				status.textContent = 'Something went wrong. Please try again in a moment.';
				status.className = 'form-status failure';
			} finally {
				button.disabled = false;
				buttonLabel.textContent = 'Start the conversation';
			}
		});
	}
</script>

<style>
	:global(body) {
		--contact-background:#05070c;
		--contact-surface:rgba(18,23,36,.92);
		--contact-surface-alt:rgba(8,11,18,.94);
		--contact-text:#eef2ff;
		--contact-heading:#f6f8ff;
		--contact-muted:#98a4bd;
		--contact-soft:#7784a6;
		--contact-label:#dfe5f4;
		--contact-input:#090d16;
		--contact-input-focus:#0b101b;
		--contact-border:#192033;
		--contact-input-border:#263149;
		--contact-divider:#1a2232;
		--contact-placeholder:#58647e;
		--contact-checkbox:#eef2ff;
		background:var(--contact-background);color:var(--contact-text)
	}
	main { width:min(1180px, calc(100% - 40px)); max-width:none; padding:5rem 0 8rem; }
	.intro { display:grid; grid-template-columns:minmax(0,1fr) minmax(420px,560px); gap:6rem; align-items:start; }
	.eyebrow { margin:0 0 1rem; color:var(--contact-soft); font-size:.7rem; font-weight:700; letter-spacing:.22em; }
	h1 { margin:0; max-width:800px; color:var(--contact-heading); font-size:clamp(4.2rem,9vw,8rem); letter-spacing:-.065em; line-height:.9; }
	.lede { max-width:620px; margin:2rem 0 0; color:var(--contact-muted); font-size:1.2rem; line-height:1.7; }
	.signal { display:grid; grid-template-columns:auto auto 1fr auto auto 1fr auto; gap:.75rem; align-items:center; margin-top:4rem; color:var(--contact-soft); font-size:.7rem; letter-spacing:.12em; }
	.signal b { color:#cbd3e7; font-size:.68rem; white-space:nowrap; }
	.signal i { height:1px; background:var(--contact-divider); }
	form { padding:2rem; border:1px solid var(--contact-border); border-radius:28px; background:linear-gradient(145deg,var(--contact-surface),var(--contact-surface-alt)); box-shadow:0 30px 80px rgba(0,0,0,.24); }
	fieldset { margin:0; padding:0; border:0; }
	fieldset + fieldset { margin-top:2rem; padding-top:2rem; border-top:1px solid var(--contact-border); }
	legend { margin-bottom:1.25rem; color:var(--contact-heading); font-size:1rem; font-weight:700; }
	.field-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.1rem; }
	.field-grid.three { grid-template-columns:repeat(3,1fr); }
	.field + .field, .field-grid + .field, .field + .field-grid { margin-top:1.1rem; }
	label { display:block; margin-bottom:.55rem; color:var(--contact-label); font-size:.78rem; font-weight:700; letter-spacing:.06em; }
	label span { color:#9eabc4; }
	input, textarea, select { width:100%; box-sizing:border-box; border:1px solid var(--contact-input-border); border-radius:14px; background:var(--contact-input); color:var(--contact-heading); padding:.9rem 1rem; outline:none; font:inherit; line-height:1.5; transition:border-color .2s,box-shadow .2s,background .2s; }
	select { appearance:auto; }
	input:focus, textarea:focus, select:focus { border-color:#6678a8; background:var(--contact-input-focus); box-shadow:0 0 0 3px rgba(100,120,168,.14); }
	input[aria-invalid="true"], textarea[aria-invalid="true"], select[aria-invalid="true"] { border-color:#a66b74; }
	textarea { resize:vertical; min-height:150px; }
	::placeholder { color:var(--contact-placeholder); }
	.hint { margin:.35rem 0 0; color:#69758e; font-size:.72rem; line-height:1.5; }
	.error { min-height:1.1rem; margin:.35rem 0 0; color:#d998a1; font-size:.75rem; }
	.consent { margin-top:1.5rem; }
	.checkbox-label { display:flex; align-items:flex-start; gap:.7rem; margin:0; color:#aeb8cc; font-size:.8rem; font-weight:400; line-height:1.5; letter-spacing:0; cursor:pointer; }
	.checkbox-label input { width:1rem; height:1rem; flex:0 0 auto; margin:.15rem 0 0; padding:0; accent-color:var(--contact-checkbox); }
	.actions { margin-top:1.25rem; }
	button { display:flex; width:100%; align-items:center; justify-content:space-between; gap:1rem; border:1px solid #68789f; border-radius:15px; padding:1rem 1.1rem; background:var(--contact-checkbox); color:#080b12; font:inherit; font-weight:700; cursor:pointer; transition:transform .2s,opacity .2s,box-shadow .2s; }
	button:hover:not(:disabled) { transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,0,0,.25); }
	button:disabled { opacity:.6; cursor:wait; }
	.arrow { font-size:1.25rem; }
	.form-status { min-height:1.5rem; margin:.9rem 0 0; font-size:.82rem; line-height:1.5; }
	.form-status.success { color:#a8cbb9; }
	.form-status.failure { color:#d998a1; }
	@media(prefers-color-scheme:light){
		:global(body){
			--contact-background:#fff;
			--contact-surface:#f5f7fb;
			--contact-surface-alt:#fff;
			--contact-text:#1d2433;
			--contact-heading:#0f1219;
			--contact-muted:#60739f;
			--contact-soft:#64708f;
			--contact-label:#30394c;
			--contact-input:#fff;
			--contact-input-focus:#f8faff;
			--contact-border:#e1e6ef;
			--contact-input-border:#cfd6e3;
			--contact-divider:#d7deea;
			--contact-placeholder:#7a879f;
			--contact-checkbox:#0f1219
		}
		.signal b{color:#47536c}
		.hint{color:#687797}
		.checkbox-label{color:#596780}
		button{color:#fff;background:#0f1219;border-color:#30394c}
	}
	@media(max-width:900px){ .intro{grid-template-columns:1fr;gap:3.5rem}.signal{margin-top:3rem} }
	@media(max-width:680px){ main{width:min(100% - 28px,680px);padding-top:3rem} form{padding:1.25rem;border-radius:22px}.field-grid,.field-grid.three{grid-template-columns:1fr}.signal{grid-template-columns:auto auto 1fr auto auto}.signal i:last-of-type{display:none}.signal b:last-of-type{display:none} }
	@media(prefers-reduced-motion:reduce){ input,textarea,select,button{transition:none} button:hover:not(:disabled){transform:none} }
</style>
