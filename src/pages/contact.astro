---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HoneypotField from '../components/HoneypotField.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Let's build this — ${SITE_TITLE}`}
			description="Tell AlienX SmartHome what caught your attention and start a conversation about an interactive smart-home experience."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title">
				<div class="copy">
					<p class="eyebrow">ALIENX / INQUIRY</p>
					<h1 id="title">I want this.</h1>
					<p class="lede">
						If the experience made you stop and think, tell us what you want to build.
						This first conversation is intentionally simple.
					</p>
					<div class="signal" aria-label="Inquiry process">
						<span>01</span><b>Tell us</b><i></i><span>02</span><b>We respond</b><i></i><span>03</span><b>Explore it</b>
					</div>
				</div>

				<form id="inquiry-form" novalidate>
					<div class="field">
						<label for="name">Name</label>
						<input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
						<p class="error" data-error="name" role="alert"></p>
					</div>

					<div class="field">
						<label for="email">Email</label>
						<input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
						<p class="error" data-error="email" role="alert"></p>
					</div>

					<div class="field">
						<label for="message">What caught your attention?</label>
						<textarea id="message" name="message" rows="7" maxlength="4000" required placeholder="A room, an idea, the interaction, the technology — tell us what you want to see in your own space."></textarea>
						<p class="error" data-error="message" role="alert"></p>
					</div>

					<HoneypotField />

					<div class="actions">
						<button type="submit" id="submit-button">
							<span data-button-label>Start the conversation</span>
							<span class="arrow" aria-hidden="true">→</span>
						</button>
						<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
					</div>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const form = document.querySelector<HTMLFormElement>('#inquiry-form');
	const status = document.querySelector<HTMLElement>('#form-status');
	const button = document.querySelector<HTMLButtonElement>('#submit-button');
	const buttonLabel = document.querySelector<HTMLElement>('[data-button-label]');

	if (form && status && button && buttonLabel) {
		const fields = ['name', 'email', 'message'] as const;

		const setError = (field: string, message: string) => {
			const input = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | null;
			const error = form.querySelector<HTMLElement>(`[data-error="${field}"]`);
			if (input && error) {
				input.setAttribute('aria-invalid', message ? 'true' : 'false');
				error.textContent = message;
			}
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.textContent = '';
			fields.forEach((field) => setError(field, ''));

			const formData = new FormData(form);
			const name = String(formData.get('name') ?? '').trim();
			const email = String(formData.get('email') ?? '').trim();
			const message = String(formData.get('message') ?? '').trim();
			let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;

			if (!name) {
				setError('name', 'Please enter your name.');
				firstInvalid = form.elements.namedItem('name') as HTMLInputElement;
			}
			if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				setError('email', 'Please enter a valid email address.');
				firstInvalid ??= form.elements.namedItem('email') as HTMLInputElement;
			}
			if (!message) {
				setError('message', 'Tell us a little about what you want to build.');
				firstInvalid ??= form.elements.namedItem('message') as HTMLTextAreaElement;
			}

			if (firstInvalid) {
				firstInvalid.focus();
				return;
			}

			button.disabled = true;
			buttonLabel.textContent = 'Sending…';

			try {
				const response = await fetch('/api/inquiry', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ name, email, message, website: String(formData.get('website') ?? '') }),
				});

				if (!response.ok) throw new Error('Inquiry request failed.');

				form.reset();
				status.textContent = 'Message received. We’ll be in touch.';
				status.className = 'form-status success';
			} catch {
				status.textContent = 'Something went wrong. Please try again in a moment.';
				status.className = 'form-status failure';
			} finally {
				button.disabled = false;
				buttonLabel.textContent = 'Start the conversation';
			}
		});
	}
</script>

<style>
	:global(body) { background:#05070c; color:#eef2ff; }
	main { width:min(1180px, calc(100% - 40px)); max-width:none; padding:5rem 0 8rem; }
	.intro { display:grid; grid-template-columns:minmax(0,1fr) minmax(420px,520px); gap:6rem; align-items:start; }
	.eyebrow { margin:0 0 1rem; color:#7784a6; font-size:.7rem; font-weight:700; letter-spacing:.22em; }
	h1 { margin:0; max-width:800px; color:#f6f8ff; font-size:clamp(4.2rem,9vw,8rem); letter-spacing:-.065em; line-height:.9; }
	.lede { max-width:620px; margin:2rem 0 0; color:#98a4bd; font-size:1.2rem; line-height:1.7; }
	.signal { display:grid; grid-template-columns:auto auto 1fr auto auto 1fr auto; gap:.75rem; align-items:center; margin-top:4rem; color:#7784a6; font-size:.7rem; letter-spacing:.12em; }
	.signal b { color:#cbd3e7; font-size:.68rem; white-space:nowrap; }
	.signal i { height:1px; background:#1a2232; }
	form { padding:2rem; border:1px solid #192033; border-radius:28px; background:linear-gradient(145deg,rgba(18,23,36,.92),rgba(8,11,18,.94)); box-shadow:0 30px 80px rgba(0,0,0,.24); }
	.field + .field { margin-top:1.35rem; }
	label { display:block; margin-bottom:.55rem; color:#dfe5f4; font-size:.78rem; font-weight:700; letter-spacing:.08em; }
	input, textarea { width:100%; border:1px solid #263149; border-radius:14px; background:#090d16; color:#f2f5ff; padding:.9rem 1rem; outline:none; font:inherit; line-height:1.5; transition:border-color .2s, box-shadow .2s, background .2s; }
	input:focus, textarea:focus { border-color:#6678a8; background:#0b101b; box-shadow:0 0 0 3px rgba(100,120,168,.14); }
	input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color:#a66b74; }
	textarea { resize:vertical; min-height:150px; }
	::placeholder { color:#58647e; }
	.error { min-height:1.15rem; margin:.35rem 0 0; color:#d998a1; font-size:.75rem; }
	.actions { margin-top:.25rem; }
	button { display:flex; width:100%; align-items:center; justify-content:space-between; gap:1rem; border:1px solid #68789f; border-radius:15px; padding:1rem 1.1rem; background:#eef2ff; color:#080b12; font:inherit; font-weight:700; cursor:pointer; transition:transform .2s, opacity .2s, box-shadow .2s; }
	button:hover:not(:disabled) { transform:translateY(-2px); box-shadow:0 12px 30px rgba(0,0,0,.25); }
	button:disabled { opacity:.6; cursor:wait; }
	.arrow { font-size:1.25rem; }
	.form-status { min-height:1.5rem; margin:.9rem 0 0; font-size:.82rem; line-height:1.5; }
	.form-status.success { color:#a8cbb9; }
	.form-status.failure { color:#d998a1; }
	@media(max-width:900px){ .intro{grid-template-columns:1fr;gap:3.5rem}.signal{margin-top:3rem} }
	@media(max-width:600px){ main{width:min(100% - 28px,680px);padding-top:3rem} form{padding:1.25rem;border-radius:22px}.signal{grid-template-columns:auto auto 1fr auto auto;}.signal i:last-of-type{display:none}.signal b:last-of-type{display:none} }
	@media(prefers-reduced-motion:reduce){ input,textarea,button{transition:none} button:hover:not(:disabled){transform:none} }
</style>
