---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LabAdvanced from '../components/LabAdvanced.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="AlienX Lab"
      description="A native-first browser interaction lab for AlienX SmartHome."
    />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <section class="lab-hero" aria-labelledby="lab-title">
        <p class="eyebrow">ALIENX // LAB</p>
        <h1 id="lab-title">The browser is the instrument.</h1>
        <p class="lede">
          A production-safe playground built from semantic HTML, modern CSS,
          native controls, and progressive enhancement principles. No UI
          framework. No interaction library. No decorative JavaScript.
        </p>
        <div class="hero-meta" aria-label="Lab implementation details">
          <span>HTML state</span>
          <span>CSS :has()</span>
          <span>Container queries</span>
          <span>Reduced motion</span>
        </div>
      </section>

      <section class="reactor-section" aria-labelledby="reactor-title">
        <div class="section-copy">
          <p class="eyebrow">01 // STATE REACTOR</p>
          <h2 id="reactor-title">One control surface. Three system modes.</h2>
          <p>
            The mode switcher is a native radio group. CSS reads the selected
            state and changes the entire reactor without JavaScript.
          </p>
        </div>

        <fieldset class="reactor" aria-describedby="reactor-help">
          <legend>AlienX reactor mode</legend>
          <p id="reactor-help" class="sr-only">
            Choose a mode to change the visual reactor state and system readout.
          </p>

          <div class="mode-switcher">
            <input type="radio" name="reactor-mode" id="mode-web" checked />
            <label for="mode-web">Web</label>

            <input type="radio" name="reactor-mode" id="mode-auto" />
            <label for="mode-auto">Automation</label>

            <input type="radio" name="reactor-mode" id="mode-infra" />
            <label for="mode-infra">Infrastructure</label>
          </div>

          <div class="reactor-stage" aria-live="polite">
            <div class="reactor-visual" aria-hidden="true">
              <div class="orbit orbit--outer"></div>
              <div class="orbit orbit--middle"></div>
              <div class="orbit orbit--inner"></div>
              <div class="reactor-core">X</div>
            </div>

            <div class="readout">
              <p class="readout__status">
                <span></span> SYSTEM ONLINE
              </p>
              <div class="mode-copy mode-copy--web">
                <span class="mode-kicker">MODE // WEB</span>
                <strong>Interfaces become systems.</strong>
                <p>
                  Semantic structure, responsive components, accessibility,
                  performance, and browser-native interaction.
                </p>
              </div>
              <div class="mode-copy mode-copy--auto">
                <span class="mode-kicker">MODE // AUTOMATION</span>
                <strong>Events become outcomes.</strong>
                <p>
                  APIs, workflows, state machines, notifications, and connected
                  services operating as one system.
                </p>
              </div>
              <div class="mode-copy mode-copy--infra">
                <span class="mode-kicker">MODE // INFRASTRUCTURE</span>
                <strong>Software gets somewhere to live.</strong>
                <p>
                  Deployment, networking, observability, self-hosting, and the
                  machinery underneath the interface.
                </p>
              </div>
            </div>
          </div>
        </fieldset>
      </section>

      <section class="native-section" aria-labelledby="native-title">
        <div class="section-copy">
          <p class="eyebrow">02 // NATIVE FIRST</p>
          <h2 id="native-title">Controls that already know how to behave.</h2>
          <p>
            Native elements bring keyboard behavior, semantics, and mobile
            interaction before custom styling is added.
          </p>
        </div>

        <div class="native-grid">
          <article class="native-card native-card--signal">
            <div class="card-topline">
              <span>INPUT // RANGE</span>
              <span>KEYBOARD READY</span>
            </div>
            <label for="signal-range">Signal intensity</label>
            <input
              id="signal-range"
              type="range"
              min="0"
              max="100"
              value="72"
            />
            <div class="range-scale" aria-hidden="true">
              <span>0</span>
              <span>50</span>
              <span>100</span>
            </div>
            <p>
              The browser owns the interaction model. AlienX only owns the
              presentation.
            </p>
          </article>

          <article class="native-card native-card--disclosure">
            <div class="card-topline">
              <span>ELEMENT // DETAILS</span>
              <span>NO SCRIPT</span>
            </div>
            <details>
              <summary>Why native disclosure?</summary>
              <p>
                Keyboard operation, focus behavior, open state, and semantics
                already exist. Styling can stay small and durable.
              </p>
            </details>
            <details>
              <summary>What still needs design?</summary>
              <p>
                Visual hierarchy, readable motion, spacing, contrast, and clear
                affordances. Native does not mean unfinished.
              </p>
            </details>
            <details>
              <summary>When would AlienX go custom?</summary>
              <p>
                Only when native behavior cannot express the interaction without
                compromising the product.
              </p>
            </details>
          </article>
        </div>
      </section>

      <section class="container-section" aria-labelledby="container-title">
        <div class="section-copy">
          <p class="eyebrow">03 // CONTAINER LOGIC</p>
          <h2 id="container-title">
            Components respond to space, not devices.
          </h2>
          <p>
            These cards use container queries. Their internal composition reacts
            to the width they actually receive instead of assuming a phone,
            tablet, or desktop breakpoint.
          </p>
        </div>

        <div class="module-grid">
          <article class="module module--wide">
            <div class="module__inner">
              <span class="module__index">A</span>
              <div>
                <h3>Context-aware layout</h3>
                <p>
                  A reusable component should care about its own available
                  space—not the global viewport width.
                </p>
              </div>
              <span class="module__signal" aria-hidden="true"></span>
            </div>
          </article>

          <article class="module">
            <div class="module__inner">
              <span class="module__index">B</span>
              <div>
                <h3>Intrinsic first</h3>
                <p>
                  Grid, flexbox, minmax(), clamp(), and intrinsic sizing reduce
                  brittle breakpoint logic.
                </p>
              </div>
              <span class="module__signal" aria-hidden="true"></span>
            </div>
          </article>

          <article class="module">
            <div class="module__inner">
              <span class="module__index">C</span>
              <div>
                <h3>Portable by default</h3>
                <p>
                  The same component can live in a full-width page, sidebar, or
                  dashboard without special-case CSS.
                </p>
              </div>
              <span class="module__signal" aria-hidden="true"></span>
            </div>
          </article>
        </div>
      </section>

      <section class="comparison-section" aria-labelledby="comparison-title">
        <div class="section-copy">
          <p class="eyebrow">04 // COMPARISON FIELD</p>
          <h2 id="comparison-title">
            A before/after slider without a custom drag widget.
          </h2>
          <p>
            A native range input owns keyboard, touch, and pointer behavior. A
            few lines of progressive JavaScript only synchronize the visual
            split with the control value.
          </p>
        </div>

        <figure class="comparison-lab">
          <div
            class="comparison-stage"
            id="comparison-stage"
            style="--split: 50%"
          >
            <div class="comparison-layer comparison-layer--baseline">
              <span>BASELINE</span>
              <strong>Static brochure</strong>
              <p>Content exists, but the interface mostly waits to be read.</p>
            </div>
            <div class="comparison-layer comparison-layer--enhanced">
              <span>ALIENX</span>
              <strong>Responsive system</strong>
              <p>Semantics, interaction, state, and layout work together.</p>
            </div>
            <div class="comparison-divider" aria-hidden="true"></div>
          </div>
          <figcaption>
            <label for="comparison-range">Reveal enhanced system</label>
            <div class="comparison-control">
              <input
                id="comparison-range"
                type="range"
                min="0"
                max="100"
                value="50"
                aria-describedby="comparison-output"
              />
              <output id="comparison-output" for="comparison-range">
                50%
              </output>
            </div>
          </figcaption>
        </figure>
      </section>

      <LabAdvanced />

      <section class="manifesto" aria-labelledby="manifesto-title">
        <p class="eyebrow">06 // RULE</p>
        <h2 id="manifesto-title">
          Use complexity only where it earns its keep.
        </h2>
        <p>
          AlienX can still be strange, kinetic, technical, and memorable. The
          trick is making the browser do as much of the work as possible, then
          spending custom code only on the parts that are genuinely custom.
        </p>
        <a class="lab-link" href="/experience">
          Continue into the Experience <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<script>
  let comparisonCleanup: (() => void) | undefined;

  function initializeComparison() {
    comparisonCleanup?.();
    const range = document.querySelector<HTMLInputElement>('#comparison-range');
    const stage = document.querySelector<HTMLElement>('#comparison-stage');
    const output =
      document.querySelector<HTMLOutputElement>('#comparison-output');
    if (!range || !stage || !output) return;

    const lifecycle = new AbortController();
    const update = () => {
      const value = `${range.value}%`;
      stage.style.setProperty('--split', value);
      output.value = value;
    };

    range.addEventListener('input', update, { signal: lifecycle.signal });
    update();
    comparisonCleanup = () => lifecycle.abort();
  }

  document.addEventListener('astro:page-load', initializeComparison);
  initializeComparison();
</script>

<style>
  :global(body) {
    --lab-accent: #39ff5a;
    --lab-accent-rgb: 57 255 90;
    background:
      radial-gradient(
        circle at 50% -20%,
        rgb(57 255 90 / 0.09),
        transparent 32rem
      ),
      #05070c;
    color: #eef2ff;
  }

  main {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    padding-bottom: 6rem;
  }

  .lab-hero {
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid #171d2a;
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: #9aa7bb;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  h1,
  h2,
  h3 {
    color: #f6f8ff;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    font-size: clamp(3.8rem, 9vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  h2 {
    max-width: 850px;
    margin: 0 0 1rem;
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .lede,
  .section-copy > p:last-child,
  .manifesto > p:not(.eyebrow) {
    max-width: 760px;
    color: #a6b0c2;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .lede {
    margin-top: 2rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .hero-meta span {
    padding: 0.55rem 0.75rem;
    border: 1px solid #263047;
    border-radius: 999px;
    background: #0b1019;
    color: #bdc7d8;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .reactor-section,
  .native-section,
  .container-section,
  .manifesto {
    padding: clamp(5rem, 10vw, 8rem) 0;
    border-bottom: 1px solid #171d2a;
  }

  .section-copy {
    margin-bottom: 3rem;
  }

  .reactor {
    --reactor-accent: #39ff5a;
    --reactor-rgb: 57 255 90;
    margin: 0;
    padding: 1rem;
    border: 1px solid #20283a;
    border-radius: 28px;
    background: #080c13;
  }

  .reactor > legend {
    padding: 0 0.5rem;
    color: #8f9bb0;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .reactor:has(#mode-auto:checked) {
    --reactor-accent: #65d7ff;
    --reactor-rgb: 101 215 255;
  }

  .reactor:has(#mode-infra:checked) {
    --reactor-accent: #c19cff;
    --reactor-rgb: 193 156 255;
  }

  .mode-switcher {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    padding: 0.4rem;
    border: 1px solid #1b2333;
    border-radius: 16px;
    background: #060910;
  }

  .mode-switcher input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .mode-switcher label {
    display: grid;
    min-height: 48px;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #8f9ab0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .mode-switcher input:focus-visible + label {
    outline: 2px solid var(--reactor-accent);
    outline-offset: 2px;
  }

  .mode-switcher input:checked + label {
    border-color: rgb(var(--reactor-rgb) / 0.4);
    background: rgb(var(--reactor-rgb) / 0.1);
    color: #f7faff;
    box-shadow: inset 0 0 0 1px rgb(var(--reactor-rgb) / 0.08);
  }

  .reactor-stage {
    display: grid;
    grid-template-columns: minmax(280px, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    min-height: 500px;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 0 0 22px 22px;
    background:
      radial-gradient(
        circle at 20% 50%,
        rgb(var(--reactor-rgb) / 0.14),
        transparent 30rem
      ),
      linear-gradient(145deg, #0a0f18, #070a10);
  }

  .reactor-visual {
    position: relative;
    aspect-ratio: 1;
    width: min(360px, 100%);
    margin: auto;
    display: grid;
    place-items: center;
  }

  .orbit,
  .reactor-core {
    position: absolute;
    border-radius: 50%;
  }

  .orbit {
    border: 1px solid rgb(var(--reactor-rgb) / 0.35);
  }

  .orbit--outer {
    inset: 0;
    border-top-color: var(--reactor-accent);
    animation: lab-spin 18s linear infinite;
  }

  .orbit--middle {
    inset: 12%;
    border-right-color: var(--reactor-accent);
    animation: lab-spin-reverse 12s linear infinite;
  }

  .orbit--inner {
    inset: 28%;
    border-bottom-color: var(--reactor-accent);
    animation: lab-spin 8s linear infinite;
  }

  .reactor-core {
    width: 28%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgb(var(--reactor-rgb) / 0.65);
    background: radial-gradient(
      circle,
      rgb(var(--reactor-rgb) / 0.24),
      #080b12 70%
    );
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    box-shadow:
      0 0 80px rgb(var(--reactor-rgb) / 0.22),
      inset 0 0 30px rgb(var(--reactor-rgb) / 0.1);
  }

  .readout {
    min-width: 0;
  }

  .readout__status {
    margin: 0 0 2rem;
    color: #9ca8bb;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
  }

  .readout__status span {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--reactor-accent);
    box-shadow: 0 0 16px var(--reactor-accent);
  }

  .mode-copy {
    display: none;
  }

  .reactor:has(#mode-web:checked) .mode-copy--web,
  .reactor:has(#mode-auto:checked) .mode-copy--auto,
  .reactor:has(#mode-infra:checked) .mode-copy--infra {
    display: block;
    animation: readout-enter 260ms ease both;
  }

  .mode-kicker {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--reactor-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .mode-copy strong {
    display: block;
    max-width: 520px;
    color: #f5f8ff;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .mode-copy p {
    max-width: 560px;
    margin-top: 1.25rem;
    color: #a5afc1;
    line-height: 1.7;
  }

  .native-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1rem;
  }

  .native-card {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #1d2536;
    border-radius: 24px;
    background: linear-gradient(145deg, #0c111b, #080b12);
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    color: #7e8ba1;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .native-card--signal label {
    display: block;
    margin-bottom: 1rem;
    color: #f1f4fb;
    font-size: 1.3rem;
    font-weight: 700;
  }

  input[type='range'] {
    width: 100%;
    accent-color: var(--lab-accent);
  }

  .range-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 0.6rem;
    color: #748197;
    font-size: 0.7rem;
  }

  .native-card > p {
    margin: 2rem 0 0;
    color: #9eabba;
    line-height: 1.65;
  }

  details {
    border-top: 1px solid #20283a;
  }

  details:last-child {
    border-bottom: 1px solid #20283a;
  }

  summary {
    position: relative;
    padding: 1.25rem 2.25rem 1.25rem 0;
    color: #eef2ff;
    font-weight: 700;
    cursor: pointer;
  }

  summary::marker {
    color: var(--lab-accent);
  }

  details p {
    margin: 0 0 1.4rem;
    color: #9eabba;
    line-height: 1.65;
  }

  .module-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 1rem;
  }

  .module {
    container-type: inline-size;
    min-width: 0;
  }

  .module--wide {
    grid-row: span 2;
  }

  .module__inner {
    min-height: 230px;
    height: 100%;
    padding: 1.75rem;
    display: grid;
    align-items: start;
    gap: 1rem;
    border: 1px solid #1d2536;
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgb(57 255 90 / 0.04), transparent 45%), #090d15;
  }

  .module__index {
    color: var(--lab-accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .module h3 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.35rem, 5cqi, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .module p {
    margin: 0;
    color: #98a5b8;
    line-height: 1.65;
  }

  .module__signal {
    width: 100%;
    height: 2px;
    align-self: end;
    background: linear-gradient(90deg, var(--lab-accent), transparent);
    opacity: 0.5;
  }

  @container (min-width: 520px) {
    .module__inner {
      grid-template-columns: auto 1fr;
      grid-template-rows: 1fr auto;
      column-gap: 2rem;
      padding: 2.5rem;
    }

    .module__signal {
      grid-column: 1 / -1;
    }
  }

  .manifesto {
    max-width: 980px;
    border-bottom: 0;
  }

  .lab-link {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: #f3f7ff;
    font-weight: 700;
    text-decoration: none;
  }

  .lab-link:hover,
  .lab-link:focus-visible {
    color: var(--lab-accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes lab-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes lab-spin-reverse {
    to {
      transform: rotate(-360deg);
    }
  }

  @keyframes readout-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 800px) {
    main {
      width: min(100% - 28px, 680px);
    }

    .reactor-stage,
    .native-grid,
    .module-grid {
      grid-template-columns: 1fr;
    }

    .module--wide {
      grid-row: auto;
    }

    .reactor-stage {
      min-height: 0;
      padding-inline: 1.25rem;
    }

    .reactor-visual {
      width: min(300px, 80vw);
    }
  }

  @media (max-width: 520px) {
    .mode-switcher {
      grid-template-columns: 1fr;
    }

    .card-topline {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .mode-copy {
      animation: none !important;
    }

    .mode-switcher label {
      transition: none;
    }
  }

  @media (prefers-color-scheme: light) {
    :global(html:where(:not([data-alienx-theme]))) :global(body) {
      background: #f8fafc;
      color: #18202c;
    }

    :global(html:where(:not([data-alienx-theme]))) h1,
    :global(html:where(:not([data-alienx-theme]))) h2,
    :global(html:where(:not([data-alienx-theme]))) h3,
    :global(html:where(:not([data-alienx-theme]))) .mode-copy strong,
    :global(html:where(:not([data-alienx-theme]))) summary {
      color: #101722;
    }

    :global(html:where(:not([data-alienx-theme]))) .lede,
    :global(html:where(:not([data-alienx-theme]))) .section-copy > p:last-child,
    :global(html:where(:not([data-alienx-theme]))) .manifesto > p:not(.eyebrow),
    :global(html:where(:not([data-alienx-theme]))) .mode-copy p,
    :global(html:where(:not([data-alienx-theme]))) .native-card > p,
