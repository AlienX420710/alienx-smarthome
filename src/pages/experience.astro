---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Experience — ${SITE_TITLE}`} description="Explore the AlienX SmartHome interactive web experience: responsive motion, ambient lighting, browser-native interaction, and progressive enhancement." />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title"><p class="eyebrow">ALIENX / EXPERIENCE</p><h1 id="title">Don't look at it.<br /><span>Interact with it.</span></h1><p class="lede">This is a playground for interface ideas. No account. No connected services. No control system behind the curtain. Just the browser doing interesting things.</p></section>
			<section class="scene" aria-labelledby="scene-title"><div class="scene__header"><div><p class="eyebrow">01 / AMBIENT ENGINE</p><h2 id="scene-title">Change the atmosphere.</h2></div><div class="controls" role="group" aria-label="Atmosphere controls"><button type="button" data-mood="night" aria-pressed="false">Night</button><button type="button" data-mood="dawn" aria-pressed="false">Dawn</button><button type="button" data-mood="day" aria-pressed="true">Day</button><button type="button" data-mood="aurora" aria-pressed="false">Aurora</button></div></div><div class="room" data-scene="day"><div class="sun" aria-hidden="true"></div><div class="window" aria-hidden="true"><span></span></div><div class="floor" aria-hidden="true"></div><div class="room-copy"><span>ENVIRONMENT</span><strong data-reading>72°</strong><small data-caption>Clear / quiet / 14:32</small></div></div></section>
			<section class="experiments" aria-labelledby="experiments-title"><div class="section-heading"><p class="eyebrow">02 / MICROINTERACTIONS</p><h2 id="experiments-title">Small details matter.</h2></div><div class="experiment-grid"><button class="experiment" type="button" data-pulse><span class="experiment-icon" aria-hidden="true"></span><strong>Press me</strong><small>Haptic-style visual feedback</small></button><button class="experiment" type="button" data-reveal><span class="experiment-icon experiment-icon--scan" aria-hidden="true"></span><strong>Scan the field</strong><small>Progressive visual state</small></button><div class="experiment experiment--static"><span class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i></span><strong>Browser-native</strong><small>Semantic HTML + CSS + minimal JS</small></div></div></section>
			<section class="closing" aria-labelledby="closing-title"><p class="eyebrow">03 / THE POINT</p><h2 id="closing-title">The interface is the experiment.</h2><p>AlienX isn't trying to simulate a particular smart-home platform. It's an excuse to push the web platform: composition, motion, responsiveness, accessibility, performance, and ideas that feel better when you can touch them.</p></section>
		</main><Footer />
	</body>
</html>

<style>
	:global(body){--experience-background:#05070c;--experience-surface:#090d16;--experience-surface-hover:#0c111d;--experience-text:#eef2ff;--experience-heading:#f6f8ff;--experience-muted:#a5afc3;--experience-soft:#8f9ab2;--experience-border:#151b29;--experience-border-strong:#252d42;background:var(--experience-background);color:var(--experience-text)}
	main{width:min(1120px,calc(100% - 40px));max-width:none;padding:5rem 0 7rem}.eyebrow{margin:0 0 1rem;color:var(--experience-soft);font-size:.7rem;font-weight:700;letter-spacing:.22em}.intro{padding:2rem 0 7rem}h1,h2{color:var(--experience-heading);letter-spacing:-.055em;line-height:.95}h1{font-size:clamp(3.5rem,8vw,7.5rem);max-width:900px}h1 span{color:#39ff5a}.lede{max-width:650px;margin-top:2rem;color:var(--experience-muted);font-size:1.15rem;line-height:1.65}.scene,.experiments{padding:5rem 0;border-top:1px solid var(--experience-border)}.scene__header{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}h2{margin:0;font-size:clamp(2.4rem,5vw,4.5rem)}.controls{display:flex;flex-wrap:wrap;justify-content:end;gap:.5rem}.controls button{border:1px solid var(--experience-border-strong);border-radius:999px;padding:.65rem .9rem;color:var(--experience-muted);background:var(--experience-surface);cursor:pointer}.controls button[aria-pressed="true"]{color:#041006;background:#39ff5a;border-color:#39ff5a}.room{position:relative;overflow:hidden;min-height:560px;border:1px solid var(--experience-border-strong);border-radius:32px;background:#b7c5df;isolation:isolate;transition:background 700ms ease}.room::after{content:"";position:absolute;inset:0;z-index:4;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(3,6,13,.22))}.room[data-scene="night"]{background:#101729}.room[data-scene="dawn"]{background:#c49a93}.room[data-scene="aurora"]{background:#536d78}.sun{position:absolute;width:180px;height:180px;top:14%;right:12%;border-radius:50%;background:#fff2c5;box-shadow:0 0 100px 35px rgba(255,231,155,.38);transition:all 700ms ease}.room[data-scene="night"] .sun{opacity:.08;transform:scale(.65);background:#d9e2ff;box-shadow:0 0 80px 20px rgba(118,144,255,.2)}.room[data-scene="dawn"] .sun{transform:translate(-30px,90px) scale(.82);background:#ffd4ad}.room[data-scene="aurora"] .sun{opacity:.2;background:#c5ffce;box-shadow:0 0 120px 50px rgba(57,255,90,.25)}.window{position:absolute;inset:12% 11% 22% 11%;border:18px solid rgba(20,27,43,.88);border-bottom-width:28px;background:linear-gradient(135deg,rgba(214,234,255,.3),rgba(72,90,125,.1));box-shadow:0 30px 70px rgba(0,0,0,.18)}.window::before,.window::after{content:"";position:absolute;background:rgba(20,27,43,.6)}.window::before{width:10px;inset:0 50%;transform:translateX(-50%)}.window::after{height:10px;inset:50% 0;transform:translateY(-50%)}.window span{position:absolute;inset:0;background:radial-gradient(circle at 70% 30%,rgba(255,255,255,.35),transparent 25%)}.floor{position:absolute;inset:78% -5% -20%;transform:perspective(400px) rotateX(48deg);background:repeating-linear-gradient(90deg,rgba(10,15,25,.18) 0 2px,transparent 2px 90px)}.room-copy{position:absolute;z-index:5;left:2rem;bottom:2rem;display:flex;flex-direction:column}.room-copy span{font-size:.65rem;letter-spacing:.18em;color:#d6dced}.room-copy strong{margin-top:.5rem;font-size:clamp(3rem,7vw,6rem);line-height:.8;letter-spacing:-.07em}.room-copy small{margin-top:1rem;color:#d6dced}.section-heading{max-width:650px}.experiment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.experiment{min-height:260px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;padding:1.5rem;text-align:left;border:1px solid var(--experience-border);border-radius:24px;background:var(--experience-surface);color:var(--experience-text);cursor:pointer;transition:transform 180ms ease,border-color 180ms ease,background 180ms ease}.experiment:hover{transform:translateY(-4px);border-color:var(--experience-border-strong);background:var(--experience-surface-hover)}.experiment strong{margin-top:auto;font-size:1.15rem}.experiment small{margin-top:.35rem;color:var(--experience-soft)}.experiment-icon{width:70px;height:70px;margin-bottom:2rem;border-radius:50%;background:radial-gradient(circle,#f0fff2 0 5%,#39ff5a 6% 20%,rgba(57,255,90,.12) 21% 60%,transparent 61%);box-shadow:0 0 40px rgba(57,255,90,.3)}.experiment.is-active .experiment-icon{animation:pulse 650ms ease}.experiment-icon--scan{border-radius:14px;background:linear-gradient(90deg,transparent 48%,#39ff5a 49% 51%,transparent 52%),linear-gradient(transparent 48%,#39ff5a 49% 51%,transparent 52%);opacity:.75}.experiment.is-active .experiment-icon--scan{animation:scan 900ms ease}.signal{display:flex;align-items:end;gap:7px;height:70px;margin-bottom:2rem}.signal i{display:block;width:10px;height:20%;border-radius:99px;background:#39ff5a;animation:bars 1.4s ease-in-out infinite alternate}.signal i:nth-child(2){height:50%;animation-delay:.15s}.signal i:nth-child(3){height:80%;animation-delay:.3s}.signal i:nth-child(4){height:35%;animation-delay:.45s}.closing{padding:8rem 0 2rem;max-width:850px}.closing p:last-child{max-width:700px;color:var(--experience-muted);font-size:1.1rem;line-height:1.7}@keyframes pulse{50%{transform:scale(1.25);filter:brightness(1.4)}}@keyframes scan{50%{transform:rotate(180deg)}}@keyframes bars{to{transform:scaleY(.45);opacity:.55}}
	@media(prefers-color-scheme:light){:global(body){--experience-background:#fff;--experience-surface:#f5f7fb;--experience-surface-hover:#eef2f8;--experience-text:#1d2433;--experience-heading:#0f1219;--experience-muted:#60739f;--experience-soft:#687797;--experience-border:#e1e6ef;--experience-border-strong:#c8d0df}.room{border-color:#c8d0df}.room::after{background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(34,44,63,.12))}}
	@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
	@media(max-width:800px){main{width:min(100% - 28px,680px)}.scene__header{align-items:flex-start;flex-direction:column}.controls{justify-content:start}.experiment-grid{grid-template-columns:1fr}.room{min-height:430px}.window{inset:14% 7% 28% 7%;border-width:12px}.floor{inset:74% -15% -20%}.intro{padding-bottom:4rem}}
</style>

<script>
	const room=document.querySelector('.room');const reading=document.querySelector('[data-reading]');const caption=document.querySelector('[data-caption]');const buttons=document.querySelectorAll('[data-mood]');const readings={night:['64°','Night / still / 23:48'],dawn:['67°','Dawn / warming / 06:18'],day:['72°','Clear / quiet / 14:32'],aurora:['69°','Aurora / charged / 21:07']};buttons.forEach((button)=>{button.addEventListener('click',()=>{const mood=button.dataset.mood;room?.setAttribute('data-scene',mood||'day');buttons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));if(mood&&readings[mood]){reading.textContent=readings[mood][0];caption.textContent=readings[mood][1]}})});document.querySelectorAll('[data-pulse],[data-reveal]').forEach((button)=>{button.addEventListener('click',()=>{button.classList.remove('is-active');void button.offsetWidth;button.classList.add('is-active')})});
</script>
