---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Experience — ${SITE_TITLE}`} description="Explore the AlienX interactive web experience: browser-native interaction, responsive motion, ambient state, and progressive enhancement." />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="title">
				<p class="eyebrow">ALIENX / EXPERIENCE</p>
				<h1 id="title">Technology you can <span>touch.</span></h1>
				<p class="lede">The browser isn't just where AlienX runs. It's part of the machine. This page is where the engineering becomes something you can see, manipulate, and feel.</p>
			</section>

			<section class="signal" aria-label="Interactive system preview">
				<div class="signal__label"><span>LIVE SYSTEM</span><span data-system-status>READY</span></div>
				<div class="signal__track" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
				<div class="signal__footer"><span>INPUT</span><span>STATE</span><span>RENDER</span><span>EXPERIENCE</span></div>
			</section>

			<section class="bridge" aria-labelledby="bridge-title">
				<p class="eyebrow">01 / FROM TECHNOLOGY TO EXPERIENCE</p>
				<h2 id="bridge-title">What the technology page explains, this page lets you operate.</h2>
				<div class="flow" aria-label="Interaction flow">
					<div><span>01</span><strong>Input</strong><small>You do something.</small></div>
					<div><span>02</span><strong>Event</strong><small>The browser notices.</small></div>
					<div><span>03</span><strong>State</strong><small>The interface changes.</small></div>
					<div><span>04</span><strong>Render</strong><small>You see the result.</small></div>
				</div>
			</section>

			<section class="experiment" aria-labelledby="experiment-title">
				<div class="experiment__copy">
					<p class="eyebrow">02 / INTERACTIVE SYSTEM</p>
					<h2 id="experiment-title">Change the state.</h2>
					<p>Nothing here needs an account, an API call, or a control platform. Change the state and watch the interface respond locally.</p>
					<div class="state-readout"><span>SYSTEM STATE</span><strong data-state-label>CALM</strong></div>
				</div>
				<div class="state-panel" data-state-panel>
					<div class="orb" data-orb aria-hidden="true"></div>
					<div class="state-value" data-state-value>72%</div>
					<div class="state-controls" aria-label="System state controls">
						<button type="button" data-state="calm" aria-pressed="true">Calm</button>
						<button type="button" data-state="focus" aria-pressed="false">Focus</button>
						<button type="button" data-state="pulse" aria-pressed="false">Pulse</button>
					</div>
				</div>
			</section>

			<section class="micro" aria-labelledby="micro-title">
				<div class="section-heading"><p class="eyebrow">03 / FEEDBACK</p><h2 id="micro-title">Every action should have a response.</h2></div>
				<div class="micro-grid">
					<button class="micro-card" type="button" data-pulse><span class="micro-icon"></span><strong>Press it</strong><small>Immediate visual feedback.</small></button>
					<button class="micro-card" type="button" data-reveal><span class="micro-icon micro-icon--scan"></span><strong>Scan it</strong><small>Progressive visual state.</small></button>
					<div class="micro-card micro-card--static"><span class="micro-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><strong>Observe it</strong><small>Motion generated by the browser.</small></div>
				</div>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<p class="eyebrow">04 / THE POINT</p>
				<h2 id="closing-title">The technology is invisible until it becomes an experience.</h2>
				<p>AlienX uses the web platform as both the foundation and the medium. The interesting part isn't the stack by itself. It's what happens when good engineering gives an interface room to respond.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body){--experience-background:#05070c;--experience-surface:#090d16;--experience-surface-hover:#0d1320;--experience-text:#eef2ff;--experience-heading:#f6f8ff;--experience-muted:#a5afc3;--experience-soft:#8f9ab2;--experience-border:#151b29;--experience-border-strong:#252d42;--experience-accent:var(--brand-green);background:var(--experience-background);color:var(--experience-text)}
	main{width:min(1120px,calc(100% - 40px));max-width:none;padding:5rem 0 7rem}.eyebrow{margin:0 0 1rem;color:var(--experience-soft);font-size:.7rem;font-weight:700;letter-spacing:.22em}.intro{padding:3rem 0 5rem}.intro h1,.bridge h2,.experiment h2,.micro h2,.closing h2{color:var(--experience-heading);letter-spacing:-.055em;line-height:.95}.intro h1{max-width:900px;font-size:clamp(3.8rem,9vw,8rem)}.intro h1 span{color:var(--experience-accent)}.lede{max-width:680px;margin-top:2rem;color:var(--experience-muted);font-size:1.15rem;line-height:1.65}
	.signal{padding:2rem 0 4rem;border-top:1px solid var(--experience-border);border-bottom:1px solid var(--experience-border)}.signal__label,.signal__footer{display:flex;justify-content:space-between;color:var(--experience-soft);font-size:.65rem;font-weight:800;letter-spacing:.16em}.signal__label span:last-child{color:var(--experience-accent)}.signal__track{display:flex;align-items:center;gap:10px;height:110px}.signal__track i{display:block;flex:1;height:1px;background:var(--experience-border-strong);position:relative}.signal__track i::after{content:"";position:absolute;left:0;top:50%;width:18%;height:3px;transform:translateY(-50%);background:var(--experience-accent);box-shadow:0 0 16px rgba(57,255,90,.3);animation:signal 2.4s ease-in-out infinite}.signal__track i:nth-child(2)::after{animation-delay:.18s}.signal__track i:nth-child(3)::after{animation-delay:.36s}.signal__track i:nth-child(4)::after{animation-delay:.54s}.signal__track i:nth-child(5)::after{animation-delay:.72s}.signal__track i:nth-child(6)::after{animation-delay:.9s}.signal__track i:nth-child(7)::after{animation-delay:1.08s}
	.bridge{padding:9rem 0}.bridge h2{max-width:850px;font-size:clamp(2.6rem,6vw,5.2rem)}.flow{display:grid;grid-template-columns:repeat(4,1fr);margin-top:4rem;border-top:1px solid var(--experience-border);border-bottom:1px solid var(--experience-border)}.flow div{min-height:190px;padding:1.5rem;border-right:1px solid var(--experience-border);display:flex;flex-direction:column}.flow div:last-child{border-right:0}.flow span{color:var(--experience-soft);font-size:.65rem;font-weight:800}.flow strong{margin-top:auto;font-size:1.2rem;color:var(--experience-heading)}.flow small{margin-top:.4rem;color:var(--experience-muted)}
	.experiment{display:grid;grid-template-columns:.9fr 1.1fr;gap:5rem;align-items:center;padding:8rem 0;border-top:1px solid var(--experience-border)}.experiment h2{font-size:clamp(2.6rem,6vw,5rem)}.experiment__copy>p:not(.eyebrow){max-width:560px;color:var(--experience-muted);line-height:1.7}.state-readout{display:flex;gap:1rem;align-items:center;margin-top:3rem;color:var(--experience-soft);font-size:.65rem;font-weight:800;letter-spacing:.14em}.state-readout strong{color:var(--experience-accent)}.state-panel{position:relative;min-height:470px;display:flex;flex-direction:column;justify-content:center;align-items:center;overflow:hidden;border:1px solid rgba(57,255,90,.25);border-radius:32px;background:radial-gradient(circle at 50% 40%,rgba(57,255,90,.09),transparent 45%),var(--experience-surface);box-shadow:0 30px 100px rgba(0,0,0,.35)}.orb{width:230px;height:230px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f0fff2 0 2%,rgba(200,255,207,.6) 4%,rgba(57,255,90,.34) 23%,rgba(30,170,61,.13) 48%,transparent 70%);transition:transform 500ms ease,filter 500ms ease}.state-value{margin-top:2rem;color:var(--experience-heading);font-size:2.6rem;font-weight:800;letter-spacing:-.05em}.state-controls{display:flex;gap:8px;margin-top:1.5rem}.state-controls button{cursor:pointer;border:1px solid var(--experience-border-strong);border-radius:999px;padding:.65rem .9rem;background:#0c111b;color:var(--experience-soft);font:inherit;font-size:.72rem;font-weight:800}.state-controls button:hover,.state-controls button:focus-visible{color:var(--experience-heading);border-color:#4f7659;outline:none}.state-controls button[aria-pressed="true"]{color:#041006;background:var(--experience-accent);border-color:var(--experience-accent)}.is-focus .orb{transform:scale(.8);filter:saturate(.72)}.is-pulse .orb{transform:scale(1.2);filter:saturate(1.4)}
	.micro{padding:8rem 0}.micro h2{font-size:clamp(2.6rem,6vw,5rem)}.micro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:4rem}.micro-card{min-height:270px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;padding:1.5rem;text-align:left;border:1px solid var(--experience-border);border-radius:24px;background:var(--experience-surface);color:var(--experience-text);cursor:pointer;transition:transform 180ms ease,border-color 180ms ease,background 180ms ease}.micro-card:hover{transform:translateY(-4px);border-color:var(--experience-border-strong);background:var(--experience-surface-hover)}.micro-card strong{margin-top:auto;font-size:1.15rem}.micro-card small{margin-top:.35rem;color:var(--experience-soft)}.micro-icon{width:70px;height:70px;margin-bottom:2rem;border-radius:50%;background:radial-gradient(circle,#f0fff2 0 5%,var(--experience-accent) 6% 20%,rgba(57,255,90,.12) 21% 60%,transparent 61%);box-shadow:0 0 40px rgba(57,255,90,.25)}.micro-icon--scan{border-radius:14px;background:linear-gradient(90deg,transparent 48%,var(--experience-accent) 49% 51%,transparent 52%),linear-gradient(transparent 48%,var(--experience-accent) 49% 51%,transparent 52%);opacity:.75}.micro-card.is-active .micro-icon{animation:pulse 650ms ease}.micro-card.is-active .micro-icon--scan{animation:scan 900ms ease}.micro-bars{display:flex;align-items:end;gap:7px;height:70px;margin-bottom:2rem}.micro-bars i{width:10px;height:20%;border-radius:99px;background:var(--experience-accent);animation:bars 1.4s ease-in-out infinite alternate}.micro-bars i:nth-child(2){height:50%;animation-delay:.15s}.micro-bars i:nth-child(3){height:80%;animation-delay:.3s}.micro-bars i:nth-child(4){height:35%;animation-delay:.45s}
	.closing{padding:9rem 0 2rem;border-top:1px solid var(--experience-border)}.closing h2{max-width:900px;font-size:clamp(2.8rem,7vw,6rem)}.closing p:last-child{max-width:700px;margin-top:2rem;color:var(--experience-muted);font-size:1.1rem;line-height:1.7}@keyframes signal{0%,100%{left:0;opacity:.35}50%{left:82%;opacity:1}}@keyframes pulse{50%{transform:scale(1.25);filter:brightness(1.4)}}@keyframes scan{50%{transform:rotate(180deg)}}@keyframes bars{to{transform:scaleY(.45);opacity:.55}}
	@media(prefers-color-scheme:light){:global(body){--experience-background:#fff;--experience-surface:#f5f7fb;--experience-surface-hover:#eef2f8;--experience-text:#1d2433;--experience-heading:#0f1219;--experience-muted:#60739f;--experience-soft:#687797;--experience-border:#e1e6ef;--experience-border-strong:#c8d0df;--experience-accent:var(--brand-green-dark)}.state-panel{background:radial-gradient(circle at 50% 40%,rgba(22,163,74,.08),transparent 45%),var(--experience-surface);box-shadow:0 30px 100px rgba(53,94,63,.14)}.state-controls button{background:#f4f6fa;color:#52617d}.state-controls button:hover,.state-controls button:focus-visible{border-color:#8996ad}.state-controls button[aria-pressed="true"]{color:#fff}.signal__track i::after{box-shadow:0 0 16px rgba(22,163,74,.2)}}
	@media(max-width:800px){main{width:min(100% - 28px,680px)}.intro{padding-top:2rem}.flow,.micro-grid,.experiment{grid-template-columns:1fr}.flow div{border-right:0;border-bottom:1px solid var(--experience-border);min-height:140px}.flow div:last-child{border-bottom:0}.experiment{gap:3rem;padding:6rem 0}.state-panel{min-height:390px}.orb{width:185px;height:185px}.micro{padding:6rem 0}.signal__track{height:80px}.signal__footer span:nth-child(2),.signal__footer span:nth-child(3){display:none}}
	@media(prefers-reduced-motion:reduce){.orb{transition:none}.signal__track i::after,.micro-icon,.micro-bars i{animation:none!important}.micro-card{transition:none}}
</style>

<script>
	const panel=document.querySelector('[data-state-panel]');const orb=document.querySelector('[data-orb]');const label=document.querySelector('[data-state-label]');const value=document.querySelector('[data-state-value]');const status=document.querySelector('[data-system-status]');const buttons=document.querySelectorAll('[data-state]');const states={calm:{label:'CALM',value:'72%',status:'READY',className:'is-calm'},focus:{label:'FOCUS',value:'86%',status:'FOCUSED',className:'is-focus'},pulse:{label:'PULSE',value:'94%',status:'ACTIVE',className:'is-pulse'}};buttons.forEach((button)=>{button.addEventListener('click',()=>{const state=states[button.dataset.state];if(!state||!panel||!orb||!label||!value)return;panel.classList.remove('is-calm','is-focus','is-pulse');panel.classList.add(state.className);label.textContent=state.label;value.textContent=state.value;if(status)status.textContent=state.status;buttons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)))})});document.querySelectorAll('[data-pulse],[data-reveal]').forEach((button)=>{button.addEventListener('click',()=>{button.classList.remove('is-active');void button.offsetWidth;button.classList.add('is-active')})});
</script>
