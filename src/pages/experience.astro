---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const title = `Experience | ${SITE_TITLE}`;
const description = 'Enter the AlienX interactive experience: motion, soundless feedback, pointer-reactive visuals, browser-native effects, and playful interface experiments.';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`Experience — ${SITE_TITLE}`} description={description} /></head>
  <body>
    <Header />
    <main>
      <section class="hero" aria-labelledby="experience-title">
        <div class="hero-copy">
          <p class="eyebrow">ALIENX / EXPERIENCE</p>
          <h1 id="experience-title">Don't just <span>look.</span><br />interact.</h1>
          <p class="lede">This is the part of AlienX where engineering stops hiding behind screenshots. Move something. Press something. Change something. See what the browser can do.</p>
          <a class="start-link" href="#playground">Enter the playground <span>↓</span></a>
        </div>
        <div class="hero-stage" data-stage aria-label="Pointer reactive visual experiment">
          <div class="stage-grid"></div><div class="stage-ring stage-ring--one"></div><div class="stage-ring stage-ring--two"></div><div class="stage-core"><span data-core-label>READY</span></div>
          <div class="stage-readout"><span>POINTER</span><strong data-pointer-readout>MOVE TO EXPLORE</strong></div>
        </div>
      </section>

      <section class="playground" id="playground" aria-labelledby="playground-title">
        <div class="section-heading"><p class="eyebrow">01 / PLAYGROUND</p><h2 id="playground-title">The interface <span>responds.</span></h2><p>There is no dashboard to configure here. These experiments are deliberately small: input goes in, the page reacts, and the reaction is visible.</p></div>

        <div class="reactor" data-reactor>
          <div class="reactor-top"><span>POINTER FIELD</span><span data-reactor-state>LISTENING</span></div>
          <div class="reactor-field" data-reactor-field><div class="field-grid"></div><div class="field-glow" data-field-glow></div><div class="field-core" data-field-core><span>MOVE</span></div><div class="field-orbit"></div><div class="field-points"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
          <div class="reactor-bottom"><span data-reactor-x>X 50</span><span data-reactor-y>Y 50</span><span>INPUT → VISUAL</span></div>
        </div>
      </section>

      <section class="kinetic" aria-labelledby="kinetic-title">
        <div class="kinetic-copy"><p class="eyebrow">02 / KINETIC TYPE</p><h2 id="kinetic-title">Words can have <span>weight.</span></h2><p>Hover, focus, or tap the words. The typography itself becomes a control surface.</p></div>
        <div class="word-field" data-word-field>
          <button type="button" data-word="MOVE">MOVE</button><button type="button" data-word="THINK">THINK</button><button type="button" data-word="BUILD">BUILD</button><button type="button" data-word="RESPOND">RESPOND</button>
        </div>
      </section>

      <section class="sequence" aria-labelledby="sequence-title">
        <div class="sequence-head"><p class="eyebrow">03 / SEQUENCE</p><h2 id="sequence-title">One action can become a <span>story.</span></h2><p>Watch a simple interaction move through a sequence of visual states. The values are intentionally qualitative: this is an experience, not a benchmark.</p></div>
        <div class="sequence-demo" data-sequence-demo>
          <div class="sequence-visual"><div class="sequence-scan" data-sequence-scan></div><div class="sequence-orb" data-sequence-orb></div><span data-sequence-word>WAITING</span></div>
          <div class="sequence-controls"><button type="button" data-sequence-run>Run sequence</button><div class="sequence-steps"><span data-step="0" class="is-current">WAIT</span><span data-step="1">LISTEN</span><span data-step="2">REACT</span><span data-step="3">SETTLE</span></div></div>
        </div>
      </section>

      <section class="micro" aria-labelledby="micro-title">
        <div class="section-heading"><p class="eyebrow">04 / MICROINTERACTIONS</p><h2 id="micro-title">Small details create <span>presence.</span></h2><p>Try each one. They are simple, but the feedback is the point.</p></div>
        <div class="micro-grid">
          <button class="micro-card" type="button" data-feedback="pulse"><span class="micro-visual micro-visual--pulse"></span><strong>Press it</strong><small>Feedback happens immediately.</small></button>
          <button class="micro-card" type="button" data-feedback="scan"><span class="micro-visual micro-visual--scan"></span><strong>Scan it</strong><small>A state travels across the surface.</small></button>
          <button class="micro-card" type="button" data-feedback="expand"><span class="micro-visual micro-visual--expand"></span><strong>Open it</strong><small>A compact control becomes an event.</small></button>
        </div>
      </section>

      <section class="browser" aria-labelledby="browser-title">
        <div><p class="eyebrow">05 / BROWSER-NATIVE</p><h2 id="browser-title">No app required.</h2><p>The browser already knows how to listen, animate, measure, focus, scroll, resize, observe, and respond. Good frontend engineering makes those capabilities feel intentional.</p></div>
        <div class="browser-list"><div><span>POINTER</span><strong>Input becomes motion.</strong></div><div><span>CSS</span><strong>Styles become behavior.</strong></div><div><span>DOM</span><strong>State becomes structure.</strong></div><div><span>EVENTS</span><strong>Actions become feedback.</strong></div></div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <p class="eyebrow">06 / THE POINT</p><h2 id="closing-title">Technology is more interesting when you can <span>feel it.</span></h2><p>AlienX builds the systems behind the interface. This page exists to show the other half: what happens when those systems are given room to become an experience.</p>
        <a href="/technology">See how it is built <span>→</span></a>
      </section>
    </main>
    <Footer />
    <script>
      const stage=document.querySelector('[data-stage]');const pointerReadout=document.querySelector('[data-pointer-readout]');const coreLabel=document.querySelector('[data-core-label]');
      stage?.addEventListener('pointermove',(event)=>{const rect=stage.getBoundingClientRect();const x=((event.clientX-rect.left)/rect.width)*100;const y=((event.clientY-rect.top)/rect.height)*100;stage.style.setProperty('--px',`${x}%`);stage.style.setProperty('--py',`${y}%`);if(pointerReadout)pointerReadout.textContent=`X ${Math.round(x)} / Y ${Math.round(y)}`;if(coreLabel)coreLabel.textContent='TRACKING'});
      stage?.addEventListener('pointerleave',()=>{stage.style.setProperty('--px','50%');stage.style.setProperty('--py','50%');if(pointerReadout)pointerReadout.textContent='MOVE TO EXPLORE';if(coreLabel)coreLabel.textContent='READY'});

      const field=document.querySelector('[data-reactor-field]');const fieldGlow=document.querySelector('[data-field-glow]');const fieldCore=document.querySelector('[data-field-core]');const reactorX=document.querySelector('[data-reactor-x]');const reactorY=document.querySelector('[data-reactor-y]');const reactorState=document.querySelector('[data-reactor-state]');
      field?.addEventListener('pointermove',(event)=>{const rect=field.getBoundingClientRect();const x=((event.clientX-rect.left)/rect.width)*100;const y=((event.clientY-rect.top)/rect.height)*100;field.style.setProperty('--rx',`${x}%`);field.style.setProperty('--ry',`${y}%`);if(fieldGlow){fieldGlow.style.left=`${x}%`;fieldGlow.style.top=`${y}%`;}if(fieldCore){fieldCore.style.transform=`translate(-50%,-50%) translate(${(x-50)*.32}px,${(y-50)*.32}px)`;}if(reactorX)reactorX.textContent=`X ${Math.round(x)}`;if(reactorY)reactorY.textContent=`Y ${Math.round(y)}`;if(reactorState)reactorState.textContent='TRACKING'});
      field?.addEventListener('pointerleave',()=>{if(reactorState)reactorState.textContent='LISTENING';if(reactorX)reactorX.textContent='X 50';if(reactorY)reactorY.textContent='Y 50';if(fieldGlow){fieldGlow.style.left='50%';fieldGlow.style.top='50%';}if(fieldCore)fieldCore.style.transform='translate(-50%,-50%)';});

      document.querySelectorAll('[data-word]').forEach((button)=>button.addEventListener('click',()=>{document.querySelectorAll('[data-word]').forEach((item)=>item.classList.remove('is-selected'));button.classList.add('is-selected');}));
      document.querySelectorAll('[data-feedback]').forEach((button)=>button.addEventListener('click',()=>{button.classList.remove('is-active');void button.offsetWidth;button.classList.add('is-active');}));

      const sequenceRun=document.querySelector('[data-sequence-run]');const sequenceWord=document.querySelector('[data-sequence-word]');const sequenceOrb=document.querySelector('[data-sequence-orb]');const steps=document.querySelectorAll('[data-step]');let running=false;
      const runSequence=()=>{if(running)return;running=true;const states=['WAITING','LISTENING','RESPONDING','SETTLED'];steps.forEach((step)=>step.classList.remove('is-current'));states.forEach((word,index)=>window.setTimeout(()=>{if(sequenceWord)sequenceWord.textContent=word;if(sequenceOrb){sequenceOrb.classList.remove('s0','s1','s2','s3');sequenceOrb.classList.add(`s${index}`);}steps[index]?.classList.add('is-current');if(index===states.length-1)running=false;},index*650));};sequenceRun?.addEventListener('click',runSequence);
    </script>
    <style>
      :global(html){background:var(--exp-bg);color:var(--exp-text)}
      :global(body){--exp-bg:#05070c;--exp-surface:#090d16;--exp-surface-2:#0d1320;--exp-text:#edf2fb;--exp-heading:#f8faff;--exp-muted:#9aa6bb;--exp-soft:#68758d;--exp-border:#1b2434;--exp-border-strong:#2b374d;--exp-blue:#6f82ff;--exp-green:var(--brand-green);margin:0;background:radial-gradient(circle at 18% 0,rgba(111,130,255,.1),transparent 32rem),var(--exp-bg)}
      main{overflow:hidden}.hero,.playground,.kinetic,.sequence,.micro,.browser,.closing{width:min(1180px,calc(100% - 48px));margin:auto}.hero{min-height:calc(100vh - 90px);display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding:70px 0 120px}.eyebrow{margin:0 0 16px;color:var(--exp-soft);font-size:.66rem;font-weight:900;letter-spacing:.18em}.hero h1{margin:0;color:var(--exp-heading);font-size:clamp(3.6rem,8vw,8rem);line-height:.84;letter-spacing:-.075em}.hero h1 span,h2 span{color:var(--exp-green)}.lede{max-width:680px;margin:28px 0 0;color:var(--exp-muted);font-size:clamp(1.05rem,1.8vw,1.25rem);line-height:1.7}.start-link{display:inline-flex;gap:12px;align-items:center;margin-top:35px;padding:13px 17px;border:1px solid var(--exp-border-strong);border-radius:999px;color:var(--exp-text);text-decoration:none;font-size:.73rem;font-weight:900;transition:transform .2s,border-color .2s}.start-link:hover,.start-link:focus-visible{border-color:var(--exp-green);transform:translateY(-2px)}.hero-stage{--px:50%;--py:50%;position:relative;min-height:520px;border:1px solid var(--exp-border-strong);border-radius:34px;overflow:hidden;background:#060a11;cursor:crosshair;box-shadow:0 35px 100px rgba(0,0,0,.35)}.stage-grid{position:absolute;inset:-20%;background-image:linear-gradient(rgba(111,130,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(111,130,255,.08) 1px,transparent 1px);background-size:34px 34px;transform:perspective(350px) rotateX(58deg) translateY(110px)}.stage-ring{position:absolute;top:var(--py);left:var(--px);border:1px solid rgba(57,255,90,.24);border-radius:50%;transform:translate(-50%,-50%);transition:left .12s linear,top .12s linear}.stage-ring--one{width:240px;height:240px}.stage-ring--two{width:390px;height:190px;border-color:rgba(111,130,255,.3);transform:translate(-50%,-50%) rotate(32deg)}.stage-core{position:absolute;top:var(--py);left:var(--px);width:112px;height:112px;display:grid;place-items:center;border:1px solid rgba(57,255,90,.45);border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(57,255,90,.2),transparent 68%);box-shadow:0 0 80px rgba(57,255,90,.14);transition:left .12s linear,top .12s linear}.stage-core span{color:var(--exp-green);font-size:.55rem;font-weight:900;letter-spacing:.12em}.stage-readout{position:absolute;left:22px;bottom:20px;display:grid;gap:5px}.stage-readout span{color:var(--exp-soft);font-size:.5rem;font-weight:800;letter-spacing:.14em}.stage-readout strong{color:var(--exp-text);font:700 .65rem ui-monospace,SFMono-Regular,Menlo,monospace}
      .section-heading{max-width:800px}.section-heading h2,.kinetic h2,.sequence h2,.browser h2,.closing h2{margin:0;color:var(--exp-heading);font-size:clamp(2.6rem,5.8vw,5.2rem);line-height:.92;letter-spacing:-.06em}.section-heading>p:last-child,.kinetic-copy>p:last-child,.sequence-head>p:last-child,.browser p:last-child,.closing>p:not(.eyebrow){max-width:720px;margin-top:20px;color:var(--exp-muted);line-height:1.75}.playground{padding:30px 0 150px}.reactor{margin-top:55px;border:1px solid var(--exp-border-strong);border-radius:28px;background:var(--exp-surface);overflow:hidden}.reactor-top,.reactor-bottom{display:flex;justify-content:space-between;gap:12px;padding:15px 18px;color:var(--exp-soft);font-size:.54rem;font-weight:900;letter-spacing:.14em}.reactor-top span:last-child{color:var(--exp-green)}.reactor-field{--rx:50%;--ry:50%;position:relative;height:500px;overflow:hidden;border-top:1px solid var(--exp-border);border-bottom:1px solid var(--exp-border);background:radial-gradient(circle at var(--rx) var(--ry),rgba(57,255,90,.09),transparent 18rem),#05080e}.field-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(111,130,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(111,130,255,.055) 1px,transparent 1px);background-size:45px 45px}.field-glow{position:absolute;left:50%;top:50%;width:170px;height:170px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(57,255,90,.32),rgba(57,255,90,.05) 42%,transparent 68%);filter:blur(4px);pointer-events:none}.field-core{position:absolute;left:50%;top:50%;width:120px;height:120px;display:grid;place-items:center;border:1px solid rgba(57,255,90,.4);border-radius:50%;background:radial-gradient(circle,rgba(57,255,90,.18),transparent 67%);box-shadow:0 0 70px rgba(57,255,90,.1);pointer-events:none}.field-core span{color:var(--exp-green);font-size:.56rem;font-weight:900;letter-spacing:.15em}.field-orbit{position:absolute;left:50%;top:50%;width:280px;height:120px;border:1px solid rgba(111,130,255,.28);border-radius:50%;transform:translate(-50%,-50%) rotate(25deg);animation:orbit 12s linear infinite}.field-points{position:absolute;inset:20%;animation:orbit 20s linear infinite reverse}.field-points i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--exp-green);box-shadow:0 0 14px var(--exp-green)}.field-points i:nth-child(1){left:10%;top:20%}.field-points i:nth-child(2){right:18%;top:12%}.field-points i:nth-child(3){right:8%;bottom:25%}.field-points i:nth-child(4){left:18%;bottom:12%}.field-points i:nth-child(5){left:50%;top:4%}.field-points i:nth-child(6){left:4%;top:52%}@keyframes orbit{to{transform:translate(-50%,-50%) rotate(385deg)}}.reactor-bottom{letter-spacing:.1em}
      .kinetic{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center;padding:20px 0 150px;border-top:1px solid var(--exp-border)}.kinetic-copy{max-width:500px}.word-field{min-height:430px;display:flex;flex-wrap:wrap;align-content:center;justify-content:center;gap:10px;padding:30px;border:1px solid var(--exp-border);border-radius:28px;background:radial-gradient(circle at 50% 50%,rgba(111,130,255,.08),transparent 65%),var(--exp-surface)}.word-field button{border:0;background:transparent;color:var(--exp-soft);font:900 clamp(2rem,5vw,4.8rem)/.8 Atkinson,system-ui;letter-spacing:-.07em;cursor:pointer;transition:transform .25s,color .25s,opacity .25s}.word-field button:hover,.word-field button:focus-visible,.word-field button.is-selected{color:var(--exp-green);transform:scale(1.08) rotate(-2deg);outline:none}.word-field button:nth-child(2).is-selected{transform:scale(1.18) rotate(2deg)}.word-field button:nth-child(3).is-selected{transform:scale(.9) rotate(-3deg)}
      .sequence{padding:20px 0 150px}.sequence-demo{display:grid;grid-template-columns:1fr .7fr;gap:35px;margin-top:50px;padding:18px;border:1px solid var(--exp-border);border-radius:28px;background:var(--exp-surface)}.sequence-visual{position:relative;min-height:390px;display:grid;place-items:center;overflow:hidden;border-radius:20px;background:#05080e}.sequence-visual:before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 44px,rgba(111,130,255,.05) 45px),repeating-linear-gradient(0deg,transparent 0 44px,rgba(111,130,255,.05) 45px)}.sequence-orb{width:170px;height:170px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f1fff3 0 3%,rgba(57,255,90,.7) 7%,rgba(57,255,90,.16) 44%,transparent 69%);box-shadow:0 0 80px rgba(57,255,90,.12);transition:transform .5s,filter .5s}.sequence-orb.s1{transform:scale(.72);filter:hue-rotate(20deg)}.sequence-orb.s2{transform:scale(1.3);filter:saturate(1.5)}.sequence-orb.s3{transform:scale(.95);filter:saturate(.75);opacity:.7}.sequence-visual>span{position:absolute;bottom:22px;color:var(--exp-soft);font:800 .55rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em}.sequence-scan{position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(57,255,90,.12),transparent)}.sequence-demo:has(.sequence-orb.s1) .sequence-scan{animation:scanline 650ms ease}@keyframes scanline{to{transform:translateX(100%)}}.sequence-controls{display:flex;flex-direction:column;justify-content:center;padding:25px}.sequence-controls>button,.micro-card{cursor:pointer}.sequence-controls>button{align-self:flex-start;padding:13px 17px;border:1px solid var(--exp-border-strong);border-radius:999px;background:var(--exp-surface-2);color:var(--exp-text);font:800 .7rem Atkinson,system-ui}.sequence-controls>button:hover,.sequence-controls>button:focus-visible{border-color:var(--exp-green);outline:none}.sequence-steps{display:grid;gap:9px;margin-top:30px}.sequence-steps span{padding:13px 14px;border:1px solid var(--exp-border);color:var(--exp-soft);font-size:.55rem;font-weight:900;letter-spacing:.1em}.sequence-steps span.is-current{border-color:rgba(57,255,90,.4);color:var(--exp-green);background:rgba(57,255,90,.04)}
      .micro{padding:20px 0 150px}.micro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:50px}.micro-card{min-height:300px;padding:25px;display:flex;flex-direction:column;align-items:flex-start;text-align:left;border:1px solid var(--exp-border);border-radius:24px;background:var(--exp-surface);color:var(--exp-text);transition:transform .2s,border-color .2s,background .2s}.micro-card:hover{transform:translateY(-4px);border-color:var(--exp-border-strong);background:var(--exp-surface-2)}.micro-card strong{margin-top:auto;font-size:1.15rem}.micro-card small{margin-top:5px;color:var(--exp-soft)}.micro-visual{width:92px;height:92px;margin-bottom:25px;display:block}.micro-visual--pulse{border:1px solid rgba(57,255,90,.45);border-radius:50%;box-shadow:inset 0 0 30px rgba(57,255,90,.08),0 0 35px rgba(57,255,90,.08)}.micro-visual--scan{position:relative;border:1px solid var(--exp-border-strong);overflow:hidden}.micro-visual--scan:after{content:'';position:absolute;left:-20%;top:0;width:18%;height:100%;background:var(--exp-green);box-shadow:0 0 22px var(--exp-green);transform:skewX(-15deg)}.micro-card.is-active .micro-visual--pulse{animation:feedbackPulse 600ms ease}.micro-card.is-active .micro-visual--scan:after{animation:feedbackScan 800ms ease}.micro-visual--expand{border:1px solid var(--exp-border-strong);border-radius:16px;box-shadow:inset 0 0 0 16px rgba(111,130,255,.04)}.micro-card.is-active .micro-visual--expand{animation:feedbackExpand 650ms ease}@keyframes feedbackPulse{50%{transform:scale(1.25);background:rgba(57,255,90,.1)}}@keyframes feedbackScan{to{left:110%}}@keyframes feedbackExpand{50%{transform:scale(1.15);border-color:var(--exp-green);box-shadow:inset 0 0 0 3px rgba(57,255,90,.16)}}
      .browser{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px;align-items:center;padding:20px 0 150px;border-top:1px solid var(--exp-border)}.browser h2{margin-top:0}.browser-list{border:1px solid var(--exp-border);border-radius:22px;overflow:hidden;background:var(--exp-surface)}.browser-list div{display:flex;justify-content:space-between;gap:25px;padding:20px;border-bottom:1px solid var(--exp-border)}.browser-list div:last-child{border-bottom:0}.browser-list span{color:var(--exp-blue);font-size:.55rem;font-weight:900}.browser-list strong{color:var(--exp-text);font-size:.7rem}.closing{padding:20px 0 150px;border-top:1px solid var(--exp-border)}.closing h2{max-width:950px}.closing a{display:inline-flex;gap:14px;margin-top:35px;padding:15px 19px;border-radius:999px;background:var(--exp-green);color:#041006;text-decoration:none;font-size:.72rem;font-weight:900;box-shadow:0 18px 55px rgba(57,255,90,.1)}
      @media(prefers-color-scheme:light){:global(html){background:#fff}:global(body){--exp-bg:#fff;--exp-surface:#f6f8fb;--exp-surface-2:#eef2f7;--exp-text:#253047;--exp-heading:#0d1420;--exp-muted:#61718c;--exp-soft:#738099;--exp-border:#dfe5ee;--exp-border-strong:#c7d0df;--exp-blue:#5365db;--exp-green:var(--brand-green-dark);background:radial-gradient(circle at 18% 0,rgba(83,101,219,.06),transparent 32rem),var(--exp-bg)}.hero-stage,.reactor-field,.sequence-visual{background:#f3f6fa}.word-field{background:radial-gradient(circle at 50% 50%,rgba(83,101,219,.06),transparent 65%),#f6f8fb}.micro-card,.reactor,.sequence-demo,.browser-list{background:#f6f8fb}}
      @media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.kinetic,.browser,.sequence-demo{grid-template-columns:1fr}.micro-grid{grid-template-columns:1fr}.browser{gap:45px}}
      @media(max-width:620px){.hero,.playground,.kinetic,.sequence,.micro,.browser,.closing{width:min(100% - 28px,1180px)}.hero{padding:55px 0 90px}.hero h1{font-size:clamp(3rem,15vw,5rem)}.hero-stage{min-height:390px}.reactor-field{height:390px}.reactor-top,.reactor-bottom{font-size:.48rem}.stage-ring--two{width:280px}.field-orbit{width:220px}.kinetic{gap:35px}.word-field{min-height:330px;padding:20px}.word-field button{font-size:clamp(1.8rem,11vw,3.4rem)}.sequence-visual{min-height:320px}.sequence-controls{padding:12px}.micro-card{min-height:250px}.browser-list div{display:grid;gap:8px}}
      @media(prefers-reduced-motion:reduce){.stage-ring,.stage-core{transition:none}.field-orbit,.field-points,.micro-card,.word-field button{animation:none;transition:none}.sequence-orb{transition:none}.micro-card.is-active .micro-visual--pulse,.micro-card.is-active .micro-visual--scan:after,.micro-card.is-active .micro-visual--expand{animation:none}}
    </style>
  </body>
</html>
