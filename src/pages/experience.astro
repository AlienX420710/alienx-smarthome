---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const title = `Experience | ${SITE_TITLE}`;
const description = 'A museum of interactive browser experiments from AlienX: motion, physics, generative interfaces, algorithms, browser APIs, and live DOM exploration.';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`Experience — ${SITE_TITLE}`} description={description} /></head>
  <body>
    <Header />
    <main>
      <section class="entrance" aria-labelledby="experience-title">
        <div class="entrance-copy">
          <p class="eyebrow">ALIENX / EXPERIENCE MUSEUM</p>
          <h1 id="experience-title">Don't just <span>look.</span><br />touch the web.</h1>
          <p class="lede">A collection of browser experiments built to prove a point: a website can be a machine, a playground, a simulation, and an interface at the same time.</p>
          <a class="enter" href="#museum">Enter the museum <span>↓</span></a>
        </div>
        <div class="entrance-art" data-entrance-art aria-label="Interactive pointer field. Move your pointer through the exhibit.">
          <canvas data-pointer-canvas></canvas>
          <div class="entrance-label"><span>EXHIBIT 00</span><strong>POINTER FIELD</strong></div>
        </div>
      </section>

      <section class="museum" id="museum" aria-labelledby="museum-title">
        <header class="museum-intro">
          <div><p class="eyebrow">THE COLLECTION</p><h2 id="museum-title">Eight ways to make a browser <span>do something.</span></h2></div>
          <p>Every exhibit is an actual interaction. No fake metrics. No dashboard to configure. Try them, break them, resize them, and see what happens.</p>
        </header>

        <article class="exhibit exhibit--wide" id="pointer-field">
          <div class="exhibit-meta"><span>01</span><span>INPUT / MOTION / CANVAS</span></div>
          <div class="exhibit-copy"><p class="eyebrow">POINTER FIELD</p><h3>Move through a living field.</h3><p>Your pointer becomes an input signal. Particles calculate their distance from it and react in real time.</p></div>
          <div class="pointer-lab" data-pointer-lab><canvas data-particle-canvas></canvas><div class="lab-hint">MOVE YOUR POINTER</div></div>
        </article>

        <div class="exhibit-pair">
          <article class="exhibit" id="kinetic-type">
            <div class="exhibit-meta"><span>02</span><span>TYPOGRAPHY / TRANSFORM</span></div>
            <p class="eyebrow">KINETIC TYPE</p><h3>Words have weight.</h3><p>Hover or focus the words. Scale, rotation, and position turn typography into an interface.</p>
            <div class="type-stage" data-type-stage>
              <button type="button" data-kinetic>MOVE</button><button type="button" data-kinetic>THINK</button><button type="button" data-kinetic>BUILD</button><button type="button" data-kinetic>RESPOND</button>
            </div>
          </article>

          <article class="exhibit" id="physics">
            <div class="exhibit-meta"><span>03</span><span>SIMULATION / POINTER</span></div>
            <p class="eyebrow">PHYSICS PLAYGROUND</p><h3>Throw something.</h3><p>Grab the objects and fling them around the surface. The simulation uses velocity, gravity, friction, and collision with the bounds.</p>
            <div class="physics-stage" data-physics-stage><canvas data-physics-canvas></canvas><button type="button" class="physics-reset" data-physics-reset>RESET</button></div>
          </article>
        </div>

        <article class="exhibit exhibit--wide" id="generative">
          <div class="exhibit-meta"><span>04</span><span>PROCEDURAL / DOM / LAYOUT</span></div>
          <div class="exhibit-split">
            <div class="exhibit-copy"><p class="eyebrow">GENERATIVE INTERFACE</p><h3>Let the interface invent itself.</h3><p>Generate a new composition. The browser creates a fresh visual system from rules rather than a fixed screenshot.</p><button type="button" class="exhibit-button" data-generate>Generate composition <span>↻</span></button></div>
            <div class="generation-stage" data-generation-stage aria-live="polite"></div>
          </div>
        </article>

        <div class="exhibit-pair">
          <article class="exhibit" id="network">
            <div class="exhibit-meta"><span>05</span><span>GRAPH / SVG / GEOMETRY</span></div>
            <p class="eyebrow">NETWORK ILLUSION</p><h3>Walk through a graph.</h3><p>Move your pointer through the network. Nearby nodes connect and influence one another.</p>
            <div class="network-stage" data-network-stage><svg data-network-svg viewBox="0 0 520 360" role="img" aria-label="Interactive network graph"></svg></div>
          </article>

          <article class="exhibit" id="algorithms">
            <div class="exhibit-meta"><span>06</span><span>ALGORITHM / DATA / ANIMATION</span></div>
            <p class="eyebrow">ALGORITHM VISUALIZER</p><h3>Watch computation happen.</h3><p>Choose an algorithm, shuffle the data, and watch the actual comparisons and swaps happen.</p>
            <div class="algorithm-stage" data-algorithm-stage>
              <div class="bars" data-bars aria-label="Sorting visualization"></div>
              <div class="algorithm-controls"><select data-algorithm aria-label="Sorting algorithm"><option value="bubble">Bubble sort</option><option value="insertion">Insertion sort</option><option value="selection">Selection sort</option></select><button type="button" data-sort>Sort</button><button type="button" data-shuffle>Shuffle</button></div>
              <div class="algorithm-readout"><span data-comparisons>0 comparisons</span><span data-swaps>0 swaps</span></div>
            </div>
          </article>
        </div>

        <div class="exhibit-pair">
          <article class="exhibit" id="dom-observatory">
            <div class="exhibit-meta"><span>07</span><span>DOM / OBSERVER / STRUCTURE</span></div>
            <p class="eyebrow">DOM OBSERVATORY</p><h3>The page can inspect itself.</h3><p>Click a node to inspect a real element on this page. The tree is generated from the live DOM.</p>
            <div class="dom-stage" data-dom-stage>
              <div class="dom-tree" data-dom-tree></div>
              <div class="dom-inspector"><span>SELECTED NODE</span><strong data-dom-selected>BODY</strong><code data-dom-details>&lt;body&gt;</code></div>
            </div>
          </article>

          <article class="exhibit" id="browser-lab">
            <div class="exhibit-meta"><span>08</span><span>NATIVE APIS / PROGRESSIVE ENHANCEMENT</span></div>
            <p class="eyebrow">BROWSER CAPABILITY LAB</p><h3>Ask the browser.</h3><p>No claims. These rows query this browser for capabilities it actually exposes.</p>
            <div class="capability-list" data-capabilities></div>
          </article>
        </div>
      </section>

      <section class="more-lab" aria-labelledby="more-title">
        <p class="eyebrow">NEXT EXHIBITION</p>
        <h2 id="more-title">The museum can keep <span>growing.</span></h2>
        <div class="teaser-grid"><div><strong>OFFLINE</strong><span>Client-side resilience</span></div><div><strong>AUDIO REACTIVE</strong><span>Media APIs</span></div><div><strong>ACCESSIBILITY MODE</strong><span>Adaptive interfaces</span></div><div><strong>WEBGL</strong><span>GPU rendering</span></div></div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <p class="eyebrow">EXIT / THE POINT</p>
        <h2 id="closing-title">You just interacted with the technology.</h2>
        <p>That is what Experience is for. Technology explains the machinery. This museum lets people operate it.</p>
        <a href="/technology">See what is underneath <span>→</span></a>
      </section>
    </main>
    <Footer />

    <script data-astro-rerun>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const pointerCanvas = document.querySelector('[data-pointer-canvas]');
      const entranceArt = document.querySelector('[data-entrance-art]');
      if (pointerCanvas instanceof HTMLCanvasElement && entranceArt instanceof HTMLElement) {
        const ctx = pointerCanvas.getContext('2d');
        const resize = () => { const dpr = Math.min(window.devicePixelRatio || 1, 2); pointerCanvas.width = entranceArt.clientWidth * dpr; pointerCanvas.height = entranceArt.clientHeight * dpr; pointerCanvas.style.width = `${entranceArt.clientWidth}px`; pointerCanvas.style.height = `${entranceArt.clientHeight}px`; ctx?.setTransform(dpr, 0, 0, dpr, 0, 0); };
        const points = Array.from({ length: 90 }, (_, i) => ({ x: (i * 47) % 620, y: (i * 83) % 520, r: 1 + (i % 3) * .5 }));
        let mouse = { x: -1000, y: -1000 };
        const draw = () => { if (!ctx) return; const w = entranceArt.clientWidth, h = entranceArt.clientHeight; ctx.clearRect(0, 0, w, h); for (const p of points) { const x = (p.x % w), y = (p.y % h); const dx = x - mouse.x, dy = y - mouse.y, d = Math.hypot(dx, dy), force = Math.max(0, 1 - d / 190); ctx.beginPath(); ctx.arc(x + dx * force * .12, y + dy * force * .12, p.r + force * 2, 0, Math.PI * 2); ctx.fillStyle = `rgba(57,255,90,${.22 + force * .7})`; ctx.fill(); } if (!reducedMotion) requestAnimationFrame(draw); };
        resize(); window.addEventListener('resize', resize); entranceArt.addEventListener('pointermove', e => { const r = entranceArt.getBoundingClientRect(); mouse = { x: e.clientX - r.left, y: e.clientY - r.top }; if (reducedMotion) draw(); }); entranceArt.addEventListener('pointerleave', () => { mouse = { x: -1000, y: -1000 }; if (reducedMotion) draw(); }); draw();
      }

      const particleCanvas = document.querySelector('[data-particle-canvas]');
      const pointerLab = document.querySelector('[data-pointer-lab]');
      if (particleCanvas instanceof HTMLCanvasElement && pointerLab instanceof HTMLElement) {
        const ctx = particleCanvas.getContext('2d'); let pointer = { x: -1000, y: -1000 }; const particles = Array.from({ length: 150 }, (_, i) => ({ x: (i * 97) % 900, y: (i * 53) % 500, vx: ((i % 5) - 2) * .08, vy: ((i % 7) - 3) * .08 }));
        const resize = () => { const dpr = Math.min(window.devicePixelRatio || 1, 2); particleCanvas.width = pointerLab.clientWidth * dpr; particleCanvas.height = pointerLab.clientHeight * dpr; particleCanvas.style.width = `${pointerLab.clientWidth}px`; particleCanvas.style.height = `${pointerLab.clientHeight}px`; ctx?.setTransform(dpr, 0, 0, dpr, 0, 0); };
        const frame = () => { if (!ctx) return; const w = pointerLab.clientWidth, h = pointerLab.clientHeight; ctx.clearRect(0, 0, w, h); for (const p of particles) { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1; const dx = pointer.x - p.x, dy = pointer.y - p.y, d = Math.hypot(dx, dy) || 1, influence = Math.max(0, 1 - d / 220); p.x -= dx / d * influence * 1.7; p.y -= dy / d * influence * 1.7; ctx.beginPath(); ctx.arc(p.x, p.y, 1.3 + influence * 2.5, 0, Math.PI * 2); ctx.fillStyle = `rgba(57,255,90,${.2 + influence * .75})`; ctx.fill(); } if (!reducedMotion) requestAnimationFrame(frame); };
        resize(); window.addEventListener('resize', resize); pointerLab.addEventListener('pointermove', e => { const r = pointerLab.getBoundingClientRect(); pointer = { x: e.clientX - r.left, y: e.clientY - r.top }; if (reducedMotion) frame(); }); pointerLab.addEventListener('pointerleave', () => { pointer = { x: -1000, y: -1000 }; if (reducedMotion) frame(); }); frame();
      }

      document.querySelectorAll('[data-kinetic]').forEach((button, index) => { button.addEventListener('pointermove', e => { if (reducedMotion) return; const r = button.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width - .5; const y = (e.clientY - r.top) / r.height - .5; button.style.setProperty('--tx', `${x * 22}px`); button.style.setProperty('--ty', `${y * 18}px`); button.style.setProperty('--rot', `${x * 7 + (index % 2 ? 2 : -2)}deg`); }); button.addEventListener('pointerleave', () => { button.style.removeProperty('--tx'); button.style.removeProperty('--ty'); button.style.removeProperty('--rot'); }); });

      const physicsStage = document.querySelector('[data-physics-stage]'); const physicsCanvas = document.querySelector('[data-physics-canvas]');
      if (physicsStage instanceof HTMLElement && physicsCanvas instanceof HTMLCanvasElement) {
        const ctx = physicsCanvas.getContext('2d'); let drag = null; const balls = Array.from({ length: 7 }, (_, i) => ({ x: 55 + i * 45, y: 55 + (i % 3) * 55, vx: (i % 2 ? 1 : -1) * (1 + i * .15), vy: -1 + i * .18, r: 14 + (i % 3) * 5 }));
        const resize = () => { const dpr = Math.min(window.devicePixelRatio || 1, 2); physicsCanvas.width = physicsStage.clientWidth * dpr; physicsCanvas.height = physicsStage.clientHeight * dpr; physicsCanvas.style.width = `${physicsStage.clientWidth}px`; physicsCanvas.style.height = `${physicsStage.clientHeight}px`; ctx?.setTransform(dpr, 0, 0, dpr, 0, 0); };
        const reset = () => balls.forEach((b, i) => { b.x = 45 + i * 42; b.y = 55 + (i % 3) * 52; b.vx = (i % 2 ? 1 : -1) * (1 + i * .15); b.vy = -1 + i * .18; });
        const frame = () => { if (!ctx) return; const w = physicsStage.clientWidth, h = physicsStage.clientHeight; ctx.clearRect(0, 0, w, h); for (const b of balls) { if (drag !== b) { b.vy += .045; b.x += b.vx; b.y += b.vy; if (b.x < b.r) { b.x = b.r; b.vx *= -.86; } if (b.x > w - b.r) { b.x = w - b.r; b.vx *= -.86; } if (b.y < b.r) { b.y = b.r; b.vy *= -.86; } if (b.y > h - b.r) { b.y = h - b.r; b.vy *= -.86; } } ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2); ctx.fillStyle = 'rgba(57,255,90,.12)'; ctx.fill(); ctx.strokeStyle = 'rgba(57,255,90,.55)'; ctx.stroke(); } if (!reducedMotion) requestAnimationFrame(frame); };
        const pick = e => { const r = physicsStage.getBoundingClientRect(); const x = e.clientX - r.left, y = e.clientY - r.top; drag = balls.find(b => Math.hypot(b.x - x, b.y - y) < b.r + 10) || null; }; physicsStage.addEventListener('pointerdown', pick); physicsStage.addEventListener('pointermove', e => { if (!drag) return; const r = physicsStage.getBoundingClientRect(); drag.vx = e.movementX; drag.vy = e.movementY; drag.x = e.clientX - r.left; drag.y = e.clientY - r.top; }); window.addEventListener('pointerup', () => { drag = null; }); document.querySelector('[data-physics-reset]')?.addEventListener('click', reset); resize(); window.addEventListener('resize', resize); reset(); frame();
      }

      const generationStage = document.querySelector('[data-generation-stage]'); const renderGeneration = () => { if (!(generationStage instanceof HTMLElement)) return; generationStage.innerHTML = ''; const count = 18; for (let i = 0; i < count; i++) { const block = document.createElement('span'); block.className = 'generated-block'; block.style.setProperty('--x', `${Math.round(Math.random() * 90)}%`); block.style.setProperty('--y', `${Math.round(Math.random() * 82)}%`); block.style.setProperty('--s', `${.35 + Math.random() * 1.4}`); block.style.setProperty('--r', `${Math.round(Math.random() * 180 - 90)}deg`); block.textContent = i % 3 === 0 ? 'AX' : ''; generationStage.appendChild(block); } }; document.querySelector('[data-generate]')?.addEventListener('click', renderGeneration); renderGeneration();

      const networkSvg = document.querySelector('[data-network-svg]'); const networkStage = document.querySelector('[data-network-stage]');
      if (networkSvg instanceof SVGSVGElement && networkStage instanceof HTMLElement) { const nodes = Array.from({ length: 18 }, (_, i) => ({ x: 35 + (i * 71) % 450, y: 35 + (i * 113) % 290 })); const ns = 'http://www.w3.org/2000/svg'; nodes.forEach((n, i) => { const c = document.createElementNS(ns, 'circle'); c.setAttribute('cx', String(n.x)); c.setAttribute('cy', String(n.y)); c.setAttribute('r', i % 4 === 0 ? '5' : '3'); c.setAttribute('class', 'network-node'); networkSvg.appendChild(c); }); const lines = []; for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) { if (Math.hypot(nodes[i].x - nodes[j].x, nodes[i].y - nodes[j].y) < 135) { const line = document.createElementNS(ns, 'line'); line.setAttribute('x1', String(nodes[i].x)); line.setAttribute('y1', String(nodes[i].y)); line.setAttribute('x2', String(nodes[j].x)); line.setAttribute('y2', String(nodes[j].y)); line.setAttribute('class', 'network-line'); networkSvg.insertBefore(line, networkSvg.firstChild); lines.push({ line, a: i, b: j }); } } networkStage.addEventListener('pointermove', e => { const r = networkStage.getBoundingClientRect(); const x = ((e.clientX - r.left) / r.width) * 520, y = ((e.clientY - r.top) / r.height) * 360; nodes.forEach((n, i) => { const d = Math.hypot(n.x - x, n.y - y); networkSvg.querySelectorAll('.network-node')[i]?.setAttribute('r', d < 90 ? '7' : i % 4 === 0 ? '5' : '3'); }); lines.forEach(({ line, a, b }) => { const d = Math.min(Math.hypot(nodes[a].x - x, nodes[a].y - y), Math.hypot(nodes[b].x - x, nodes[b].y - y)); line.classList.toggle('network-hot', d < 90); }); }); }

      const bars = document.querySelector('[data-bars]'); const comparisonReadout = document.querySelector('[data-comparisons]'); const swapReadout = document.querySelector('[data-swaps]'); let values = Array.from({ length: 28 }, () => Math.round(15 + Math.random() * 85)); let sorting = false;
      const drawBars = active => { if (!(bars instanceof HTMLElement)) return; bars.innerHTML = ''; values.forEach((v, i) => { const bar = document.createElement('i'); bar.style.height = `${v}%`; if (i === active?.[0] || i === active?.[1]) bar.classList.add('is-active'); bars.appendChild(bar); }); };
      const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
      const sortValues = async () => { if (sorting || reducedMotion) return; sorting = true; let comparisons = 0, swaps = 0; const algorithm = document.querySelector('[data-algorithm]')?.value || 'bubble'; const compare = async (i, j) => { comparisons++; drawBars([i, j]); if (comparisonReadout) comparisonReadout.textContent = `${comparisons} comparisons`; await sleep(35); }; if (algorithm === 'bubble') { for (let end = values.length - 1; end > 0; end--) for (let i = 0; i < end; i++) { await compare(i, i + 1); if (values[i] > values[i + 1]) { [values[i], values[i + 1]] = [values[i + 1], values[i]]; swaps++; if (swapReadout) swapReadout.textContent = `${swaps} swaps`; } } } else if (algorithm === 'selection') { for (let i = 0; i < values.length - 1; i++) { let min = i; for (let j = i + 1; j < values.length; j++) { await compare(min, j); if (values[j] < values[min]) min = j; } if (min !== i) { [values[i], values[min]] = [values[min], values[i]]; swaps++; if (swapReadout) swapReadout.textContent = `${swaps} swaps`; } } } else { for (let i = 1; i < values.length; i++) { let j = i; while (j > 0) { await compare(j - 1, j); if (values[j - 1] <= values[j]) break; [values[j - 1], values[j]] = [values[j], values[j - 1]]; swaps++; if (swapReadout) swapReadout.textContent = `${swaps} swaps`; j--; } } } drawBars(); sorting = false; }; document.querySelector('[data-sort]')?.addEventListener('click', sortValues); document.querySelector('[data-shuffle]')?.addEventListener('click', () => { if (sorting) return; values = values.map(() => Math.round(15 + Math.random() * 85)); if (comparisonReadout) comparisonReadout.textContent = '0 comparisons'; if (swapReadout) swapReadout.textContent = '0 swaps'; drawBars(); }); drawBars();

      const domTree = document.querySelector('[data-dom-tree]'); const domSelected = document.querySelector('[data-dom-selected]'); const domDetails = document.querySelector('[data-dom-details]');
      if (domTree instanceof HTMLElement) { const nodes = Array.from(document.body.children).filter(el => el.tagName !== 'SCRIPT'); const build = (el, depth = 0) => { const row = document.createElement('button'); row.type = 'button'; row.className = 'dom-node'; row.style.paddingLeft = `${8 + depth * 12}px`; row.textContent = `<${el.tagName.toLowerCase()}>`; row.addEventListener('click', () => { domTree.querySelectorAll('.is-selected').forEach(n => n.classList.remove('is-selected')); row.classList.add('is-selected'); if (domSelected) domSelected.textContent = el.tagName.toLowerCase(); if (domDetails) domDetails.textContent = `<${el.tagName.toLowerCase()}${el.id ? ` id="${el.id}"` : ''}>`; }); domTree.appendChild(row); Array.from(el.children).slice(0, 7).forEach(child => build(child, depth + 1)); }; nodes.slice(0, 4).forEach(el => build(el)); }

      const capabilityList = document.querySelector('[data-capabilities]');
      if (capabilityList instanceof HTMLElement) { const capabilities = [ ['Canvas 2D', () => !!document.createElement('canvas').getContext('2d')], ['WebGL', () => { try { return !!document.createElement('canvas').getContext('webgl'); } catch { return false; } }], ['Web Workers', () => 'Worker' in window], ['IndexedDB', () => 'indexedDB' in window], ['Web Audio', () => 'AudioContext' in window || 'webkitAudioContext' in window], ['Clipboard API', () => !!navigator.clipboard], ['Touch Input', () => navigator.maxTouchPoints > 0], ['Reduced Motion', () => reducedMotion] ]; capabilities.forEach(([name, test]) => { const row = document.createElement('div'); row.className = 'capability-row'; const supported = test(); row.innerHTML = `<span>${name}</span><strong>${supported ? 'AVAILABLE' : 'UNAVAILABLE'}</strong>`; capabilityList.appendChild(row); }); }
    </script>

    <style>
      :global(html){background:var(--museum-bg);color:var(--museum-text)}
      :global(body){--museum-bg:#05070c;--museum-surface:#090d16;--museum-surface-2:#0d1320;--museum-text:#edf2fb;--museum-heading:#f8faff;--museum-muted:#9aa6bb;--museum-soft:#68758d;--museum-border:#1b2434;--museum-border-strong:#2b374d;--museum-blue:#6f82ff;--museum-green:var(--brand-green);margin:0;background:radial-gradient(circle at 10% 0,rgba(111,130,255,.11),transparent 32rem),radial-gradient(circle at 90% 20%,rgba(57,255,90,.04),transparent 28rem),var(--museum-bg)}
      main{overflow:hidden}.entrance,.museum,.more-lab,.closing{width:min(1180px,calc(100% - 48px));margin:auto}.entrance{min-height:calc(100vh - 90px);display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center;padding:65px 0 120px}.eyebrow{margin:0 0 15px;color:var(--museum-soft);font-size:.63rem;font-weight:900;letter-spacing:.18em}.entrance h1,.museum h2,.more-lab h2,.closing h2{margin:0;color:var(--museum-heading);letter-spacing:-.065em;line-height:.88}.entrance h1{font-size:clamp(3.5rem,7.7vw,7.7rem)}h1 span,h2 span,h3 span{color:var(--museum-green)}.lede{max-width:650px;margin:27px 0 0;color:var(--museum-muted);font-size:clamp(1.05rem,1.8vw,1.24rem);line-height:1.7}.enter,.closing a{display:inline-flex;align-items:center;gap:13px;margin-top:34px;padding:14px 18px;border-radius:999px;text-decoration:none;color:#061008;background:var(--museum-green);font-size:.7rem;font-weight:900;box-shadow:0 18px 60px rgba(57,255,90,.1)}.entrance-art{position:relative;min-height:560px;border:1px solid var(--museum-border-strong);border-radius:34px;overflow:hidden;background:#060a11;box-shadow:0 40px 110px rgba(0,0,0,.35)}.entrance-art canvas,.pointer-lab canvas,.physics-stage canvas{display:block;width:100%;height:100%}.entrance-art:before,.pointer-lab:before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(111,130,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(111,130,255,.07) 1px,transparent 1px);background-size:38px 38px;pointer-events:none}.entrance-label{position:absolute;left:20px;bottom:20px;display:grid;gap:5px}.entrance-label span{color:var(--museum-soft);font-size:.5rem;letter-spacing:.16em;font-weight:900}.entrance-label strong{color:var(--museum-green);font-size:.68rem;letter-spacing:.12em}
