---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Message received — ${SITE_TITLE}`}
      description="Your AlienX inquiry has been received. Explore more of the AlienX SmartHome experience while you wait for a response."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="success" aria-labelledby="title">
        <div class="mark" aria-hidden="true">✓</div>
        <p class="eyebrow">ALIENX / RECEIVED</p>
        <h1 id="title">You're in.</h1>
        <p class="lede">
          Your message made it through. We'll review the details and get back to you using your preferred contact method.
        </p>

        <nav class="next" aria-label="Continue exploring AlienX">
          <a class="primary" href="/experience">Explore the experience <span aria-hidden="true">→</span></a>
          <a href="/technology">See the technology</a>
          <a href="/journal">Read the journal</a>
          <a href="/">Back to home</a>
        </nav>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .success {
    width: min(760px, 100%);
    min-height: 68vh;
    margin: 0 auto;
    display: grid;
    align-content: center;
    justify-items: start;
    padding: 7rem 0;
  }

  .mark {
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    margin-bottom: 2rem;
    border: 1px solid rgba(130, 230, 255, 0.45);
    border-radius: 50%;
    color: #9be9ff;
    font-size: 1.7rem;
    box-shadow: 0 0 40px rgba(60, 190, 255, 0.14);
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .lede {
    max-width: 620px;
    margin: 1.75rem 0 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.7;
    opacity: 0.76;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .next a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.035);
    transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .next a:hover {
    border-color: rgba(155, 233, 255, 0.42);
    background: rgba(255, 255, 255, 0.07);
    transform: translateY(-2px);
  }

  .next .primary {
    border-color: rgba(155, 233, 255, 0.38);
    background: rgba(90, 200, 255, 0.1);
  }

  @media (max-width: 640px) {
    .success {
      min-height: 64vh;
      padding: 5rem 0;
    }

    .next {
      align-items: stretch;
      flex-direction: column;
      width: 100%;
    }

    .next a {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next a {
      transition: none;
    }

    .next a:hover {
      transform: none;
    }
  }
</style>
