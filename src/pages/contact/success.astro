---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={`Message received — ${SITE_TITLE}`} description="Your AlienX inquiry has been received. Explore more of the AlienX SmartHome experience while you wait for a response." /></head><body><Header /><main><section class="success" aria-labelledby="title"><div class="mark" aria-hidden="true">✓</div><p class="eyebrow">ALIENX / RECEIVED</p><h1 id="title">You're in.</h1><p class="lede">Your message made it through. We'll review the details and get back to you using your preferred contact method.</p><nav class="next" aria-label="Continue exploring AlienX"><a class="primary" href="/experience">Explore the experience <span aria-hidden="true">→</span></a><a href="/technology">See the technology</a><a href="/about">Read About Me</a><a href="/">Back to home</a></nav></section></main><Footer /></body></html>
<style>
:global(body){--success-background:#05070c;--success-text:#eef2ff;--success-heading:#f6f8ff;--success-muted:#98a4bd;--success-border:rgba(255,255,255,.14);--success-surface:rgba(255,255,255,.035);--success-surface-hover:rgba(255,255,255,.07);--success-accent:var(--brand-green);--success-accent-border:rgba(57,255,90,.38);background:var(--success-background);color:var(--success-text)}@media(prefers-color-scheme:light){:global(body){--success-background:#fff;--success-text:#1d2433;--success-heading:#0f1219;--success-muted:#60739f;--success-border:#d9dfeb;--success-surface:#f5f7fb;--success-surface-hover:#eef2f8;--success-accent:var(--brand-green-dark);--success-accent-border:rgba(22,128,59,.3)}}.success{width:min(760px,calc(100% - 40px));min-height:68vh;margin:0 auto;display:grid;align-content:center;justify-items:start;padding:7rem 0}.mark{width:4rem;height:4rem;display:grid;place-items:center;margin-bottom:2rem;border:1px solid var(--success-accent-border);border-radius:50%;color:var(--success-accent);font-size:1.7rem;box-shadow:0 0 40px rgba(57,255,90,.12)}.eyebrow{margin:0 0 1rem;color:var(--success-muted);font-size:.75rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}h1{margin:0;color:var(--success-heading);font-size:clamp(3.5rem,10vw,7rem);line-height:.95;letter-spacing:-.055em}.lede{max-width:620px;margin:1.75rem 0 0;color:var(--success-muted);font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.7}.next{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2.5rem}.next a{display:inline-flex;align-items:center;gap:.55rem;min-height:3rem;padding:.75rem 1rem;border:1px solid var(--success-border);border-radius:999px;color:var(--success-text);text-decoration:none;background:var(--success-surface);transition:border-color 180ms ease,transform 180ms ease,background 180ms ease}.next a:hover{border-color:var(--success-accent-border);background:var(--success-surface-hover);transform:translateY(-2px)}.next .primary{border-color:var(--success-accent-border);background:rgba(57,255,90,.1)}@media(max-width:640px){.success{width:min(100% - 28px,680px);min-height:64vh;padding:5rem 0}.next{align-items:stretch;flex-direction:column;width:100%}.next a{justify-content:center}}@media(prefers-reduced-motion:reduce){.next a{transition:none}.next a:hover{transform:none}}
</style>
