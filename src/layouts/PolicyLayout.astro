---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-alienx-page="policy">
  <head>
    <BaseHead title={`${title} — ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <article aria-labelledby="policy-title">
        <p class="eyebrow">ALIENX / INFORMATION</p>
        <h1 id="policy-title">{title}</h1>
        <p class="updated">
          Last updated: <time datetime="2026-10-06">October 6, 2026</time>
        </p>
        <slot />
        <nav class="policy-links" aria-label="Policy navigation">
          <a tabindex="0" href="/privacy/">
            Privacy Policy
          </a>
          <a tabindex="0" href="/terms/">
            Terms of Service
          </a>
          <a tabindex="0" href="/contact/">
            Back to contact
          </a>
        </nav>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: min(780px, calc(100% - 40px));
    padding: clamp(2rem, 6vw, 5rem) 0;
  }
  article {
    min-width: 0;
    color: var(--page-text);
    overflow-wrap: anywhere;
  }
  h1 {
    color: var(--page-heading);
    font-size: clamp(2.3rem, 7vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-weight: 700;
  }
  .updated {
    margin-bottom: 2.5rem;
    font-size: 0.9rem;
  }
  article :global(h2) {
    color: var(--page-heading);
    font-size: 1.35rem;
    line-height: 1.4;
    margin-top: 2rem;
  }
  article :global(p),
  article :global(li) {
    line-height: 1.75;
  }
  article :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--page-border);
  }
</style>
