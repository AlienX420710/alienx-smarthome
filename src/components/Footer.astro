---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="wordmark" href="/" aria-label="AlienX SmartHome home"><span class="wordmark-alienx">ALIENX</span><span class="wordmark-separator"> / </span><span class="wordmark-smarthome">SMART HOME</span></a>
			<p>Web, automation, infrastructure, and smart technology built for the modern web.</p>
		</div>
		<nav class="footer-links" aria-label="Footer navigation"><a href="/work">Work</a><a href="/experience">Experience</a><a href="/technology">Technology</a><a href="/about">About Me</a></nav>
		<div class="footer-external"><a href="https://alienxhomeassistant.alienxsmarthome.com" target="_blank" rel="noreferrer">Home Assistant ↗</a><a href="https://github.com/AlienX420710/alienx-smarthome" target="_blank" rel="noreferrer">Source ↗</a></div>
	</div>
	<div class="footer-bottom"><span>&copy; {today.getFullYear()} <span class="footer-brand-name">AlienX</span> <span class="footer-brand-name-secondary">SmartHome</span></span><span><span class="footer-tech">Built with Astro</span><span class="footer-separator"> · </span><span class="footer-tech-secondary">Deployed on Cloudflare</span></span></div>
</footer>
<style>
footer{margin-top:4rem;border-top:1px solid rgb(var(--gray-light));background:rgba(var(--gray-light),.18);color:rgb(var(--gray))}.footer-inner,.footer-bottom{width:min(1200px,calc(100% - 2em));margin:auto}.footer-inner{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:3rem;padding:3.5rem 1rem}.footer-brand .wordmark{color:rgb(var(--black));font-size:.9rem;font-weight:700;letter-spacing:.14em;text-decoration:none}.wordmark-alienx{color:var(--brand-green)}.wordmark-smarthome{color:var(--accent)}.wordmark-separator{color:rgb(var(--gray))}.footer-brand p{max-width:25rem;margin:.75rem 0 0;font-size:.9rem;line-height:1.5}.footer-links,.footer-external{display:flex;flex-direction:column;align-items:flex-start;gap:.6rem}.footer-links a,.footer-external a{color:rgb(var(--gray));font-size:.9rem;text-decoration:none;transition:color 160ms ease}.footer-links a:hover,.footer-external a:hover{color:var(--accent-dark)}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border-top:1px solid rgb(var(--gray-light));font-size:.75rem}.footer-brand-name{color:var(--brand-green)}.footer-brand-name-secondary{color:var(--accent)}.footer-tech{color:var(--accent-dark)}.footer-tech-secondary{color:var(--brand-green-dark)}.footer-separator{color:rgb(var(--gray))}@media(max-width:900px){.footer-inner{grid-template-columns:1.25fr 1fr 1fr;gap:2rem}}@media(max-width:720px){.footer-inner{grid-template-columns:1fr 1fr;gap:2rem 1.5rem;padding:2.5rem .75rem}.footer-brand{grid-column:1/-1}.footer-bottom{flex-direction:column;padding-inline:.75rem}}@media(max-width:480px){.footer-inner{grid-template-columns:1fr;gap:1.75rem}.footer-brand,.footer-links,.footer-external{grid-column:auto}}@media(prefers-reduced-motion:reduce){.footer-links a,.footer-external a{transition:none}}
</style>

