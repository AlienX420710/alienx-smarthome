---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="wordmark" href="/" aria-label="AlienX SmartHome home">ALIENX<span> / </span>SMART HOME</a>
			<p>Interactive smart home concepts built for the modern web.</p>
		</div>

		<nav class="footer-links" aria-label="Footer navigation">
			<a href="/work">Work</a>
			<a href="/experience">Experience</a>
			<a href="/technology">Technology</a>
			<a href="/about">About Me</a>
		</nav>

		<div class="footer-external">
			<a href="https://alienxhomeassistant.alienxsmarthome.com" target="_blank" rel="noreferrer">Home Assistant ↗</a>
			<a href="https://github.com/AlienX420710/alienx-smarthome" target="_blank" rel="noreferrer">Source ↗</a>
		</div>
	</div>

	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} AlienX SmartHome</span>
		<span>Built with Astro · Deployed on Cloudflare</span>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		border-top: 1px solid rgb(var(--gray-light));
		background: rgba(var(--gray-light), 0.18);
		color: rgb(var(--gray));
	}

	.footer-inner,
	.footer-bottom {
		width: min(1200px, calc(100% - 2em));
		margin: auto;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		gap: 3rem;
		padding: 3.5rem 1rem;
	}

	.footer-brand .wordmark {
		color: rgb(var(--black));
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-decoration: none;
	}

	.wordmark span {
		color: var(--accent);
	}

	.footer-brand p {
		max-width: 25rem;
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.footer-links,
	.footer-external {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.footer-links a,
	.footer-external a {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.footer-links a:hover,
	.footer-external a:hover {
		color: rgb(var(--black));
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.75rem;
	}

	@media (max-width: 900px) {
		.footer-inner {
			grid-template-columns: 1.25fr 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 720px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1.5rem;
			padding: 2.5rem 0.75rem;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}

		.footer-bottom {
			flex-direction: column;
			padding-inline: 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.footer-brand,
		.footer-links,
		.footer-external {
			grid-column: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-links a,
		.footer-external a {
			transition: none;
		}
	}
</style>
