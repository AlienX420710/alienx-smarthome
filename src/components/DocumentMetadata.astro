---
interface Props {
  title: string;
  description: string;
  canonicalURL: URL;
  imageURL: URL;
  imageAlt: string;
  canonical?: boolean;
  robots?: string;
  viewport?: string;
  themeColor?: string;
  referrer?: string;
  siteName?: string;
  locale?: string;
  titleMeta?: boolean;
  secureImage?: boolean;
  imageType?: string;
  imageWidth?: string;
  imageHeight?: string;
  twitterProperty?: boolean;
  twitterURL?: boolean;
  icons: Array<{ rel: string; href: string; type?: string; sizes?: string }>;
  fonts: Array<{ href: string; type: string }>;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description,
  canonicalURL,
  imageURL,
  imageAlt,
  canonical = true,
  robots,
  viewport = 'width=device-width, initial-scale=1',
  themeColor,
  referrer,
  siteName,
  locale,
  titleMeta = false,
  secureImage = false,
  imageType,
  imageWidth,
  imageHeight,
  twitterProperty = false,
  twitterURL = false,
  icons,
  fonts,
  structuredData,
} = Astro.props;
const twitterAttribute = twitterProperty ? 'property' : 'name';
const twitter = [
  ['twitter:card', 'summary_large_image'],
  ...(twitterURL ? [['twitter:url', canonicalURL.toString()]] : []),
  ['twitter:title', title],
  ['twitter:description', description],
  ['twitter:image', imageURL.toString()],
  ['twitter:image:alt', imageAlt],
];
---

<meta charset="utf-8" />
<meta name="viewport" content={viewport} />
<meta name="generator" content={Astro.generator} />
{themeColor && <meta name="theme-color" content={themeColor} />}
{robots && <meta name="robots" content={robots} />}
{referrer && <meta name="referrer" content={referrer} />}
<slot name="early" />
{icons.map((icon) => (
  <link {...icon} />
))}
{fonts.map((font) => (
  <link rel="preload" href={font.href} as="font" type={font.type} crossorigin />
))}
{canonical && <link rel="canonical" href={canonicalURL} />}
<title>{title}</title>
{titleMeta && <meta name="title" content={title} />}
<meta name="description" content={description} />
<meta property="og:type" content="website" />
{siteName && <meta property="og:site_name" content={siteName} />}
{locale && <meta property="og:locale" content={locale} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{secureImage && <meta property="og:image:secure_url" content={imageURL} />}
{imageType && <meta property="og:image:type" content={imageType} />}
{imageWidth && <meta property="og:image:width" content={imageWidth} />}
{imageHeight && <meta property="og:image:height" content={imageHeight} />}
<meta property="og:image:alt" content={imageAlt} />
{twitter.map(([key, content]) => (
  <meta {...{ [twitterAttribute]: key }} content={content} />
))}
{structuredData && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  ></script>
)}
