---
interface Props {
  name?: string;
}
const { name = 'faxNumber' } = Astro.props;
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAEpKpAcymsk9J_-A';
---

<div id="alienx-turnstile" data-sitekey={siteKey}></div>
<div class="honeypot" aria-hidden="true">
  <label for={`hp-${name}`}>Leave this field empty</label><input
    id={`hp-${name}`}
    name={name}
    type="text"
    tabindex="-1"
    autocomplete="off"
    inputmode="none"
  />
</div>
<script is:inline src="/contact-security.js"></script>
<style>
  #alienx-turnstile {
    margin: 0 0 1.25rem;
  }
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .honeypot input {
    position: absolute;
    left: -9999px;
  }
</style>
