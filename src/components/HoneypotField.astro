---
interface Props {
  name?: string;
}

const { name = 'website' } = Astro.props;
---

<div class="honeypot" aria-hidden="true">
  <label for={`hp-${name}`}>Leave this field empty</label>
  <input
    id={`hp-${name}`}
    name={name}
    type="text"
    tabindex="-1"
    autocomplete="off"
  />
</div>

<style>
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .honeypot input {
    position: absolute;
    left: -9999px;
  }
</style>
