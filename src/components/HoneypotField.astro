---
interface Props { name?: string; }
const { name = 'websiteTrap' } = Astro.props;
---
<div id="alienx-turnstile" data-sitekey="0x4AAAAAAEpKpAcymsk9J_-A"></div>
<div class="honeypot" aria-hidden="true"><label for={`hp-${name}`}>Leave this field empty</label><input id={`hp-${name}`} name={name} type="text" tabindex="-1" autocomplete="off" /></div>
<script is:inline>
(()=>{
	const renderTurnstile=()=>{
		const container=document.querySelector('#alienx-turnstile');
		if(!container||!window.turnstile)return;
		if(window.__alienxTurnstileWidgetId){try{window.turnstile.remove(window.__alienxTurnstileWidgetId)}catch{}window.__alienxTurnstileWidgetId=null}
		container.innerHTML='';
		window.__alienxTurnstileWidgetId=window.turnstile.render(container,{sitekey:container.dataset.sitekey,action:'contact',theme:'auto',size:'flexible','response-field-name':'website','refresh-expired':'auto','refresh-timeout':'auto','callback':()=>{container.dataset.state='success'},'expired-callback':()=>{container.dataset.state='expired'},'error-callback':()=>{container.dataset.state='error'}});
	};
	if(!window.__alienxTurnstileBound){
		window.__alienxTurnstileBound=true;
		window.alienxTurnstileLoad=renderTurnstile;
		document.addEventListener('astro:page-load',renderTurnstile);
	}
	renderTurnstile();
	window.setInterval(()=>{
		const widgetId=window.__alienxTurnstileWidgetId;
		if(!widgetId||!window.turnstile)return;
		try{if(window.turnstile.isExpired(widgetId))window.turnstile.reset(widgetId)}catch{}
	},240000);
})();
</script>
<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=alienxTurnstileLoad"></script>
<style>#alienx-turnstile{margin:0 0 1.25rem}.honeypot{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}.honeypot input{position:absolute;left:-9999px}</style>
