<div class="palette" id="alienx-palette" hidden><div class="palette__backdrop" data-palette-close></div><section class="palette__panel" role="dialog" aria-modal="true" aria-labelledby="palette-title" aria-describedby="palette-hint"><div class="palette__top"><span id="palette-title">ALIENX COMMAND</span><kbd>ESC</kbd></div><input id="palette-input" type="search" placeholder="Jump to a page or command..." aria-label="Search AlienX commands" aria-controls="palette-results" autocomplete="off" /><div class="palette__results" id="palette-results" role="listbox" aria-label="Command results" aria-live="polite"></div><div class="palette__hint" id="palette-hint">Press <kbd>Cmd K</kbd> / <kbd>Ctrl K</kbd> anywhere</div></section></div>
<script>
const root=document.querySelector('#alienx-palette'),input=document.querySelector('#palette-input'),results=document.querySelector('#palette-results');const items=[['Home','/'],['Work','/work'],['Experience','/experience'],['Technology','/technology'],['Status','/status'],['About Me','/about'],['Start a project','/contact']];let active=0;let previousFocus=null;
const getLinks=()=>results?[...results.querySelectorAll('a')]:[];
const render=()=>{if(!results)return;const q=input?.value.toLowerCase().trim()??'';const filtered=items.filter(([name,href])=>`${name} ${href}`.toLowerCase().includes(q));active=Math.min(active,Math.max(0,filtered.length-1));results.innerHTML=filtered.map(([name,href],i)=>`<a id="palette-result-${i}" class="palette__item${i===active?' is-active':''}" href="${href}" data-astro-reload role="option" aria-selected="${i===active}"><span>${name}</span><small>${href}</small></a>`).join('')||'<div class="palette__empty" role="option" aria-selected="false">No matching command.</div>';if(input)input.setAttribute('aria-activedescendant',filtered.length?`palette-result-${active}`:'')};
const open=()=>{if(!root)return;previousFocus=document.activeElement;root.hidden=false;active=0;input?.focus();input?.select();render()};
const close=()=>{if(!root||root.hidden)return;root.hidden=true;if(previousFocus instanceof HTMLElement)previousFocus.focus();previousFocus=null};
const trapFocus=e=>{if(root?.hidden||e.key!=='Tab')return;const focusable=[input,...getLinks()].filter((el):el is HTMLElement=>el instanceof HTMLElement&&!el.hasAttribute('disabled'));if(!focusable.length){e.preventDefault();return}const first=focusable[0],last=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}};
document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open();return}if(root?.hidden)return;if(e.key==='Escape'){e.preventDefault();close();return}trapFocus(e);const links=getLinks();if(e.key==='ArrowDown'&&links.length){e.preventDefault();active=Math.min(active+1,links.length-1);render();links[active]?.scrollIntoView({block:'nearest'})}if(e.key==='ArrowUp'&&links.length){e.preventDefault();active=Math.max(active-1,0);render();links[active]?.scrollIntoView({block:'nearest'})}if(e.key==='Enter'&&links[active]){e.preventDefault();links[active].click()}});input?.addEventListener('input',()=>{active=0;render()});root?.addEventListener('click',e=>{if(e.target instanceof HTMLElement&&e.target.hasAttribute('data-palette-close'))close()});
const syncSystem=async()=>{const el=document.querySelector('.system-panel .status');if(!el)return;try{const r=await fetch('/api/status',{cache:'no-store'}),d=await r.json();el.innerHTML=`<i></i> ${d.status==='operational'?'ONLINE':'DEGRADED'}`;el.dataset.state=d.status}catch{el.innerHTML='<i></i> OFFLINE';el.dataset.state='offline'}};document.addEventListener('astro:page-load',syncSystem);syncSystem();render();
</script>
<style>.palette[hidden]{display:none}.palette{position:fixed;inset:0;z-index:1000;display:grid;place-items:start center;padding:12vh 1rem}.palette__backdrop{position:absolute;inset:0;background:rgba(2,5,10,.72);backdrop-filter:blur(8px)}.palette__panel{position:relative;width:min(640px,100%);overflow:hidden;border:1px solid #26314a;border-radius:20px;background:#0b101b;box-shadow:0 40px 100px rgba(0,0,0,.55)}.palette__top{display:flex;justify-content:space-between;padding:1rem 1.1rem;font-size:.65rem;letter-spacing:.16em;color:#8e9ab0}.palette kbd{padding:.2rem .4rem;border:1px solid #303b53;border-radius:5px;font:inherit}.palette input{box-sizing:border-box;width:100%;padding:1rem 1.1rem;border:0;border-top:1px solid #1c2537;border-bottom:1px solid #1c2537;outline:0;background:#080c14;color:#f4f7ff;font:inherit}.palette__results{max-height:360px;overflow:auto;padding:.5rem}.palette__item{display:flex;justify-content:space-between;padding:.8rem .9rem;border-radius:10px;color:#e9edf7;text-decoration:none}.palette__item small{color:#7f8aa0}.palette__item:hover,.palette__item.is-active{background:rgba(57,255,90,.1);color:#dfffe5}.palette__empty{padding:1.5rem;color:#7f8aa0;text-align:center}.palette__hint{padding:.75rem 1rem;border-top:1px solid #1c2537;color:#7f8aa0;font-size:.75rem}</style>
