<div class="palette" id="alienx-palette" hidden>
  <div class="palette__backdrop" data-palette-close></div>
  <section class="palette__panel" role="dialog" aria-modal="true" aria-labelledby="palette-title" aria-describedby="palette-hint">
    <div class="palette__top"><span id="palette-title">ALIENX COMMAND</span><kbd>ESC</kbd></div>
    <input id="palette-input" type="search" placeholder="Jump to a page or run a command..." aria-label="Search AlienX commands" aria-controls="palette-results" autocomplete="off" />
    <div class="palette__results" id="palette-results" role="listbox" aria-label="Command results" aria-live="polite"></div>
    <div class="palette__hint" id="palette-hint">Press <kbd>Cmd K</kbd> / <kbd>Ctrl K</kbd> anywhere · arrows to navigate · Enter to run</div>
  </section>
</div>
<script>
  type Command = { name:string; description:string; keywords:string; run:()=>void|Promise<void> };
  const go=(href:string)=>{window.location.href=href};
  const pages:Command[]=[
    {name:'Home',description:'Open homepage',keywords:'home /',run:()=>go('/')},{name:'Work',description:'Open selected work',keywords:'work projects /work',run:()=>go('/work')},{name:'Experience',description:'Open browser experiments',keywords:'experience experiments /experience',run:()=>go('/experience')},{name:'Technology',description:'Open engineering stack',keywords:'technology stack /technology',run:()=>go('/technology')},{name:'Status',description:'Open live system status',keywords:'status health /status',run:()=>go('/status')},{name:'About Me',description:'Open the about page',keywords:'about /about',run:()=>go('/about')},{name:'Start a project',description:'Open the project inquiry form',keywords:'contact inquiry project /contact',run:()=>go('/contact')}
  ];
  let active=0,previousFocus:Element|null=null,commands:Command[]=[];
  const root=()=>document.querySelector<HTMLElement>('#alienx-palette'); const input=()=>document.querySelector<HTMLInputElement>('#palette-input'); const results=()=>document.querySelector<HTMLElement>('#palette-results'); const links=()=>results()?[...results()!.querySelectorAll<HTMLAnchorElement>('a[data-command-index]')]:[];
  const notify=(message:string)=>{let toast=document.querySelector<HTMLElement>('#alienx-command-toast');if(!toast){toast=document.createElement('div');toast.id='alienx-command-toast';toast.className='palette__toast';toast.setAttribute('role','status');document.body.append(toast)}toast.textContent=message;toast.hidden=false;window.setTimeout(()=>{if(toast)toast.hidden=true},2400)};
  const overlay=(title:string,content:string)=>{let el=document.querySelector<HTMLElement>('#alienx-command-overlay');if(!el){el=document.createElement('div');el.id='alienx-command-overlay';el.className='palette__overlay';document.body.append(el)}el.innerHTML='<div class="palette__overlay-backdrop" data-command-overlay-close></div><section class="palette__overlay-panel" role="dialog" aria-modal="true" aria-labelledby="command-overlay-title"><div class="palette__overlay-head"><strong id="command-overlay-title"></strong><button type="button" data-command-overlay-close aria-label="Close">ESC</button></div><div class="palette__overlay-content"></div></section>';el.querySelector<HTMLElement>('#command-overlay-title')!.textContent=title;el.querySelector<HTMLElement>('.palette__overlay-content')!.textContent=content;el.hidden=false};
  const closeOverlay=()=>{const el=document.querySelector<HTMLElement>('#alienx-command-overlay');if(el)el.hidden=true};
  const render=()=>{const i=input(),r=results();if(!r)return;const q=i?.value.toLowerCase().trim()??'';const filtered=commands.filter(c=>`${c.name} ${c.description} ${c.keywords}`.toLowerCase().includes(q));active=Math.min(active,Math.max(0,filtered.length-1));r.innerHTML=filtered.map((c,n)=>`<a id="palette-result-${n}" data-command-index="${commands.indexOf(c)}" class="palette__item${n===active?' is-active':''}" href="#" role="option" aria-selected="${n===active}"><span><strong>${c.name}</strong><small>${c.description}</small></span><kbd>↵</kbd></a>`).join('')||'<div class="palette__empty" role="option" aria-selected="false">No matching command.</div>';i?.setAttribute('aria-activedescendant',filtered.length?`palette-result-${active}`:'')};
  const close=()=>{const r=root();if(!r||r.hidden)return;r.hidden=true;closeOverlay();if(previousFocus instanceof HTMLElement)previousFocus.focus();previousFocus=null};
  const open=()=>{const r=root(),i=input();if(!r)return;previousFocus=document.activeElement;r.hidden=false;active=0;render();i?.focus();i?.select()};
  const refreshCommands=()=>{const runtime:Command[]=[
    {name:'/help',description:'Show every available command',keywords:'help commands ?',run:()=>overlay('ALIENX COMMANDS',commands.map(c=>`${c.name} — ${c.description}`).join('\n'))},
    {name:'/build',description:'Inspect the current production build',keywords:'build deploy production',run:async()=>{try{const t=performance.now(),r=await fetch('/api/status',{cache:'no-store'}),d=await r.json();overlay('BUILD // PRODUCTION',`Site: AlienX SmartHome\nRuntime: ${d.runtime??'Cloudflare Workers'}\nEndpoint: /api/status\nStatus: ${d.status??'unknown'}\nChecked: ${d.generatedAt??'unknown'}\nRequest ID: ${d.requestId??'unknown'}\nProbe: ${Math.round(performance.now()-t)} ms`)}catch{overlay('BUILD // PRODUCTION','The production status endpoint could not be reached.')}}},
    {name:'/version',description:'Show public-safe runtime and platform information',keywords:'version runtime platform',run:()=>overlay('VERSION // RUNTIME',`AlienX SmartHome\nRuntime: Cloudflare Workers\nBrowser: ${navigator.userAgent}\nPlatform: ${navigator.platform}\nLanguage: ${navigator.language}`)},
    {name:'/diagnostics',description:'Run live production diagnostics',keywords:'diagnostics debug checks',run:async()=>{try{const t=performance.now(),r=await fetch('/api/status',{cache:'no-store'}),d=await r.json(),lines=Object.entries(d.checks??{}).map(([n,c])=>`${n}: ${(c as {status?:string}).status??'unknown'} — ${(c as {detail?:string}).detail??''}`);overlay('DIAGNOSTICS // LIVE',[`HTTP: ${r.status}`,`RTT: ${Math.round(performance.now()-t)} ms`,`Overall: ${d.status??'unknown'}`,...lines].join('\n'))}catch{overlay('DIAGNOSTICS // LIVE','Production diagnostics failed: /api/status was unreachable.')}}},
    {name:'/security',description:'Show the public security surface',keywords:'security turnstile resend policy vulnerability',run:async()=>{try{const d=await(await fetch('/api/status',{cache:'no-store'})).json();overlay('SECURITY // SURFACE',`Turnstile: ${d.checks?.turnstile?.status??'unknown'}\nResend: ${d.checks?.resend?.status??'unknown'}\nRequest protection: production inquiry endpoint\nReporting: SECURITY.md\nNo secrets are exposed by this command.`)}catch{overlay('SECURITY // SURFACE','Security status is currently unavailable.')}}},
    {name:'/source',description:'Open the AlienX SmartHome source repository',keywords:'source github code repository repo',run:()=>window.open('https://github.com/AlienX420710/alienx-smarthome','_blank','noopener,noreferrer')},
    {name:'/ping',description:'Measure browser-to-production API round trip',keywords:'ping latency rtt network',run:async()=>{const t=performance.now();try{const r=await fetch('/api/status',{cache:'no-store'});notify(`PING ${r.ok?'OK':'HTTP '+r.status} · ${Math.round(performance.now()-t)} ms`)}catch{notify('PING FAILED · production endpoint unreachable')}}},
    {name:'/health',description:'Alias for live system health',keywords:'health status online operational',run:()=>go('/status')},
    {name:'/inspect',description:'Inspect the current page and browser context',keywords:'inspect page document url title performance',run:()=>{const n=performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming|undefined;overlay('INSPECT // PAGE',`Path: ${location.pathname}\nTitle: ${document.title}\nViewport: ${innerWidth} × ${innerHeight}\nDevice pixel ratio: ${devicePixelRatio}\nNavigation: ${n?Math.round(n.duration)+' ms':'n/a'}\nOnline: ${navigator.onLine?'yes':'no'}`)}},
    {name:'/network',description:'Inspect browser network capabilities',keywords:'network connection online downlink effective type',run:()=>{const c=(navigator as Navigator&{connection?:{effectiveType?:string;downlink?:number;rtt?:number;saveData?:boolean}}).connection;overlay('NETWORK // BROWSER',`Online: ${navigator.onLine?'yes':'no'}\nConnection: ${c?.effectiveType??'unavailable'}\nDownlink: ${c?.downlink!=null?c.downlink+' Mbps':'unavailable'}\nRTT hint: ${c?.rtt!=null?c.rtt+' ms':'unavailable'}\nSave-data: ${c?.saveData?'on':'off'}`)}},
    {name:'/technology --stack',description:'Show the public technology stack',keywords:'technology stack astro typescript cloudflare turnstile resend github',run:()=>overlay('TECHNOLOGY // STACK','Astro 7\nTypeScript 5.9\nCloudflare Workers\nCloudflare KV sessions\nCloudflare Images\nCloudflare Turnstile\nResend\nGitHub Actions\nCSS + browser APIs')},
    {name:'/matrix',description:'Open the AlienX matrix visual',keywords:'matrix visual terminal',run:()=>overlay('MATRIX // VISUAL','SIGNAL ACQUIRED\n\n01000001 01001100 01001001 01000101 01001110 01011000\n\nDecorative interface only. No systems are being accessed.')},
    {name:'/konami',description:'Enable the AlienX easter egg',keywords:'konami easter egg up down left right',run:()=>{document.documentElement.dataset.alienxKonami='true';notify('KONAMI // EASTER EGG ENABLED')}},
    {name:'/motion',description:'Toggle site motion on or off',keywords:'motion animation reduced movement',run:()=>{const off=document.documentElement.dataset.alienxMotion==='off';document.documentElement.dataset.alienxMotion=off?'on':'off';localStorage.setItem('alienx-motion',off?'on':'off');notify(`MOTION // ${off?'ON':'OFF'}`)}},
    {name:'/theme',description:'Cycle system, light, and dark theme',keywords:'theme light dark system appearance',run:()=>{const current=document.documentElement.dataset.alienxTheme??'system',next=current==='system'?'light':current==='light'?'dark':'system';if(next==='system')delete document.documentElement.dataset.alienxTheme;else document.documentElement.dataset.alienxTheme=next;localStorage.setItem('alienx-theme',next);notify(`THEME // ${next.toUpperCase()}`)}},
    {name:'/clear',description:'Clear the command input',keywords:'clear reset search',run:()=>{const i=input();if(i){i.value='';active=0;render();i.focus()}}},
    {name:'/refresh',description:'Reload the current page',keywords:'refresh reload',run:()=>location.reload()}
  ]; commands=[...runtime,...pages]};
  const trap=(e:KeyboardEvent)=>{const r=root();if(r?.hidden||e.key!=='Tab')return;const f=[input(),...links()].filter((x):x is HTMLElement=>x instanceof HTMLElement);if(!f.length){e.preventDefault();return}const first=f[0],last=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}};
  const key=(e:KeyboardEvent)=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open();return}if(e.key==='Escape'){if(!root()?.hidden){e.preventDefault();close()}closeOverlay();return}if(root()?.hidden)return;trap(e);const l=links();if(e.key==='ArrowDown'&&l.length){e.preventDefault();active=Math.min(active+1,l.length-1);render();links()[active]?.scrollIntoView({block:'nearest'})}if(e.key==='ArrowUp'&&l.length){e.preventDefault();active=Math.max(active-1,0);render();links()[active]?.scrollIntoView({block:'nearest'})}if(e.key==='Enter'&&l[active]){e.preventDefault();l[active].click()}};
  const click=(e:MouseEvent)=>{if(!(e.target instanceof HTMLElement))return;if(e.target.closest('[data-palette-close]')){close();return}if(e.target.closest('[data-command-overlay-close]')){closeOverlay();return}const l=e.target.closest<HTMLAnchorElement>('a[data-command-index]');if(!l)return;e.preventDefault();const c=commands[Number(l.dataset.commandIndex)];if(c){close();void c.run()}};
  const prefs=()=>{const t=localStorage.getItem('alienx-theme');if(t==='light'||t==='dark')document.documentElement.dataset.alienxTheme=t;const m=localStorage.getItem('alienx-motion');if(m==='off'||m==='on')document.documentElement.dataset.alienxMotion=m};
  document.addEventListener('keydown',key);document.addEventListener('input',()=>{active=0;render()});document.addEventListener('click',click);document.addEventListener('astro:page-load',()=>{prefs();refreshCommands();active=0;render()});prefs();refreshCommands();render();
</script>
<style is:global>
  .palette[hidden],.palette__overlay[hidden],.palette__toast[hidden]{display:none}.palette{position:fixed;inset:0;z-index:1000;display:grid;place-items:start center;padding:12vh 1rem}.palette__backdrop,.palette__overlay-backdrop{position:absolute;inset:0;background:rgba(2,5,10,.72);backdrop-filter:blur(8px)}.palette__panel{position:relative;width:min(680px,100%);overflow:hidden;border:1px solid #26314a;border-radius:20px;background:#0b101b;box-shadow:0 40px 100px rgba(0,0,0,.55)}.palette__top,.palette__overlay-head{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.1rem;font-size:.65rem;letter-spacing:.16em;color:#8e9ab0}.palette kbd,.palette__overlay-head button{padding:.2rem .4rem;border:1px solid #303b53;border-radius:5px;background:transparent;color:inherit;font:inherit}.palette input{box-sizing:border-box;width:100%;padding:1rem 1.1rem;border:0;border-top:1px solid #1c2537;border-bottom:1px solid #1c2537;outline:0;background:#080c14;color:#f4f7ff;font:inherit}.palette__results{max-height:430px;overflow:auto;padding:.5rem}.palette__item{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.75rem .9rem;border-radius:10px;color:#e9edf7;text-decoration:none}.palette__item span{display:grid;gap:.1rem}.palette__item small{color:#7f8aa0;font-size:.72rem}.palette__item:hover,.palette__item.is-active{background:rgba(57,255,90,.1);color:#dfffe5}.palette__empty{padding:1.5rem;color:#7f8aa0;text-align:center}.palette__hint{padding:.75rem 1rem;border-top:1px solid #1c2537;color:#7f8aa0;font-size:.75rem}.palette__overlay,.palette__toast{position:fixed;z-index:1001}.palette__overlay{inset:0;display:grid;place-items:center;padding:1rem}.palette__overlay-panel{position:relative;width:min(680px,100%);max-height:80vh;overflow:auto;border:1px solid #26314a;border-radius:20px;background:#080c14;color:#e9edf7;box-shadow:0 40px 100px rgba(0,0,0,.6)}.palette__overlay-content{white-space:pre-wrap;padding:0 1.1rem 1.2rem;color:#aab5c8;font:.82rem/1.8 ui-monospace,SFMono-Regular,Menlo,monospace}.palette__toast{right:1rem;bottom:1rem;max-width:calc(100% - 2rem);padding:.7rem .9rem;border:1px solid #26314a;border-radius:10px;background:#0b101b;color:#dfffe5;box-shadow:0 15px 45px rgba(0,0,0,.45);font:.75rem ui-monospace,SFMono-Regular,Menlo,monospace}@media(max-width:600px){.palette{padding:7vh .65rem}.palette__results{max-height:55vh}}
</style>
