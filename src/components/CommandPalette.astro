---
const commandPalette = {
  siteName: 'AlienX SmartHome',
  helpTitle: 'ALIENX COMMANDS',
  sourceUrl: 'https://github.com/AlienX420710/alienx-smarthome',
  statusRoute: '/status',
  statusEndpoint: '/api/status',
  statusChecks: ['worker', 'inquiry', 'turnstile', 'resend'],
  securityChecks: [
    ['Turnstile', 'turnstile'],
    ['Resend', 'resend'],
  ],
  requestProtection: 'production inquiry endpoint',
  themeAttribute: 'data-alienx-theme',
  motionAttribute: 'data-alienx-motion',
  konamiAttribute: 'data-alienx-konami',
  themeSetter: '__alienxSetTheme',
  motionSetter: '__alienxSetMotion',
  toastId: 'alienx-command-toast',
  overlayId: 'alienx-command-overlay',
  inputId: 'palette-input',
  resultsId: 'palette-results',
  stack:
    'Astro 7\nTypeScript 6\nCloudflare Workers\nCloudflare Images\nCloudflare Turnstile\nResend\nGitHub Actions\nCSS + browser APIs',
  konamiStory:
    'LEVEL 01 · Windows 98 emulators and Super Mario 64\nLEVEL 02 · Game Boy, Wii and DS homebrew\nLEVEL 03 · Routers, DNS and wireless networks\nLEVEL 04 · Home Assistant, Docker and Unraid\nLEVEL 05 · VLANs and live websites\n\nRetro mode is on. Run /konami again to switch it off.',
  konamiLinks: [
    { label: 'Read the full journey', href: '/about' },
    { label: 'See what is live', href: '/status' },
  ],
  commands: [
    {
      name: '/help',
      description: 'Show every available command',
      keywords: 'help commands ?',
      action: 'help',
    },
    {
      name: '/build',
      description: 'Inspect the current production build',
      keywords: 'build deploy production',
      action: 'build',
    },
    {
      name: '/version',
      description: 'Show public-safe runtime and platform information',
      keywords: 'version runtime platform',
      action: 'version',
    },
    {
      name: '/diagnostics',
      description: 'Run live production diagnostics',
      keywords: 'diagnostics debug checks',
      action: 'diagnostics',
    },
    {
      name: '/security',
      description: 'Show the public security surface',
      keywords: 'security turnstile resend policy vulnerability',
      action: 'security',
    },
    {
      name: '/source',
      description: 'Open the AlienX SmartHome source repository',
      keywords: 'source github code repository repo',
      action: 'source',
    },
    {
      name: '/ping',
      description: 'Measure browser-to-production API round trip',
      keywords: 'ping latency rtt network',
      action: 'ping',
    },
    {
      name: '/health',
      description: 'Alias for live system health',
      keywords: 'health status online operational',
      action: 'health',
    },
    {
      name: '/inspect',
      description: 'Inspect the current page and browser context',
      keywords: 'inspect page document url title performance',
      action: 'inspect',
    },
    {
      name: '/network',
      description: 'Inspect browser network capabilities',
      keywords: 'network connection online downlink effective type',
      action: 'network',
    },
    {
      name: '/technology --stack',
      description: 'Show the public technology stack',
      keywords:
        'technology stack astro typescript cloudflare turnstile resend github',
      action: 'technology_stack',
    },
    {
      name: '/matrix',
      description: 'Watch ten seconds of green code rain',
      keywords: 'matrix movie code rain easter egg',
      action: 'matrix',
    },
    {
      name: '/konami',
      description: 'Toggle retro mode and open the origin story',
      keywords: 'konami easter egg up down left right',
      action: 'konami',
    },
    {
      name: '/motion',
      description: 'Toggle site motion on or off',
      keywords: 'motion animation reduced movement',
      action: 'motion',
    },
    {
      name: '/theme',
      description: 'Cycle system, light, and dark theme',
      keywords: 'theme light dark system appearance',
      action: 'theme',
    },
    {
      name: '/clear',
      description: 'Clear the command input',
      keywords: 'clear reset search',
      action: 'clear',
    },
    {
      name: '/refresh',
      description: 'Reload the current page',
      keywords: 'refresh reload',
      action: 'refresh',
    },
    {
      name: 'Home',
      description: 'Open homepage',
      keywords: 'home /',
      action: 'navigate',
      href: '/',
    },
    {
      name: 'Status',
      description: 'Open live system status',
      keywords: 'status health /status',
      action: 'navigate',
      href: '/status',
    },
    {
      name: 'About Me',
      description: 'Open the about page',
      keywords: 'about /about',
      action: 'navigate',
      href: '/about',
    },
    {
      name: 'Start a project',
      description: 'Open the project inquiry form',
      keywords: 'contact inquiry project /contact',
      action: 'navigate',
      href: '/contact',
    },
  ],
};
---

<dialog
  class="palette"
  data-command-palette={JSON.stringify(commandPalette)}
  id="alienx-palette"
  hidden
  aria-labelledby="palette-title"
  aria-describedby="palette-hint"
>
  <div class="palette__backdrop" data-palette-close></div>
  <section class="palette__panel">
    <div class="palette__top">
      <span id="palette-title">ALIENX COMMAND</span>
      <button
        type="button"
        class="palette__escape"
        data-palette-close
        aria-label="Close command palette"
      >
        ESC
      </button>
    </div>
    <input
      id="palette-input"
      type="search"
      placeholder="Jump to a page or run a command..."
      aria-label="Search AlienX commands"
      aria-controls="palette-results"
      autocomplete="off"
    />
    <div
      class="palette__results"
      id="palette-results"
      role="listbox"
      aria-label="Command results"
      aria-live="polite"
    ></div>
    <div class="palette__hint" id="palette-hint">
      Press <kbd>Cmd K</kbd> / <kbd>Ctrl K</kbd> anywhere · arrows to navigate ·
      Enter to run
    </div>
  </section>
</dialog>
<script is:inline type="module" src="/command-palette.js"></script>
<style is:global>
  .palette,
  .palette__overlay {
    margin: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    border: 0;
    background: transparent;
  }
  .palette::backdrop,
  .palette__overlay::backdrop {
    background: transparent;
  }
  .palette[hidden],
  .palette__overlay[hidden],
  .palette__toast[hidden] {
    display: none;
  }
  .palette {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: start center;
    padding: 12vh 1rem;
  }
  .palette__backdrop,
  .palette__overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 5, 10, 0.72);
    backdrop-filter: blur(8px);
  }
  .palette__panel {
    position: relative;
    width: min(680px, 100%);
    overflow: hidden;
    border: 1px solid #26314a;
    border-radius: 20px;
    background: #0b101b;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.55);
  }
  .palette__top,
  .palette__overlay-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.1rem;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    color: #8e9ab0;
  }
  .palette kbd,
  .palette__escape,
  .palette__overlay-head button {
    padding: 0.2rem 0.4rem;
    border: 1px solid #303b53;
    border-radius: 5px;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .palette__escape {
    cursor: pointer;
  }
  .palette__escape:focus-visible {
    outline: 2px solid #39ff5a;
    outline-offset: 2px;
  }
  .palette input {
    box-sizing: border-box;
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-top: 1px solid #1c2537;
    border-bottom: 1px solid #1c2537;
    outline: 0;
    background: #080c14;
    color: #f4f7ff;
    font: inherit;
  }
  .palette__results {
    max-height: 430px;
    overflow: auto;
    padding: 0.5rem;
  }
  .palette__item {
    width: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    color: #e9edf7;
    text-decoration: none;
  }
  .palette__item span {
    display: grid;
    gap: 0.1rem;
  }
  .palette__item small {
    color: #7f8aa0;
    font-size: 0.72rem;
  }
  .palette__item:hover,
  .palette__item.is-active {
    background: rgba(57, 255, 90, 0.1);
    color: #dfffe5;
  }
  .palette__empty {
    padding: 1.5rem;
    color: #7f8aa0;
    text-align: center;
  }
  .palette__hint {
    padding: 0.75rem 1rem;
    border-top: 1px solid #1c2537;
    color: #7f8aa0;
    font-size: 0.75rem;
  }
  .palette__overlay,
  .palette__toast {
    position: fixed;
    z-index: 1001;
  }
  .palette__overlay {
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .palette__overlay-panel {
    position: relative;
    width: min(680px, 100%);
    max-height: 80vh;
    overflow: auto;
    border: 1px solid #26314a;
    border-radius: 20px;
    background: #080c14;
    color: #e9edf7;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
  }
  .palette__overlay-content {
    white-space: pre-wrap;
    padding: 0 1.1rem 1.2rem;
    color: #aab5c8;
    font:
      0.82rem/1.8 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
  }
  .palette__overlay--matrix .palette__overlay-panel {
    width: min(900px, 100%);
    border-color: #1b7138;
    background: #000b03;
  }
  .palette__overlay--matrix .palette__overlay-content {
    color: #abffc0;
  }
  .palette__matrix-rain {
    display: block;
    width: 100%;
    height: min(55vh, 440px);
    margin-bottom: 1rem;
    background: #000500;
  }
  .palette__overlay-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0 1.1rem 1.2rem;
  }
  .palette__overlay-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border: 1px solid #3e8e58;
    border-radius: 8px;
    color: #dfffe5;
    text-decoration: none;
  }
  .palette__overlay-links a:hover,
  .palette__overlay-links a:focus-visible {
    background: #153321;
    outline: 2px solid #9fffb7;
    outline-offset: 2px;
  }
  .palette__toast {
    right: 1rem;
    bottom: 1rem;
    max-width: calc(100% - 2rem);
    padding: 0.7rem 0.9rem;
    border: 1px solid #26314a;
    border-radius: 10px;
    background: #0b101b;
    color: #dfffe5;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.45);
    font:
      0.75rem ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
  }
  @media (max-width: 600px) {
    .palette {
      padding: 7vh 0.65rem;
    }
    .palette__results {
      max-height: 55vh;
    }
  }
</style>
