---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Primary navigation">
		<a href="/" class="title-link" aria-label={`${SITE_TITLE} home`}>
			<img src="/favicon.svg" alt="" class="site-logo" width="28" height="28" />
			<span>{SITE_TITLE}</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/experience">Experience</HeaderLink>
			<HeaderLink href="/technology">Technology</HeaderLink>
			<HeaderLink href="/blog">Journal</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<a class="source-link" href="https://github.com/AlienX420710/alienx-smarthome" target="_blank" rel="noreferrer">
			<span>Source</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
				<path fill="currentColor" d="M12 .7A11.3 11.3 0 0 0 8.43 22.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.04.76 2.1v3.12c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" />
			</svg>
		</a>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0 20px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(5, 7, 12, 0.78);
		backdrop-filter: blur(18px) saturate(140%);
	}

	nav {
		width: min(1180px, 100%);
		min-height: 68px;
		margin: auto;
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.title-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		flex-shrink: 0;
		color: #f2f5ff;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.site-logo { flex-shrink: 0; }
	.internal-links {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.internal-links :global(a) {
		padding: 0.55rem 0.7rem;
		border: 1px solid transparent;
		border-radius: 999px;
		color: #8994ad;
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none;
		transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: #f2f5ff;
		border-color: #20283a;
		background: rgba(255, 255, 255, 0.04);
	}

	.source-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid #252d40;
		border-radius: 999px;
		color: #dce2f2;
		font-size: 0.76rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 160ms ease, border-color 160ms ease;
	}

	.source-link:hover { transform: translateY(-1px); border-color: #46516d; }

	@media (prefers-reduced-motion: reduce) { .internal-links :global(a), .source-link { transition: none; } }

	@media (max-width: 850px) {
		nav { gap: 1rem; }
		.internal-links { overflow-x: auto; scrollbar-width: none; }
		.internal-links::-webkit-scrollbar { display: none; }
		.source-link span { display: none; }
	}

	@media (max-width: 560px) {
		header { padding: 0 12px; }
		nav { min-height: 60px; }
		.title-link span { display: none; }
		.internal-links :global(a) { padding: 0.45rem 0.55rem; font-size: 0.7rem; }
	}
</style>
