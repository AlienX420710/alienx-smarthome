---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Primary navigation">
		<a href="/" class="title-link" aria-label={`${SITE_TITLE} home`}>
			<img src="/favicon.svg" alt="" class="site-logo" width="28" height="28" />
			<span><strong>AlienX</strong> <em>SmartHome</em></span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/experience">Experience</HeaderLink>
			<HeaderLink href="/technology">Technology</HeaderLink>
			<HeaderLink href="/about">About Me</HeaderLink>
			<HeaderLink href="/contact">Start a project</HeaderLink>
		</div>

		<div class="external-links">
			<a class="ha-link" href="https://alienxhomeassistant.alienxsmarthome.com" target="_blank" rel="noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m3 11 9-7 9 7" />
					<path d="M5.5 10.5V20h13v-9.5" />
					<path d="M9 20v-6h6v6" />
				</svg>
				<span>Home Assistant</span>
			</a>
			<a class="source-link" href="https://github.com/AlienX420710/alienx-smarthome" target="_blank" rel="noreferrer" aria-label="AlienX SmartHome source code on GitHub">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M15 22v-4.2c0-1.1-.4-1.8-1-2.2 3.3-.4 6.7-1.6 6.7-7.1 0-1.6-.6-2.9-1.6-3.9.2-.4.7-1.9-.2-3.9 0 0-1.3-.4-4.2 1.5-1.2-.3-2.5-.4-3.7-.4s-2.5.1-3.7.4C4.4.3 3.1.7 3.1.7c-.9 2-.4 3.5-.2 3.9-1 1-1.6 2.3-1.6 3.9 0 5.5 3.4 6.7 6.7 7.1-.6.4-1 .9-1 1.8V22" />
					<path d="M7 18c-3 .9-3-1.5-4.2-1.8" />
				</svg>
				<span>Source</span>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
	margin: 0;
	padding: 1.25rem 1.5rem;
}

nav {
	width: min(1400px, 100%);
	margin: 0 auto;
	display: flex;
	align-items: center;
	gap: 1.5rem;
}

.title-link {
	display: inline-flex;
	align-items: center;
	gap: 0.65rem;
	color: rgb(var(--black));
	font-weight: 700;
	text-decoration: none;
	white-space: nowrap;
}

.title-link strong {
	color: #39ff5a;
}

.title-link em {
	color: var(--accent);
	font-style: normal;
}

.site-logo {
	width: 28px;
	height: 28px;
}

.internal-links,
.external-links {
	display: flex;
	align-items: center;
	gap: 1rem;
}

.internal-links {
	margin-left: auto;
}

.external-links {
	margin-left: 0.5rem;
}

.ha-link,
.source-link {
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	color: rgb(var(--gray-dark));
	font-size: 0.9rem;
	text-decoration: none;
	opacity: 0.75;
	transition: opacity 180ms ease, color 180ms ease;
}

.ha-link:hover,
.ha-link:focus-visible {
	color: #39ff5a;
	opacity: 1;
}

.source-link:hover,
.source-link:focus-visible {
	color: var(--accent);
	opacity: 1;
}

.ha-link svg,
.source-link svg {
	width: 1rem;
	height: 1rem;
	fill: none;
	stroke: currentColor;
	stroke-width: 1.8;
	stroke-linecap: round;
	stroke-linejoin: round;
	flex: 0 0 auto;
}

.source-link svg path:first-child {
	fill: currentColor;
	stroke: none;
}

.source-link svg path:last-child {
	stroke: currentColor;
}

@media (max-width: 1100px) {
	nav {
		gap: 1rem;
	}

	.internal-links,
	.external-links {
		gap: 0.7rem;
	}
}

@media (max-width: 900px) {
	nav {
		flex-wrap: wrap;
	}

	.internal-links {
		order: 3;
		width: 100%;
		justify-content: center;
		margin-left: 0;
		flex-wrap: wrap;
		padding-top: 0.25rem;
	}

	.external-links {
		margin-left: auto;
	}
}

@media (max-width: 600px) {
	header {
		padding: 1rem;
	}

	.title-link span {
		font-size: 0.95rem;
	}

	.internal-links {
		justify-content: flex-start;
		gap: 0.45rem 0.85rem;
	}

	.internal-links :global(a) {
		font-size: 0.9rem;
	}

	.external-links {
		gap: 0.65rem;
	}

	.ha-link span,
	.source-link span {
		display: none;
	}
}

@media (prefers-reduced-motion: reduce) {
	.ha-link,
	.source-link {
		transition: none;
	}
}
</style>
