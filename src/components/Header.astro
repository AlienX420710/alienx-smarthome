---
import HeaderLink from './HeaderLink.astro';
import CommandPalette from './CommandPalette.astro';
import { SITE_TITLE } from '../consts';
---
<header><nav aria-label="Primary navigation"><a href="/" class="title-link" aria-label={`${SITE_TITLE} home`}><img src="/favicon.svg" alt="" class="site-logo" width="28" height="28" /><span><strong>AlienX</strong> <em>SmartHome</em></span></a><div class="internal-links"><HeaderLink href="/">Home</HeaderLink><HeaderLink href="/work">Work</HeaderLink><HeaderLink href="/experience" data-astro-reload>Experience</HeaderLink><HeaderLink href="/technology">Technology</HeaderLink><HeaderLink href="/status" data-astro-reload>Status</HeaderLink><HeaderLink href="/about">About Me</HeaderLink><HeaderLink href="/contact">Start a project</HeaderLink></div><div class="external-links"><button class="command" type="button" onclick="document.dispatchEvent(new KeyboardEvent('keydown',{key:'k',metaKey:true,ctrlKey:true}))" aria-label="Open command palette">⌘K</button><a class="ha-link" href="https://alienxhomeassistant.alienxsmarthome.com" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-7 9 7"/><path d="M5.5 10.5V20h13v-9.5"/><path d="M9 20v-6h6v6"/></svg><span>Home Assistant</span></a><a class="source-link" href="https://github.com/AlienX420710/alienx-smarthome" target="_blank" rel="noreferrer" aria-label="AlienX SmartHome source code on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4.2c0-1.1-.4-1.8-1-2.2 3.3-.4 6.7-1.6 6.7-7.1 0-1.6-.6-2.9-1.6-3.9-1.2-.3-2.5-.4-3.7-.4s-2.5.1-3.7.4C4.4.3 3.1.7 3.1.7c-.9 2-.4 3.5-.2 3.9-1 1-1.6 1.8-1 3.9 0 5.5 3.4 6.7 6.7 7.1-.6.4-1 .9-1 1.8V22"/><path d="M7 18c-3 .9-3-1.5-4.2-1.8"/></svg><span>Source</span></a></div></nav></header><CommandPalette />
<style>
header{margin:0;padding:1rem 1.5rem;font-family:"Atkinson",sans-serif;font-size:20px;line-height:1.2}nav{width:min(1400px,100%);margin:0 auto;display:flex;align-items:center;gap:1.5rem}.title-link{display:inline-flex;align-items:center;gap:.65rem;color:rgb(var(--black));font-weight:700;text-decoration:none;white-space:nowrap}.title-link strong{color:var(--brand-green)}.title-link em{color:var(--accent);font-style:normal}.site-logo{width:28px;height:28px}.internal-links,.external-links{display:flex;align-items:center;gap:1rem}.internal-links{margin-left:auto}.external-links{margin-left:.5rem}.ha-link,.source-link{display:inline-flex;align-items:center;gap:.35rem;color:rgb(var(--gray-dark));font-size:.9rem;text-decoration:none;opacity:.75;transition:opacity 180ms ease,color 180ms ease}.ha-link:hover,.ha-link:focus-visible{color:var(--brand-green);opacity:1}.source-link:hover,.source-link:focus-visible{color:var(--accent);opacity:1}.ha-link svg,.source-link svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}.source-link svg path:first-child{fill:currentColor;stroke:none}.source-link svg path:last-child{stroke:currentColor}.command{border:1px solid #c8d0df;border-radius:7px;padding:.3rem .45rem;background:transparent;color:rgb(var(--gray-dark));font:12px ui-monospace,monospace;cursor:pointer}.command:hover{border-color:var(--brand-green);color:var(--brand-green)}@media(max-width:1100px){nav{gap:1rem}.internal-links,.external-links{gap:.7rem}}@media(max-width:900px){nav{flex-wrap:wrap}.internal-links{order:3;width:100%;justify-content:center;margin-left:0;flex-wrap:wrap;padding-top:.25rem}.external-links{margin-left:auto}}@media(max-width:600px){header{padding:.85rem 1rem}.title-link{min-height:44px}.title-link span{font-size:.95rem}.internal-links{justify-content:flex-start;gap:.45rem .85rem;flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;overscroll-behavior-x:contain;scroll-snap-type:x proximity;padding:.4rem 0 .25rem}.internal-links::-webkit-scrollbar{display:none}.internal-links :global(a){flex:0 0 auto;min-height:44px;display:inline-flex;align-items:center;scroll-snap-align:start}.command{min-width:44px;min-height:44px;padding:.3rem}.ha-link,.source-link{min-width:44px;min-height:44px;justify-content:center}.external-links{gap:.35rem}.ha-link span,.source-link span{display:none}}@media(prefers-reduced-motion:reduce){.ha-link,.source-link{transition:none}.internal-links{scroll-behavior:auto}}
:global(html[data-alienx-theme="light"][data-alienx-page="technology"] body){--tech-bg:#f7f9fc!important;--tech-text:#253047!important;--tech-heading:#0d1420!important;--tech-muted:#46566f!important;--tech-soft:#52627a!important;--tech-border:#c8d1df!important;--tech-border-strong:#aeb9c9!important;background:radial-gradient(circle at var(--page-gradient-x) 0,rgba(83,101,219,.07),transparent 34rem),#f7f9fc!important;color:#253047!important}
:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .hero h1),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .section-heading h2),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .map-core strong),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .map-node strong){color:#0d1420!important}
:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .eyebrow),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .hero-tags span),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .tech-strip span){color:#52627a!important}
:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .lede),:global(html[data-alienx-theme="light"][data-alienx-page="technology"] .section-heading>p:last-child){color:#46566f!important}
:global(html[data-alienx-page="status"] .hero-copy){min-width:0}
@media(max-width:520px){:global(html[data-alienx-page="status"] .hero h1){font-size:clamp(2.6rem,13vw,5.5rem);max-width:100%;overflow-wrap:anywhere}}
@media(prefers-color-scheme:light){:global(html:not([data-alienx-theme="dark"])[data-alienx-page="technology"] body){--tech-bg:#f7f9fc!important;--tech-text:#253047!important;--tech-heading:#0d1420!important;--tech-muted:#46566f!important;--tech-soft:#52627a!important;--tech-border:#c8d1df!important;--tech-border-strong:#aeb9c9!important;background:radial-gradient(circle at var(--page-gradient-x) 0,rgba(83,101,219,.07),transparent 34rem),#f7f9fc!important;color:#253047!important}}
</style>
