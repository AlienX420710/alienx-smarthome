<section class="advanced-lab" aria-labelledby="advanced-lab-title">
  <div class="advanced-lab__intro">
    <p class="eyebrow">05 // DEEP LAB</p>
    <h2 id="advanced-lab-title">
      Push the platform before adding a framework.
    </h2>
    <p>
      Three experiments explore native state, inline SVG, intrinsic layout, and
      CSS perspective. JavaScript is used only where the browser needs a small
      bridge between input and presentation.
    </p>
  </div>

  <div class="advanced-lab__grid">
    <article class="telemetry-card">
      <div class="card-topline">
        <span>INLINE SVG</span>
        <span>ZERO CHART DEPENDENCY</span>
      </div>
      <h3>Signal telemetry</h3>
      <p>
        A compact responsive chart uses semantic SVG primitives, currentColor,
        and a real text description instead of importing a charting runtime.
      </p>
      <figure>
        <svg
          viewBox="0 0 600 220"
          role="img"
          aria-labelledby="signal-title signal-desc"
        >
          <title id="signal-title">AlienX signal telemetry</title>
          <desc id="signal-desc">
            A line graph rises and falls across eight samples, ending near its
            highest point.
          </desc>
          <g class="grid-lines" aria-hidden="true">
            <path d="M20 40H580 M20 90H580 M20 140H580 M20 190H580"></path>
          </g>
          <path
            class="signal-fill"
            d="M20 174 L100 145 L180 158 L260 103 L340 122 L420 69 L500 92 L580 48 L580 200 L20 200 Z"
          ></path>
          <path
            class="signal-line"
            d="M20 174 L100 145 L180 158 L260 103 L340 122 L420 69 L500 92 L580 48"
          ></path>
          <g class="signal-points" aria-hidden="true">
            <circle cx="20" cy="174" r="5"></circle>
            <circle cx="100" cy="145" r="5"></circle>
            <circle cx="180" cy="158" r="5"></circle>
            <circle cx="260" cy="103" r="5"></circle>
            <circle cx="340" cy="122" r="5"></circle>
            <circle cx="420" cy="69" r="5"></circle>
            <circle cx="500" cy="92" r="5"></circle>
            <circle cx="580" cy="48" r="5"></circle>
          </g>
        </svg>
        <figcaption>
          <span>LATENCY</span>
          <strong>18 ms</strong>
          <span>STABILITY</span>
          <strong>99.98%</strong>
        </figcaption>
      </figure>
    </article>

    <article class="native-meter-card">
      <div class="card-topline">
        <span>NATIVE STATE</span>
        <span>METER / PROGRESS</span>
      </div>
      <h3>System budget</h3>
      <p>
        Native progress semantics expose state directly to assistive technology
        while CSS supplies the visual system.
      </p>
      <div class="budget-row">
        <label for="runtime-budget">Runtime budget</label>
        <meter
          id="runtime-budget"
          min="0"
          max="100"
          low="35"
          high="75"
          optimum="20"
          value="28"
        >
          28 out of 100
        </meter>
        <span>28 / 100</span>
      </div>
      <div class="budget-row">
        <label for="delivery-progress">Delivery pipeline</label>
        <progress id="delivery-progress" max="100" value="84">
          84%
        </progress>
        <span>84%</span>
      </div>
    </article>
  </div>

  <fieldset class="perspective-lab">
    <legend>Perspective deck mode</legend>
    <div class="perspective-controls">
      <input type="radio" name="deck-mode" id="deck-interface" checked />
      <label for="deck-interface">Interface</label>
      <input type="radio" name="deck-mode" id="deck-system" />
      <label for="deck-system">System</label>
      <input type="radio" name="deck-mode" id="deck-edge" />
      <label for="deck-edge">Edge</label>
    </div>
    <div class="perspective-stage" aria-hidden="true">
      <div class="perspective-card perspective-card--back">
        <span>LAYER 03</span>
        <strong>EDGE</strong>
      </div>
      <div class="perspective-card perspective-card--middle">
        <span>LAYER 02</span>
        <strong>SYSTEM</strong>
      </div>
      <div class="perspective-card perspective-card--front">
        <span>LAYER 01</span>
        <strong>INTERFACE</strong>
      </div>
    </div>
    <p class="perspective-note">
      The selected native radio changes the parent state through{' '}
      <code>:has()</code>. No script owns the interaction.
    </p>
  </fieldset>
</section>

<style>
