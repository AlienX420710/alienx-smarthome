<section class="experiments" id="experiments" aria-labelledby="experiments-title">
  <p class="eyebrow">ALIENX // EXPERIMENTS</p>
  <h2 id="experiments-title">Break the browser. Then understand it.</h2>
  <p class="lede">Small technical experiments exploring DOM geometry, rendering, interaction, motion, networking, and the limits of the browser.</p>
  <section class="lab">
    <article class="console"><div class="bar"><span>ALIENX CONSOLE</span><span>LIVE</span></div><pre id="experiment-output">$ boot alienx-console
> runtime: browser
> modules: dom / css / events
> ready_</pre><form id="experiment-console-form"><span>$</span><input id="experiment-console-input" aria-label="Console command" autocomplete="off" spellcheck="false" placeholder="type help" /></form></article>
  </section>
  <section class="cards">
    <article><span>01</span><h3>DOM / Geometry</h3><p>Measure elements, map coordinates, and turn layout data into interaction.</p></article>
    <article><span>02</span><h3>CSS / Motion</h3><p>Use transforms, gradients, filters, and reduced-motion rules without a framework.</p></article>
    <article><span>03</span><h3>Network / Edge</h3><p>Cloudflare Workers turn a static-looking interface into an actual application surface.</p></article>
  </section>
</section>

<script data-astro-rerun>
  const experimentForm = document.querySelector('#experiment-console-form');
  const experimentInput = document.querySelector('#experiment-console-input');
  const experimentOutput = document.querySelector('#experiment-output');

  experimentForm?.addEventListener('submit', event => {
    event.preventDefault();
    if (!(experimentInput instanceof HTMLInputElement) || !(experimentOutput instanceof HTMLElement)) return;
    const command = experimentInput.value.trim().toLowerCase();
    const lines = {
      help: 'commands: help · status · clear · about',
      status: 'system: operational\nedge: cloudflare workers',
      about: 'AlienX experiments are intentionally small, inspectable browser primitives.'
    };
    if (command === 'clear') { experimentOutput.textContent = ''; experimentInput.value = ''; return; }
    experimentOutput.textContent += `\n$ ${command}\n${lines[command] ?? 'unknown command — try help'}\n`;
    experimentInput.value = '';
    experimentOutput.scrollTop = experimentOutput.scrollHeight;
  });
</script>

<style>
  .experiments{margin-top:120px;padding:80px 0 120px;border-top:1px solid var(--museum-border)}
  .experiments h2{max-width:900px;margin:0;color:var(--museum-heading);font-size:clamp(2.8rem,5.5vw,5.4rem);letter-spacing:-.065em;line-height:.9}
  .experiments .lede{max-width:720px;color:var(--museum-muted);font-size:1.1rem;line-height:1.6;margin:25px 0 0}
  .experiments .lab{display:grid;grid-template-columns:1fr;gap:16px;margin-top:55px}
  .experiments .console,.experiments .cards article{border:1px solid var(--museum-border);border-radius:20px;background:var(--museum-surface);overflow:hidden}
  .experiments .bar{display:flex;justify-content:space-between;padding:.9rem 1rem;border-bottom:1px solid var(--museum-border);font-size:.65rem;letter-spacing:.15em;color:var(--museum-soft)}
  .experiments .console pre{height:260px;overflow:auto;margin:0;padding:1rem;font:13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--museum-muted);white-space:pre-wrap}
  .experiments .console form{display:flex;gap:.5rem;padding:.9rem 1rem;border-top:1px solid var(--museum-border);font:13px ui-monospace,SFMono-Regular,Menlo,monospace}
  .experiments .console input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--museum-text);font:inherit}
  .experiments .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}
  .experiments .cards article{padding:1.5rem}
  .experiments .cards span{color:var(--museum-soft);font-size:.7rem}
  .experiments .cards h3{font-size:1.3rem;margin:2rem 0 0;color:var(--museum-heading)}
  .experiments .cards p{color:var(--museum-soft);line-height:1.6}
  @media(max-width:750px){.experiments .cards{grid-template-columns:1fr}}
</style>
