---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/alienx-social-preview.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const isExperiencePage = Astro.url.pathname.replace(/\/$/, '') === '/experience';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://alienxsmarthome.com';
const isHomePage = Astro.url.pathname === '/';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'AlienX SmartHome',
	description,
	url: siteUrl,
	inLanguage: 'en-US',
	publisher: {
		'@type': 'Organization',
		name: 'AlienX SmartHome',
		url: siteUrl,
	},
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#070b14" />
<meta name="robots" content="index, follow" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<ClientRouter />

<script is:inline>
	const setAlienXPageGradient = () => {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		const page =
			path === '/' ? 'home' :
			path === '/work' ? 'work' :
			path === '/experience' ? 'experience' :
			path === '/technology' ? 'technology' :
			path === '/status' ? 'status' :
			path === '/about' ? 'about' :
			path === '/contact' ? 'contact' :
			path === '/contact/success' ? 'contact-success' : 'default';
		document.documentElement.dataset.alienxPage = page;
	};

	setAlienXPageGradient();
	document.addEventListener('astro:page-load', setAlienXPageGradient);
</script>

<style is:global>
	html[data-alienx-page="home"] { --page-gradient-x: 8% !important; }
	html[data-alienx-page="work"] { --page-gradient-x: 25% !important; }
	html[data-alienx-page="experience"] { --page-gradient-x: 42% !important; }
	html[data-alienx-page="technology"] { --page-gradient-x: 59% !important; }
	html[data-alienx-page="status"] { --page-gradient-x: 76% !important; }
	html[data-alienx-page="about"] { --page-gradient-x: 92% !important; }
	html[data-alienx-page="contact"],
	html[data-alienx-page="contact-success"] { --page-gradient-x: 8% !important; }

	html[data-alienx-page="status"] body,
	html[data-alienx-page="contact"] body,
	html[data-alienx-page="contact-success"] body {
		background:
			radial-gradient(circle at var(--page-gradient-x) 0, var(--page-gradient-color), transparent 34rem),
			#05070c !important;
		color: #e8edf7;
	}

	@media (prefers-color-scheme: light) {
		html[data-alienx-page="status"] body,
		html[data-alienx-page="contact"] body,
		html[data-alienx-page="contact-success"] body {
			background:
				radial-gradient(circle at var(--page-gradient-x) 0, rgba(83, 101, 219, .07), transparent 34rem),
				#fff !important;
			color: #253047;
		}
	}

	/* Status must honor the selected light theme too, including its page-local dark UI. */
	html[data-alienx-theme="light"][data-alienx-page="status"] .hero h1,
	html[data-alienx-theme="light"][data-alienx-page="status"] .panel-head h2,
	html[data-alienx-theme="light"][data-alienx-page="status"] .transparency h2 {
		color: #0d1420 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .eyebrow,
	html[data-alienx-theme="light"][data-alienx-page="status"] .section-label {
		color: #52627a !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .lede {
		color: #46566f !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .status-panel {
		background: linear-gradient(145deg, #f7f9fc, #eef2f7) !important;
		border-color: #c8d1df !important;
		box-shadow: 0 2rem 5rem rgba(34, 41, 57, .12) !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .overall {
		border-color: #aeb9c9 !important;
		color: #334155 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .signal-line {
		background: #cbd5e1 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .check {
		background: #ffffff !important;
		border-color: #d0d8e3 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .check-copy,
	html[data-alienx-theme="light"][data-alienx-page="status"] .check-copy strong,
	html[data-alienx-theme="light"][data-alienx-page="status"] .check-copy small,
	html[data-alienx-theme="light"][data-alienx-page="status"] .panel-meta,
	html[data-alienx-theme="light"][data-alienx-page="status"] .panel-meta span,
	html[data-alienx-theme="light"][data-alienx-page="status"] .runtime,
	html[data-alienx-theme="light"][data-alienx-page="status"] .runtime span,
	html[data-alienx-theme="light"][data-alienx-page="status"] .runtime strong,
	html[data-alienx-theme="light"][data-alienx-page="status"] .explanation,
	html[data-alienx-theme="light"][data-alienx-page="status"] .explanation p {
		color: #253047 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] #refresh {
		background: #ffffff !important;
		border-color: #aeb9c9 !important;
		color: #172033 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] #refresh kbd {
		border-color: #aeb9c9 !important;
		color: #334155 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="status"] .runtime {
		background: #eef2f7 !important;
		border-color: #c8d1df !important;
	}

	@media (prefers-color-scheme: light) {
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .hero h1,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .panel-head h2,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .transparency h2 {
			color: #0d1420 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .eyebrow,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .section-label {
			color: #52627a !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .lede {
			color: #46566f !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .status-panel {
			background: linear-gradient(145deg, #f7f9fc, #eef2f7) !important;
			border-color: #c8d1df !important;
			box-shadow: 0 2rem 5rem rgba(34, 41, 57, .12) !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .overall {
			border-color: #aeb9c9 !important;
			color: #334155 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .signal-line {
			background: #cbd5e1 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .check {
			background: #ffffff !important;
			border-color: #d0d8e3 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .check-copy,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .check-copy strong,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .check-copy small,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .panel-meta,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .panel-meta span,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .runtime,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .runtime span,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .runtime strong,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .explanation,
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .explanation p {
			color: #253047 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] #refresh {
			background: #ffffff !important;
			border-color: #aeb9c9 !important;
			color: #172033 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] #refresh kbd {
			border-color: #aeb9c9 !important;
			color: #334155 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="status"] .runtime {
			background: #eef2f7 !important;
			border-color: #c8d1df !important;
		}
	}

	/* Experience light theme: preserve the green CTA while meeting WCAG AA. */
	html[data-alienx-theme="light"][data-alienx-page="experience"] .enter,
	html[data-alienx-theme="light"][data-alienx-page="experience"] .closing a {
		color: #fff !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="experience"] .eyebrow {
		color: #52627a !important;
	}
	@media (prefers-color-scheme: light) {
		html:not([data-alienx-theme="dark"])[data-alienx-page="experience"] .enter,
		html:not([data-alienx-theme="dark"])[data-alienx-page="experience"] .closing a {
			color: #fff !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="experience"] .eyebrow {
			color: #52627a !important;
		}
	}

	/* Experience uses a deliberately dark museum system; make its muted UI text meet WCAG AA. */
	html[data-alienx-page="experience"] body {
		--museum-muted: #aeb9ca;
		--museum-soft: #9aa6b9;
	}
	html[data-alienx-theme="light"][data-alienx-page="experience"] body {
		--museum-muted: #4d5e78;
		--museum-soft: #52627a;
	}
	html[data-alienx-theme="dark"][data-alienx-page="experience"] body {
		--museum-muted: #aeb9ca;
		--museum-soft: #9aa6b9;
	}
	@media (prefers-color-scheme: light) {
		html:not([data-alienx-theme="dark"])[data-alienx-page="experience"] body {
			--museum-muted: #4d5e78;
			--museum-soft: #52627a;
		}
	}

	/* Technology light theme: its page-local variables otherwise stay on the dark palette. */
	html[data-alienx-theme="light"][data-alienx-page="technology"] {
		--tech-bg: #f7f9fc !important;
		--tech-text: #253047 !important;
		--tech-heading: #0d1420 !important;
		--tech-muted: #46566f !important;
		--tech-soft: #52627a !important;
		--tech-border: #c8d1df !important;
		--tech-border-strong: #aeb9c9 !important;
	}
	html[data-alienx-theme="light"][data-alienx-page="technology"] body {
		--tech-bg: #f7f9fc !important;
		--tech-text: #253047 !important;
		--tech-heading: #0d1420 !important;
		--tech-muted: #46566f !important;
		--tech-soft: #52627a !important;
		--tech-border: #c8d1df !important;
		--tech-border-strong: #aeb9c9 !important;
		background:
			radial-gradient(circle at var(--page-gradient-x) 0, rgba(83, 101, 219, .07), transparent 34rem),
			#f7f9fc !important;
		color: #253047 !important;
	}
	@media (prefers-color-scheme: light) {
		html:not([data-alienx-theme="dark"])[data-alienx-page="technology"] {
			--tech-bg: #f7f9fc !important;
			--tech-text: #253047 !important;
			--tech-heading: #0d1420 !important;
			--tech-muted: #46566f !important;
			--tech-soft: #52627a !important;
			--tech-border: #c8d1df !important;
			--tech-border-strong: #aeb9c9 !important;
		}
		html:not([data-alienx-theme="dark"])[data-alienx-page="technology"] body {
			--tech-bg: #f7f9fc !important;
			--tech-text: #253047 !important;
			--tech-heading: #0d1420 !important;
			--tech-muted: #46566f !important;
			--tech-soft: #52627a !important;
			--tech-border: #c8d1df !important;
			--tech-border-strong: #aeb9c9 !important;
			background:
				radial-gradient(circle at var(--page-gradient-x) 0, rgba(83, 101, 219, .07), transparent 34rem),
				#f7f9fc !important;
			color: #253047 !important;
		}
	}
</style>

{isExperiencePage && <script is:inline src="/experience-museum-csp.js" defer></script>}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="AlienX SmartHome" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={`${title} — AlienX SmartHome`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={`${title} — AlienX SmartHome`} />

{isHomePage && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
