---
import { ClientRouter } from 'astro:transitions';
import DocumentMetadata from './DocumentMetadata.astro';
import '../styles/global.css';
import '../styles/page-themes.css';
import '../styles/site-canvas.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  robots?: string;
  canonical?: boolean;
}

const {
  title,
  description,
  image = '/alienx-social-preview.webp',
  robots = Astro.url.pathname.startsWith('/contact/success')
    ? 'noindex, follow'
    : 'index, follow',
  canonical = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') ?? 'https://alienxsmarthome.com';
const isHomePage = Astro.url.pathname === '/';
const preferences = {
  theme: {
    key: 'alienx-theme',
    attribute: 'data-alienx-theme',
    setter: '__alienxSetTheme',
    event: 'alienx:theme-change',
  },
  motion: {
    key: 'alienx-motion',
    attribute: 'data-alienx-motion',
    setter: '__alienxSetMotion',
    event: 'alienx:motion-change',
  },
  pageAttribute: 'data-alienx-page',
  routes: {
    '/': 'home',
    '/status': 'status',
    '/about': 'about',
    '/about/home-assistant': 'about-story',
    '/contact': 'contact',
    '/contact/success': 'contact-success',
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AlienX SmartHome',
  description,
  url: siteUrl,
  inLanguage: 'en-US',
  publisher: {
    '@type': 'Organization',
    name: 'AlienX SmartHome',
    url: siteUrl,
  },
};
---

<DocumentMetadata
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  imageURL={socialImage}
  imageAlt={`${title} — AlienX SmartHome`}
  canonical={canonical}
  robots={robots}
  themeColor="#070b14"
  referrer="strict-origin-when-cross-origin"
  siteName="AlienX SmartHome"
  locale="en_US"
  icons={[
    { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
    {
      rel: 'icon',
      type: 'image/png',
      sizes: '32x32',
      href: '/favicon-32x32.png',
    },
    {
      rel: 'icon',
      type: 'image/png',
      sizes: '16x16',
      href: '/favicon-16x16.png',
    },
    {
      rel: 'apple-touch-icon',
      sizes: '180x180',
      href: '/apple-touch-icon.png',
    },
    { rel: 'manifest', href: '/site.webmanifest' },
  ]}
  fonts={[
    { href: '/fonts/atkinson-regular.woff', type: 'font/woff' },
    { href: '/fonts/atkinson-bold.woff', type: 'font/woff' },
  ]}
  structuredData={isHomePage ? structuredData : undefined}
>
  <Fragment slot="early">
    <ClientRouter />
    <script
      is:inline
      src="/site-preferences.js"
      data-preferences={JSON.stringify(preferences)}
    ></script>
  </Fragment>
</DocumentMetadata>
