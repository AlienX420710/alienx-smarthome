---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/alienx-social-preview.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const isExperiencePage = Astro.url.pathname.replace(/\/$/, '') === '/experience';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://alienxsmarthome.com';
const isHomePage = Astro.url.pathname === '/';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'AlienX SmartHome',
	description,
	url: siteUrl,
	inLanguage: 'en-US',
	publisher: {
		'@type': 'Organization',
		name: 'AlienX SmartHome',
		url: siteUrl,
	},
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#070b14" />
<meta name="robots" content="index, follow" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<ClientRouter />

<script is:inline>
	const setAlienXPageGradient = () => {
		const path = window.location.pathname.replace(/\/$/, '') || '/';
		const page =
			path === '/' ? 'home' :
			path === '/work' ? 'work' :
			path === '/experience' ? 'experience' :
			path === '/technology' ? 'technology' :
			path === '/status' ? 'status' :
			path === '/about' ? 'about' :
			path === '/contact' ? 'contact' :
			path === '/contact/success' ? 'contact-success' : 'default';
		document.documentElement.dataset.alienxPage = page;
	};

	setAlienXPageGradient();
	document.addEventListener('astro:page-load', setAlienXPageGradient);
</script>

<style is:global>
	/* The gradient is one coordinated sweep: Home → Work → Experience → Technology → Status → About. */
	html[data-alienx-page="home"] { --page-gradient-x: 8% !important; }
	html[data-alienx-page="work"] { --page-gradient-x: 25% !important; }
	html[data-alienx-page="experience"] { --page-gradient-x: 42% !important; }
	html[data-alienx-page="technology"] { --page-gradient-x: 59% !important; }
	html[data-alienx-page="status"] { --page-gradient-x: 76% !important; }
	html[data-alienx-page="about"] { --page-gradient-x: 92% !important; }

	/* Start a project and the post-submit page return to Home's gradient position. */
	html[data-alienx-page="contact"],
	html[data-alienx-page="contact-success"] { --page-gradient-x: 8% !important; }

	/* Status uses the same shared AlienX background treatment as the other primary pages. */
	html[data-alienx-page="status"] body,
	html[data-alienx-page="contact"] body,
	html[data-alienx-page="contact-success"] body {
		background:
			radial-gradient(circle at var(--page-gradient-x) 0, var(--page-gradient-color), transparent 34rem),
			#05070c !important;
		color: #e8edf7;
	}

	@media (prefers-color-scheme: light) {
		html[data-alienx-page="status"] body,
		html[data-alienx-page="contact"] body,
		html[data-alienx-page="contact-success"] body {
			background:
				radial-gradient(circle at var(--page-gradient-x) 0, rgba(83, 101, 219, .07), transparent 34rem),
				#fff !important;
			color: #253047;
		}
	}
</style>

{isExperiencePage && <script is:inline src="/experience-museum.js" defer></script>}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="AlienX SmartHome" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={`${title} — AlienX SmartHome`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={`${title} — AlienX SmartHome`} />

{isHomePage && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
