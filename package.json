{
  "name": "alienx-smarthome",
  "description": "Public-facing technology showcase for AlienX SmartHome.",
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "axe-core": "4.13.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "selenium-webdriver": "4.49.0",
    "sharp": "0.35.4",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "node scripts/optimize-images.mjs && astro build",
    "cf-typegen": "wrangler types && node scripts/scope-worker-types.mjs",
    "check": "npm test && npm run typecheck && npm run build && wrangler deploy --dry-run",
    "audit": "npm audit --audit-level=high",
    "deploy": "node scripts/verify-ci.mjs && wrangler deploy",
    "dev": "node scripts/optimize-images.mjs && astro dev",
    "preview": "npm run build && wrangler dev",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "astro check && tsc --noEmit",
    "test:browser": "playwright test tests/responsive.spec.cjs tests/interactions.spec.cjs --reporter=line",
    "test:a11y": "playwright test tests/accessibility.spec.cjs --reporter=line",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "format": "prettier --write src public/*.js public/*.css scripts tests .github README.md docs/*.md *.config.*",
    "format:check": "prettier --check src public/*.js public/*.css scripts tests .github README.md docs/*.md *.config.*"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
